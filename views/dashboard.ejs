<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Dating Sites</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: Arial, sans-serif; background: #1a1a2e; color: #e0e0e0; padding: 20px; }
        .container { max-width: 1400px; margin: 0 auto; }
        
        .header { display: flex; justify-content: space-between; align-items: center; padding: 15px 20px; background: rgba(255,255,255,0.05); border-radius: 10px; margin-bottom: 20px; }
        .header h1 { font-size: 24px; color: #fff; }
        .header .user { font-size: 14px; color: #aaa; }
        .header .user strong { color: #4CAF50; }
        .header .logout-btn { padding: 8px 20px; background: #f44336; color: #fff; border: none; border-radius: 6px; cursor: pointer; font-size: 14px; }
        .header .logout-btn:hover { background: #d32f2f; }
        
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 15px; margin-bottom: 20px; }
        .stat-card { background: rgba(255,255,255,0.05); padding: 20px; border-radius: 10px; text-align: center; border: 1px solid rgba(255,255,255,0.08); }
        .stat-card .number { font-size: 32px; font-weight: bold; color: #4CAF50; }
        .stat-card .label { font-size: 13px; color: #888; margin-top: 5px; }
        
        .card { background: rgba(255,255,255,0.05); padding: 20px; border-radius: 10px; margin-bottom: 20px; border: 1px solid rgba(255,255,255,0.08); }
        .card h3 { color: #fff; margin-bottom: 15px; font-size: 18px; }
        .card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; flex-wrap: wrap; gap: 10px; }
        .card-header h3 { margin-bottom: 0; }
        
        .form-group { margin-bottom: 12px; }
        .form-group label { display: block; font-size: 13px; color: #aaa; margin-bottom: 4px; font-weight: bold; }
        .form-group input, .form-group select { width: 100%; padding: 10px; border: 1px solid #555; border-radius: 6px; background: #222; color: #fff; font-size: 14px; }
        .form-group input:focus, .form-group select:focus { border-color: #4CAF50; outline: none; }
        .form-row { display: flex; gap: 15px; flex-wrap: wrap; }
        .form-row .form-group { flex: 1; min-width: 150px; }
        
        .btn-primary { padding: 10px 25px; background: #4CAF50; color: #fff; border: none; border-radius: 6px; cursor: pointer; font-size: 14px; font-weight: bold; }
        .btn-primary:hover { background: #45a049; }
        .btn-warning { padding: 8px 15px; background: #FF9800; color: #fff; border: none; border-radius: 4px; cursor: pointer; font-size: 12px; }
        .btn-warning:hover { background: #e68900; }
        .btn-danger { padding: 8px 15px; background: #f44336; color: #fff; border: none; border-radius: 4px; cursor: pointer; font-size: 12px; }
        .btn-danger:hover { background: #d32f2f; }
        .btn-success { padding: 8px 15px; background: #4CAF50; color: #fff; border: none; border-radius: 4px; cursor: pointer; font-size: 12px; }
        .btn-success:hover { background: #388E3C; }
        .btn-small { padding: 4px 10px; font-size: 11px; border: none; border-radius: 4px; cursor: pointer; }
        .btn-edit { background: #2196F3; color: #fff; }
        .btn-edit:hover { background: #1976D2; }
        .btn-save { background: #4CAF50; color: #fff; }
        .btn-save:hover { background: #388E3C; }
        .btn-cancel { background: #757575; color: #fff; }
        .btn-cancel:hover { background: #616161; }
        .btn-remove { background: #f44336; color: #fff; }
        .btn-remove:hover { background: #d32f2f; }
        .btn-refresh { background: #2196F3; color: #fff; padding: 6px 15px; border: none; border-radius: 4px; cursor: pointer; font-size: 12px; }
        .btn-refresh:hover { background: #1976D2; }
        .btn-copy-one { background: linear-gradient(135deg, #00BCD4, #FF9800); color: #fff; border: none; border-radius: 4px; padding: 4px 12px; font-size: 11px; cursor: pointer; transition: all 0.2s; }
        .btn-copy-one:hover { transform: scale(1.05); opacity: 0.9; }
        .btn-remove-hwid-code { background: #f44336; color: #fff; border: none; border-radius: 4px; padding: 4px 10px; font-size: 10px; cursor: pointer; transition: all 0.2s; }
        .btn-remove-hwid-code:hover { background: #d32f2f; transform: scale(1.05); }
        .btn-remove-hwid-code:disabled { background: #555; color: #888; cursor: not-allowed; transform: none; }
        .btn-hwid-manager { background: #9C27B0; color: #fff; border: none; border-radius: 4px; padding: 4px 8px; font-size: 10px; cursor: pointer; transition: all 0.2s; }
        .btn-hwid-manager:hover { background: #7B1FA2; transform: scale(1.05); }
        .btn-batch-deactivate { background: #f44336; color: #fff; border: none; border-radius: 4px; padding: 8px 20px; cursor: pointer; font-size: 13px; font-weight: bold; transition: all 0.2s; }
        .btn-batch-deactivate:hover { background: #d32f2f; transform: scale(1.02); }
        .btn-batch-deactivate:disabled { background: #555; color: #888; cursor: not-allowed; transform: none; }
        .btn-batch-reactivate { background: #4CAF50; color: #fff; border: none; border-radius: 4px; padding: 8px 20px; cursor: pointer; font-size: 13px; font-weight: bold; transition: all 0.2s; }
        .btn-batch-reactivate:hover { background: #388E3C; transform: scale(1.02); }
        .btn-batch-reactivate:disabled { background: #555; color: #888; cursor: not-allowed; transform: none; }
        
        .scroll-table { overflow-x: auto; max-height: 500px; overflow-y: auto; }
        table { width: 100%; border-collapse: collapse; font-size: 13px; }
        table th { text-align: left; padding: 10px 8px; background: rgba(255,255,255,0.05); color: #aaa; border-bottom: 2px solid #333; position: sticky; top: 0; z-index: 10; }
        table td { padding: 8px; border-bottom: 1px solid rgba(255,255,255,0.05); vertical-align: middle; }
        table tr:hover { background: rgba(255,255,255,0.03); }
        table tr.editing { background: rgba(255,152,0,0.15); }
        
        .badge { display: inline-block; padding: 2px 10px; border-radius: 12px; font-size: 11px; font-weight: bold; }
        .badge.active { background: rgba(76,175,80,0.2); color: #4CAF50; }
        .badge.inactive { background: rgba(244,67,54,0.2); color: #f44336; }
        .badge.vip { background: rgba(255,152,0,0.2); color: #FF9800; }
        .badge.svip { background: rgba(76,175,80,0.2); color: #4CAF50; }
        .badge.auto-deactivated { background: rgba(244,67,54,0.2); color: #f44336; }
        .badge.approved { background: rgba(76,175,80,0.2); color: #4CAF50; }
        
        .edit-input { width: 100%; padding: 6px 8px; border: 2px solid #FF9800; border-radius: 4px; background: #2a1f0a; color: #fff; font-size: 13px; min-width: 60px; }
        .edit-input:focus { outline: none; border-color: #4CAF50; }
        .edit-select { padding: 6px 8px; border: 2px solid #FF9800; border-radius: 4px; background: #2a1f0a; color: #fff; font-size: 13px; }
        .edit-select:focus { outline: none; border-color: #4CAF50; }
        
        .tab-buttons { display: flex; gap: 10px; margin-bottom: 15px; flex-wrap: wrap; }
        .tab-btn { padding: 8px 20px; border: 2px solid #555; border-radius: 6px; background: transparent; color: #aaa; cursor: pointer; font-size: 14px; }
        .tab-btn.active { border-color: #4CAF50; color: #4CAF50; background: rgba(76,175,80,0.1); }
        .tab-btn:hover { border-color: #888; }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        
        .refresh-btn { padding: 6px 15px; background: #2196F3; color: #fff; border: none; border-radius: 4px; cursor: pointer; font-size: 12px; margin-left: 10px; }
        .refresh-btn:hover { background: #1976D2; }
        .code-font { font-family: monospace; font-size: 13px; }
        .text-muted { color: #888; }
        .mt-10 { margin-top: 10px; }
        .action-buttons { display: flex; gap: 4px; flex-wrap: wrap; align-items: center; }
        
        #result-message { position: fixed; bottom: 20px; right: 20px; padding: 12px 24px; border-radius: 8px; display: none; z-index: 9999; font-size: 14px; max-width: 400px; box-shadow: 0 4px 15px rgba(0,0,0,0.3); }
        #result-message.success { display: block; color: #4CAF50; background: rgba(76,175,80,0.15); border: 1px solid #4CAF50; }
        #result-message.error { display: block; color: #f44336; background: rgba(244,67,54,0.15); border: 1px solid #f44336; }
        #result-message.loading { display: block; color: #FF9800; background: rgba(255,152,0,0.15); border: 1px solid #FF9800; }
        #result-message.info { display: block; color: #2196F3; background: rgba(33,150,243,0.15); border: 1px solid #2196F3; }
        #result-message .close-msg { float: right; cursor: pointer; margin-left: 15px; opacity: 0.7; background: none; border: none; color: inherit; font-size: 16px; }
        #result-message .close-msg:hover { opacity: 1; }
        
        .spinner { display: inline-block; width: 14px; height: 14px; border: 2px solid #fff; border-radius: 50%; border-top-color: transparent; animation: spin 0.6s linear infinite; }
        @keyframes spin { to { transform: rotate(360deg); } }
        
        .hwid-spec-detail { display: inline-block; padding: 2px 10px; border-radius: 4px; font-size: 11px; margin: 2px 0; }
        .hwid-spec-detail.cpu { background: rgba(76,175,80,0.15); color: #4CAF50; }
        .hwid-spec-detail.gpu { background: rgba(156,39,176,0.15); color: #9C27B0; }
        .hwid-spec-detail.ram { background: rgba(255,152,0,0.15); color: #FF9800; }
        .hwid-spec-detail.device { background: rgba(255,87,34,0.15); color: #FF5722; }
        .hwid-spec-detail.profile { background: rgba(0,188,212,0.15); color: #00BCD4; }
        .hwid-spec-detail.owner { background: rgba(255,87,34,0.15); color: #FF5722; }
        .hwid-spec-detail.unregistered { background: rgba(255,152,0,0.1); color: #FF9800; border: 1px dashed #FF9800; }
        
        .btn-remove-hwid { background: #f44336; color: #fff; border: none; border-radius: 4px; padding: 6px 14px; cursor: pointer; font-size: 12px; font-weight: bold; transition: all 0.2s; }
        .btn-remove-hwid:hover { background: #d32f2f; transform: scale(1.05); }
        .btn-remove-hwid:disabled { background: #555; color: #888; cursor: not-allowed; transform: none; }
        
        .hwid-stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; margin-bottom: 15px; }
        .hwid-stat-card { background: rgba(255,255,255,0.05); padding: 15px; border-radius: 8px; text-align: center; border: 1px solid rgba(255,255,255,0.08); }
        .hwid-stat-card .number { font-size: 28px; font-weight: bold; color: #4CAF50; }
        .hwid-stat-card .label { font-size: 12px; color: #888; margin-top: 4px; }
        .hwid-stat-card .number.warning { color: #FF9800; }
        .hwid-stat-card .number.danger { color: #f44336; }
        
        .badge-new-count { background: #f44336; color: #fff; padding: 4px 12px; border-radius: 12px; font-size: 12px; }
        .badge-new-count.zero { background: #4CAF50; }
        
        .search-box { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
        .search-box input { padding: 8px 14px; border: 1px solid #555; border-radius: 6px; background: #222; color: #fff; font-size: 13px; min-width: 200px; flex: 1; }
        .search-box input:focus { border-color: #4CAF50; outline: none; }
        .search-box .search-icon { color: #888; font-size: 14px; }
        .search-box .clear-search { background: none; border: none; color: #888; cursor: pointer; font-size: 16px; padding: 4px 8px; }
        .search-box .clear-search:hover { color: #f44336; }
        
        .hwid-status-badge-sm { font-size: 11px; padding: 2px 10px; border-radius: 12px; display: inline-block; font-weight: bold; }
        .hwid-status-badge-sm.has-hwid { background: rgba(76,175,80,0.2); color: #4CAF50; }
        .hwid-status-badge-sm.no-hwid { background: rgba(244,67,54,0.2); color: #f44336; }
        .hwid-status-badge-sm.full { background: rgba(255,152,0,0.2); color: #FF9800; }
        
        .cleanup-btn-container { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
        
        .code-section { margin-bottom: 30px; }
        .code-section .section-title { font-size: 16px; font-weight: 600; margin-bottom: 12px; display: flex; align-items: center; gap: 10px; }
        .code-section .section-title .badge-count { font-size: 12px; font-weight: normal; }
        
        .batch-actions { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-bottom: 15px; padding: 15px; background: rgba(255,255,255,0.03); border-radius: 8px; border: 1px solid rgba(255,255,255,0.05); }
        .batch-actions .label { font-size: 13px; color: #aaa; }
        
        .card.svip-card { border-left: 3px solid #4CAF50; }
        .card.vip-card { border-left: 3px solid #FF9800; }
        
        .section-header-with-search { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; }
        .section-header-with-search .search-box { flex: 1; min-width: 200px; max-width: 400px; }
        .section-header-with-search .search-box input { min-width: 150px; }
        
        .error-banner { background: rgba(244,67,54,0.15); border: 1px solid #f44336; border-radius: 8px; padding: 15px 20px; margin-bottom: 20px; display: none; color: #f44336; }
        .error-banner .error-icon { font-size: 20px; margin-right: 10px; }
        .error-banner .error-text { font-size: 14px; }
        .error-banner .retry-btn { background: #f44336; color: #fff; border: none; border-radius: 4px; padding: 4px 15px; cursor: pointer; margin-left: 15px; }
        .error-banner .retry-btn:hover { background: #d32f2f; }
        
        .loading-shimmer {
            animation: shimmer 1.5s ease-in-out infinite;
            background: linear-gradient(90deg, rgba(255,255,255,0.05) 25%, rgba(255,255,255,0.1) 50%, rgba(255,255,255,0.05) 75%);
            background-size: 200% 100%;
            border-radius: 4px;
        }
        @keyframes shimmer {
            0% { background-position: -200% 0; }
            100% { background-position: 200% 0; }
        }
        
        @media (max-width: 768px) { 
            .form-row { flex-direction: column; } 
            .hwid-stats-grid { grid-template-columns: repeat(2, 1fr); }
            .search-box input { min-width: 120px; }
            .section-header-with-search { flex-direction: column; align-items: stretch; }
            .section-header-with-search .search-box { max-width: 100%; }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- HEADER -->
        <div class="header">
            <div>
                <h1>🔐 Admin Dashboard</h1>
                <div class="user">Logged in as: <strong><%= username %></strong></div>
            </div>
            <div>
                <button class="refresh-btn" onclick="refreshData()">🔄 Refresh</button>
                <a href="/logout"><button class="logout-btn">🚪 Logout</button></a>
            </div>
        </div>

        <!-- ERROR BANNER -->
        <div class="error-banner" id="error-banner">
            <span class="error-icon">❌</span>
            <span class="error-text" id="error-text">Failed to load data. Please try again.</span>
            <button class="retry-btn" onclick="refreshData()">🔄 Retry</button>
        </div>

        <!-- STATS -->
        <div class="stats-grid" id="stats-grid">
            <div class="stat-card">
                <div class="number" id="stat-codes">0</div>
                <div class="label">🔑 Total Codes</div>
            </div>
            <div class="stat-card">
                <div class="number" id="stat-svip">0</div>
                <div class="label" style="color:#4CAF50;">⭐ SVIP Codes</div>
            </div>
            <div class="stat-card">
                <div class="number" id="stat-vip">0</div>
                <div class="label" style="color:#FF9800;">🔶 VIP Codes</div>
            </div>
            <div class="stat-card">
                <div class="number" id="stat-active">0</div>
                <div class="label" style="color:#4CAF50;">✅ Active Codes</div>
            </div>
            <div class="stat-card">
                <div class="number" id="stat-inactive">0</div>
                <div class="label" style="color:#f44336;">❌ Inactive Codes</div>
            </div>
        </div>

        <!-- TABS -->
        <div class="tab-buttons">
            <button class="tab-btn active" onclick="switchTab('codes')">🔑 All Codes</button>
            <button class="tab-btn" onclick="switchTab('hwid')">🖥️ HWID Manager</button>
            <button class="tab-btn" onclick="switchTab('hwidlogs')">📋 HWID Logs</button>
            <button class="tab-btn" onclick="switchTab('newhwid')">🆕 New HWID</button>
        </div>

        <!-- ============================================ -->
        <!-- TAB: ALL CODES -->
        <!-- ============================================ -->
        <div class="tab-content active" id="tab-codes">
            <div class="card">
                <h3>➕ Generate New Code</h3>
                <form id="generate-code-form">
                    <div class="form-row">
                        <div class="form-group">
                            <label>👤 Username</label>
                            <input type="text" id="gen-username" placeholder="e.g., john_doe" required>
                        </div>
                        <div class="form-group">
                            <label>🔐 Access Level</label>
                            <select id="gen-access">
                                <option value="VIP">🔶 VIP</option>
                                <option value="SVIP">⭐ SVIP</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>📅 Subscription</label>
                            <select id="gen-subscription">
                                <option value="Lifetime">♾️ Lifetime</option>
                                <option value="3 Months">3 Months</option>
                                <option value="6 Months">6 Months</option>
                                <option value="12 Months">12 Months</option>
                            </select>
                        </div>
                    </div>
                    <div style="font-size:12px;color:#888;margin-bottom:10px;">
                        ℹ️ HWID will be <strong style="color:#FF9800;">auto-assigned</strong> when the code is first used
                    </div>
                    <button type="submit" class="btn-primary">✅ Generate Code</button>
                </form>
                <div id="gen-result" class="mt-10"></div>
            </div>

            <!-- BATCH ACTIONS - REMOVED SVIP & VIP buttons -->
            <div class="batch-actions">
                <span class="label">⚡ Batch Actions:</span>
                <button onclick="batchDeactivateAll()" class="btn-batch-deactivate" id="batch-deactivate-btn">
                    🚨 Deactivate ALL Codes (Removes HWIDs)
                </button>
                <button onclick="batchReactivateAll()" class="btn-batch-reactivate" id="batch-reactivate-btn">
                    🔓 Reactivate ALL (Removes HWIDs)
                </button>
            </div>

            <!-- ============================================ -->
            <!-- SVIP SECTION -->
            <!-- ============================================ -->
            <div class="code-section">
                <div class="section-title">
                    ⭐ SVIP Codes <span class="badge-count text-muted" id="svip-count">0 codes</span>
                </div>
                <div class="card svip-card">
                    <div class="card-header section-header-with-search">
                        <span style="font-size:13px;color:#888;">Premium Access</span>
                        <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
                            <div class="search-box">
                                <span class="search-icon">🔍</span>
                                <input type="text" id="svip-search" placeholder="Search username..." onkeyup="filterSVIP()">
                                <button class="clear-search" onclick="document.getElementById('svip-search').value=''; filterSVIP();" title="Clear search">✕</button>
                            </div>
                        </div>
                    </div>
                    <div class="scroll-table">
                        <table>
                            <thead>
                                <tr>
                                    <th style="width:100px;">Code</th>
                                    <th>Username</th>
                                    <th>Subscription</th>
                                    <th>Expires</th>
                                    <th style="width:120px;">HWID Status</th>
                                    <th style="min-width:180px;">Deactivation Reason</th>
                                    <th style="width:280px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="svip-body">
                                <tr><td colspan="7" style="text-align:center;color:#888;padding:20px;">
                                    <div class="loading-text"><span class="spinner"></span> Loading SVIP codes...</div>
                                </td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- ============================================ -->
            <!-- VIP SECTION -->
            <!-- ============================================ -->
            <div class="code-section">
                <div class="section-title">
                    🔶 VIP Codes <span class="badge-count text-muted" id="vip-count">0 codes</span>
                </div>
                <div class="card vip-card">
                    <div class="card-header section-header-with-search">
                        <span style="font-size:13px;color:#888;">Standard Access</span>
                        <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
                            <div class="search-box">
                                <span class="search-icon">🔍</span>
                                <input type="text" id="vip-search" placeholder="Search username..." onkeyup="filterVIP()">
                                <button class="clear-search" onclick="document.getElementById('vip-search').value=''; filterVIP();" title="Clear search">✕</button>
                            </div>
                        </div>
                    </div>
                    <div class="scroll-table">
                        <table>
                            <thead>
                                <tr>
                                    <th style="width:100px;">Code</th>
                                    <th>Username</th>
                                    <th>Subscription</th>
                                    <th>Expires</th>
                                    <th style="width:120px;">HWID Status</th>
                                    <th style="min-width:180px;">Deactivation Reason</th>
                                    <th style="width:280px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="vip-body">
                                <tr><td colspan="7" style="text-align:center;color:#888;padding:20px;">
                                    <div class="loading-text"><span class="spinner"></span> Loading VIP codes...</div>
                                </td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============================================ -->
        <!-- TAB: HWID MANAGER -->
        <!-- ============================================ -->
        <div class="tab-content" id="tab-hwid">
            <div class="card">
                <div class="card-header">
                    <h3>🖥️ HWID Management</h3>
                    <span class="text-muted">Manage which computers can use each code</span>
                </div>
                
                <div class="form-row" style="margin-bottom:15px;">
                    <div class="form-group" style="flex:2;">
                        <label>Select Code</label>
                        <select id="hwid-code-select" onchange="loadHwidDetails()">
                            <option value="">-- Select a code --</option>
                        </select>
                    </div>
                    <div class="form-group" style="flex:1;">
                        <label>HWID Limit (1-10)</label>
                        <div style="display:flex;gap:10px;">
                            <input type="number" id="hwid-limit-input" min="1" max="10" value="1">
                            <button onclick="updateHwidLimit()" class="btn-primary" style="padding:8px 15px;">Update</button>
                        </div>
                    </div>
                </div>

                <div id="hwid-info" style="display:none;">
                    <div class="hwid-stats-grid">
                        <div class="hwid-stat-card">
                            <div class="number" id="hwid-current-count">0</div>
                            <div class="label">Current HWIDs</div>
                        </div>
                        <div class="hwid-stat-card">
                            <div class="number" id="hwid-max-limit">0</div>
                            <div class="label">Max Limit</div>
                        </div>
                        <div class="hwid-stat-card">
                            <div class="number" id="hwid-available-slots">0</div>
                            <div class="label">Available Slots</div>
                        </div>
                    </div>
                    
                    <div id="hwid-limit-status" style="text-align:center;padding:8px;border-radius:6px;margin-bottom:15px;display:none;"></div>
                </div>

                <div id="hwid-list-section" style="display:none;">
                    <h4>📋 Assigned Computers</h4>
                    <div class="scroll-table">
                        <table>
                            <thead>
                                <tr>
                                    <th style="width:40px;">#</th>
                                    <th style="min-width:180px;">HWID</th>
                                    <th style="min-width:550px;">Hardware Specs</th>
                                    <th style="width:100px;">Action</th>
                                </tr>
                            </thead>
                            <tbody id="hwid-list-body">
                                <tr><td colspan="4" style="text-align:center;color:#888;padding:20px;">
                                    <div class="loading-text"><span class="spinner"></span> Loading HWIDs...</div>
                                </td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============================================ -->
        <!-- TAB: HWID LOGS -->
        <!-- ============================================ -->
        <div class="tab-content" id="tab-hwidlogs">
            <div class="card">
                <div class="card-header">
                    <h3>📋 HWID Activity Logs</h3>
                    <div class="cleanup-btn-container">
                        <span class="badge badge-new-count" id="new-hwid-count">0 new</span>
                        <button onclick="loadHwidLogs()" class="btn-small btn-refresh" style="margin-left:10px;">🔄 Refresh</button>
                        <button onclick="cleanupOldLogs()" class="btn-small btn-danger" style="margin-left:10px;">🗑️ Clear All Logs</button>
                    </div>
                </div>
                <div style="font-size:13px;color:#888;margin-bottom:15px;padding:10px;background:rgba(76,175,80,0.1);border-radius:6px;">
                    ✅ Showing only <strong>unassigned HWIDs</strong> (HWIDs without a code)
                </div>
                <div class="card-body">
                    <div class="scroll-table">
                        <table>
                            <thead>
                                <tr>
                                    <th style="width:40px;">#</th>
                                    <th style="min-width:150px;">🖥️ HWID</th>
                                    <th style="width:100px;">🔑 Code</th>
                                    <th style="min-width:350px;">Hardware Specs</th>
                                    <th style="width:160px;">⏰ Time</th>
                                </tr>
                            </thead>
                            <tbody id="hwid-logs-body">
                                <tr><td colspan="5" style="text-align:center;color:#888;padding:30px;">
                                    <div class="loading-text"><span class="spinner"></span> Loading logs...</div>
                                </td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============================================ -->
        <!-- TAB: NEW HWID DETECTION -->
        <!-- ============================================ -->
        <div class="tab-content" id="tab-newhwid">
            <div class="card">
                <div class="card-header">
                    <h3>🆕 New HWID Detection</h3>
                    <div class="cleanup-btn-container">
                        <span class="badge badge-new-count" id="new-hwid-unique-count">0 new</span>
                        <button onclick="loadNewHwids()" class="btn-small btn-refresh" style="margin-left:10px;">🔄 Refresh</button>
                        <button onclick="cleanupOldLogs()" class="btn-small btn-danger" style="margin-left:10px;">🗑️ Clear All Logs</button>
                    </div>
                </div>
                <div style="font-size:13px;color:#888;margin-bottom:15px;padding:10px;background:rgba(255,152,0,0.1);border-radius:6px;">
                    ⚠️ These are <strong>unique HWIDs</strong> that have been detected but are <strong>not yet assigned</strong> to any code.
                </div>
                <div class="card-body">
                    <div class="scroll-table">
                        <table>
                            <thead>
                                <tr>
                                    <th style="width:40px;">#</th>
                                    <th style="min-width:180px;">🖥️ HWID</th>
                                    <th style="min-width:300px;">Hardware Specs</th>
                                    <th style="width:150px;">First Seen</th>
                                    <th style="width:200px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="new-hwid-body">
                                <tr><td colspan="5" style="text-align:center;color:#888;padding:30px;">
                                    <div class="loading-text"><span class="spinner"></span> Loading new HWIDs...</div>
                                </td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Result Message -->
    <div id="result-message">
        <button class="close-msg" onclick="hideMessage()">✕</button>
        <span id="result-text"></span>
    </div>

    <script>
        // ============================================
        // MESSAGE HELPERS
        // ============================================
        function showMessage(msg, type = 'success') {
            const el = document.getElementById('result-message');
            const text = document.getElementById('result-text');
            if (!el || !text) return;
            text.innerHTML = msg;
            el.className = type;
            el.style.display = 'block';
            clearTimeout(window.msgTimeout);
            window.msgTimeout = setTimeout(() => {
                hideMessage();
            }, 4000);
        }
        
        function hideMessage() {
            const el = document.getElementById('result-message');
            if (el) {
                el.style.display = 'none';
                el.className = '';
            }
        }

        // ============================================
        // SHOW/HIDE ERROR BANNER
        // ============================================
        function showErrorBanner(msg) {
            const banner = document.getElementById('error-banner');
            const text = document.getElementById('error-text');
            text.textContent = msg;
            banner.style.display = 'block';
        }
        
        function hideErrorBanner() {
            document.getElementById('error-banner').style.display = 'none';
        }

        // ============================================
        // GO TO HWID MANAGER
        // ============================================
        function goToHwidManager(code) {
            switchTab('hwid');
            const select = document.getElementById('hwid-code-select');
            if (select) {
                select.value = code;
                loadHwidDetails();
            }
            const hwidSection = document.getElementById('tab-hwid');
            if (hwidSection) {
                setTimeout(() => {
                    hwidSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }, 300);
            }
            showMessage(`🖥️ Loading HWID Manager for code: ${code}`, 'info');
        }

        // ============================================
        // COPY FUNCTION
        // ============================================
        function copyCodeAndUser(code, username) {
            const textToCopy = `Code: ${code}\nUsername: ${username || 'N/A'}`;
            navigator.clipboard.writeText(textToCopy).then(() => {
                showMessage(`✅ Copied!\nCode: ${code}\nUsername: ${username || 'N/A'}`, 'success');
            }).catch(() => {
                const textArea = document.createElement('textarea');
                textArea.value = textToCopy;
                document.body.appendChild(textArea);
                textArea.select();
                document.execCommand('copy');
                document.body.removeChild(textArea);
                showMessage(`✅ Copied!\nCode: ${code}\nUsername: ${username || 'N/A'}`, 'success');
            });
        }

        // ============================================
        // REMOVE HWID FROM CODE
        // ============================================
        async function removeHwidFromCode(code, hwid) {
            if (!hwid) {
                showMessage('❌ No HWID assigned to this code', 'error');
                return;
            }
            if (!confirm(`⚠️ Remove HWID from code ${code}?\n\nThis will also delete all associated profiles.`)) {
                return;
            }
            try {
                showMessage('⏳ Removing HWID...', 'loading');
                const response = await fetch(`/api/code/${code}/hwid/${hwid}`, { method: 'DELETE' });
                const result = await response.json();
                if (result.success) {
                    showMessage(`✅ ${result.message}`, 'success');
                    await loadAll();
                } else {
                    showMessage('❌ ' + (result.error || 'Failed to remove HWID'), 'error');
                }
            } catch (error) {
                showMessage('❌ Error: ' + error.message, 'error');
            }
        }

        // ============================================
        // BATCH DEACTIVATE ALL - REMOVES HWIDs
        // ============================================
        async function batchDeactivateAll() {
            const totalCodes = allCodes.length;
            if (totalCodes === 0) {
                showMessage('❌ No codes to deactivate', 'error');
                return;
            }
            
            if (!confirm(`⚠️ Deactivate ALL ${totalCodes} codes?\n\nThis will remove ALL HWIDs and devices from ALL codes.\n\nThis cannot be undone!`)) {
                return;
            }
            if (!confirm(`🚨 ARE YOU ABSOLUTELY SURE?\n\nAll ${totalCodes} codes will be deactivated and all devices will be revoked.`)) {
                return;
            }
            
            const btn = document.getElementById('batch-deactivate-btn');
            btn.disabled = true;
            btn.textContent = '⏳ Processing...';
            showMessage(`⏳ Deactivating ${totalCodes} codes and removing HWIDs...`, 'loading');
            
            let successCount = 0;
            let failCount = 0;
            
            for (const code of allCodes) {
                try {
                    const response = await fetch(`/api/code/${code.code}/deactivate`, { method: 'POST' });
                    const result = await response.json();
                    if (result.success) {
                        successCount++;
                        console.log(`✅ Deactivated ${code.code} - HWIDs removed`);
                    } else {
                        failCount++;
                        console.error('Failed to deactivate:', code.code, result.error);
                    }
                } catch (error) {
                    failCount++;
                    console.error('Error deactivating:', code.code, error.message);
                }
                btn.textContent = `⏳ ${successCount + failCount}/${totalCodes}`;
            }
            
            btn.disabled = false;
            btn.textContent = '🚨 Deactivate ALL Codes (Removes HWIDs)';
            showMessage(`✅ ${successCount} codes deactivated with HWIDs removed, ${failCount} failed`, successCount > 0 ? 'success' : 'error');
            hwidDetailsCache = {};
            await loadAll();
        }

        // ============================================
        // BATCH REACTIVATE ALL - REMOVES HWIDs
        // ============================================
        async function batchReactivateAll() {
            const inactiveCodes = allCodes.filter(c => !c.is_active);
            if (inactiveCodes.length === 0) {
                showMessage('❌ No inactive codes to reactivate', 'error');
                return;
            }
            
            if (!confirm(`🔓 Reactivate ALL ${inactiveCodes.length} inactive codes?\n\nThis will remove ALL existing HWIDs from these codes.`)) {
                return;
            }
            
            const btn = document.getElementById('batch-reactivate-btn');
            btn.disabled = true;
            btn.textContent = '⏳ Processing...';
            showMessage(`⏳ Reactivating ${inactiveCodes.length} codes and removing HWIDs...`, 'loading');
            
            let successCount = 0;
            let failCount = 0;
            
            for (const code of inactiveCodes) {
                try {
                    const response = await fetch(`/api/code/${code.code}/reactivate`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ subscriptionType: code.subscription_type || 'Lifetime' })
                    });
                    const result = await response.json();
                    if (result.success) {
                        successCount++;
                        console.log(`✅ Reactivated ${code.code} - HWIDs removed`);
                    } else {
                        failCount++;
                        console.error('Failed to reactivate:', code.code, result.error);
                    }
                } catch (error) {
                    failCount++;
                    console.error('Error reactivating:', code.code, error.message);
                }
                btn.textContent = `⏳ ${successCount + failCount}/${inactiveCodes.length}`;
            }
            
            btn.disabled = false;
            btn.textContent = '🔓 Reactivate ALL (Removes HWIDs)';
            showMessage(`✅ ${successCount} codes reactivated with HWIDs removed, ${failCount} failed`, successCount > 0 ? 'success' : 'error');
            hwidDetailsCache = {};
            await loadAll();
        }

        // ============================================
        // STATE
        // ============================================
        let editingCode = null;
        let allCodes = [];
        let allDevices = [];
        let codeHwidsMap = {};
        let isLoading = false;
        let loadError = false;
        let filteredSVIP = [];
        let filteredVIP = [];
        let hwidDetailsCache = {};
        let svipSearchTerm = '';
        let vipSearchTerm = '';

        // ============================================
        // DEACTIVATION REASON MAPPING
        // ============================================
        const deactivationReasons = {
            'auto_deactivated': '⚠️ Auto-deactivated (General)',
            'auto_deactivated_multiple_hwids': '🚨 Multiple HWIDs detected',
            'auto_deactivated_limit_exceeded': '🚨 HWID limit exceeded',
            'auto_deactivated_unauthorized': '🚨 Unauthorized use detected',
            'inactive': 'Manually deactivated',
            'expired': '⏰ Subscription expired'
        };

        function getDeactivationReason(status) {
            return deactivationReasons[status] || status || 'Unknown reason';
        }

        // ============================================
        // FAST FETCH - Single call for everything
        // ============================================
        async function fastFetch(url, options = {}) {
            const defaultOptions = {
                credentials: 'same-origin',
                headers: {
                    'Accept': 'application/json',
                    'Content-Type': 'application/json'
                }
            };
            
            const mergedOptions = {
                ...defaultOptions,
                ...options,
                headers: {
                    ...defaultOptions.headers,
                    ...(options.headers || {})
                }
            };
            
            try {
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 15000);
                mergedOptions.signal = controller.signal;
                
                const response = await fetch(url, mergedOptions);
                clearTimeout(timeoutId);
                
                if (response.status === 401) {
                    window.location.href = '/login';
                    throw new Error('Unauthorized');
                }
                
                return response;
            } catch (error) {
                if (error.name === 'AbortError') {
                    throw new Error('Request timeout');
                }
                throw error;
            }
        }

        // ============================================
        // TAB SWITCHING
        // ============================================
        function switchTab(tab) {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
            const tabBtn = document.querySelector(`.tab-btn[onclick="switchTab('${tab}')"]`);
            if (tabBtn) tabBtn.classList.add('active');
            const tabContent = document.getElementById(`tab-${tab}`);
            if (tabContent) tabContent.classList.add('active');
            
            if (tab === 'hwid') {
                populateHwidCodeDropdown();
                loadHwidDetails();
            } else if (tab === 'hwidlogs') {
                loadHwidLogs();
            } else if (tab === 'newhwid') {
                loadNewHwids();
            } else {
                renderCurrentTab();
            }
        }

        function renderCurrentTab() {
            const activeTab = document.querySelector('.tab-content.active');
            if (!activeTab) return;
            const id = activeTab.id;
            if (id === 'tab-codes') {
                filterSVIP();
                filterVIP();
                updateStats();
            }
        }

        // ============================================
        // FILTER SVIP
        // ============================================
        function filterSVIP() {
            const search = document.getElementById('svip-search').value.toLowerCase().trim();
            svipSearchTerm = search;
            const svipCodes = allCodes.filter(c => c.access_level === 'SVIP');
            
            if (!search) {
                filteredSVIP = svipCodes;
            } else {
                filteredSVIP = svipCodes.filter(c => {
                    const username = (c.username || '').toLowerCase();
                    return username.includes(search);
                });
            }
            renderSVIP();
        }

        // ============================================
        // FILTER VIP
        // ============================================
        function filterVIP() {
            const search = document.getElementById('vip-search').value.toLowerCase().trim();
            vipSearchTerm = search;
            const vipCodes = allCodes.filter(c => c.access_level === 'VIP');
            
            if (!search) {
                filteredVIP = vipCodes;
            } else {
                filteredVIP = vipCodes.filter(c => {
                    const username = (c.username || '').toLowerCase();
                    return username.includes(search);
                });
            }
            renderVIP();
        }

        // ============================================
        // REFRESH
        // ============================================
        async function refreshData() {
            hideErrorBanner();
            showMessage('🔄 Refreshing...', 'loading');
            try {
                const response = await fastFetch('/api/force-refresh', { method: 'POST' });
                const result = await response.json();
                if (result.success) {
                    hwidDetailsCache = {};
                    await loadAll();
                    showMessage('✅ Data refreshed!', 'success');
                } else {
                    showMessage('❌ Refresh failed', 'error');
                }
            } catch (error) {
                showMessage('❌ Error refreshing: ' + error.message, 'error');
                showErrorBanner('❌ Error refreshing data: ' + error.message);
                if (allCodes.length > 0) {
                    renderCurrentTab();
                    updateStats();
                }
            }
        }

        // ============================================
        // UPDATE STATS
        // ============================================
        function updateStats() {
            const total = allCodes.length;
            const svip = allCodes.filter(c => c.access_level === 'SVIP').length;
            const vip = allCodes.filter(c => c.access_level === 'VIP').length;
            const active = allCodes.filter(c => c.is_active).length;
            const inactive = allCodes.filter(c => !c.is_active).length;
            
            document.getElementById('stat-codes').textContent = total;
            document.getElementById('stat-svip').textContent = svip;
            document.getElementById('stat-vip').textContent = vip;
            document.getElementById('stat-active').textContent = active;
            document.getElementById('stat-inactive').textContent = inactive;
            
            document.getElementById('svip-count').textContent = svip + ' codes';
            document.getElementById('vip-count').textContent = vip + ' codes';
        }

        // ============================================
        // LOAD ALL DATA - FAST
        // ============================================
        async function loadAll() {
            if (isLoading) return;
            isLoading = true;
            loadError = false;
            hideErrorBanner();
            
            try {
                const response = await fastFetch('/api/dashboard-data');
                const data = await response.json();
                
                if (data && data.codes) {
                    allCodes = data.codes || [];
                    allDevices = data.devices || [];
                }
                
                // Load HWID status in background (non-blocking)
                setTimeout(() => {
                    loadHwidStatusForCodes();
                }, 100);
                
                populateHwidCodeDropdown();
                filterSVIP();
                filterVIP();
                updateStats();
                
                // Update new HWID count
                try {
                    const newResponse = await fastFetch('/api/hwid-new?limit=1');
                    const newData = await newResponse.json();
                    if (newData.success) {
                        const countEl = document.getElementById('new-hwid-unique-count');
                        if (countEl) {
                            countEl.textContent = (newData.total || 0) + ' new';
                            countEl.className = 'badge badge-new-count' + ((newData.total || 0) === 0 ? ' zero' : '');
                        }
                    }
                } catch (e) {
                    // Ignore
                }
                
                isLoading = false;
                
            } catch (error) {
                console.error('Load data error:', error);
                loadError = true;
                isLoading = false;
                showMessage('⚠️ Using cached data: ' + error.message, 'info');
                showErrorBanner('⚠️ Using cached data - ' + error.message);
                
                if (allCodes.length > 0) {
                    renderCurrentTab();
                    updateStats();
                }
            }
        }

        // ============================================
        // LOAD HWID STATUS - Non-blocking
        // ============================================
        async function loadHwidStatusForCodes() {
            codeHwidsMap = {};
            
            const codes = allCodes.slice(0, 30);
            if (codes.length === 0) return;
            
            const promises = codes.map(async (code) => {
                try {
                    const response = await fastFetch(`/api/code/${code.code}/hwid-limit`);
                    const data = await response.json();
                    return { code: code.code, data: data };
                } catch (error) {
                    return { code: code.code, data: { current_hwid_count: 0, max_hwid_limit: 1 } };
                }
            });
            
            const results = await Promise.all(promises);
            results.forEach(result => {
                codeHwidsMap[result.code] = {
                    count: result.data.current_hwid_count || 0,
                    limit: result.data.max_hwid_limit || 1
                };
            });
            
            // Re-render with HWID info
            filterSVIP();
            filterVIP();
        }

        // ============================================
        // RENDER SVIP
        // ============================================
        function renderSVIP() {
            const tbody = document.getElementById('svip-body');
            
            if (filteredSVIP.length === 0) {
                const msg = svipSearchTerm ? `No SVIP codes found for username: "${svipSearchTerm}"` : 'No SVIP codes found';
                tbody.innerHTML = `<tr><td colspan="7" style="text-align:center;color:#888;padding:20px;">${msg}</td></tr>`;
                return;
            }
            
            tbody.innerHTML = filteredSVIP.map(c => {
                const isEditing = editingCode === c.code;
                const deactivationReason = !c.is_active ? getDeactivationReason(c.status) : '';
                const username = c.username || '';
                
                const hwidInfo = codeHwidsMap[c.code] || { count: 0, limit: 1 };
                const hasHwid = hwidInfo.count > 0;
                const isFull = hwidInfo.count >= hwidInfo.limit;
                const hwidDisplay = `${hwidInfo.count}/${hwidInfo.limit}`;
                
                const deactivationDisplay = !c.is_active ? 
                    `<span style="font-size:11px;color:#f44336;">${deactivationReason}</span>` : 
                    '<span class="text-muted">—</span>';
                
                const codeHwid = c.hwid || null;
                const hasHwidAssigned = codeHwid && codeHwid.length === 64;
                
                let hwidStatusHtml = `<span class="hwid-status-badge-sm no-hwid">0/0</span>`;
                if (hasHwidAssigned) {
                    let statusClass = 'has-hwid';
                    if (isFull) statusClass = 'full';
                    hwidStatusHtml = `<span class="hwid-status-badge-sm ${statusClass}">${hwidDisplay}</span>`;
                } else if (hasHwid) {
                    hwidStatusHtml = `<span class="hwid-status-badge-sm has-hwid">${hwidDisplay}</span>`;
                }
                
                if (isEditing) {
                    return `
                        <tr class="editing">
                            <td><strong class="code-font">${c.code}</strong></td>
                            <td><input class="edit-input" id="edit-username-${c.code}" value="${c.username || ''}" placeholder="Username"></td>
                            <td>
                                <select class="edit-select" id="edit-subscription-${c.code}">
                                    <option value="Lifetime" ${c.subscription_type === 'Lifetime' ? 'selected' : ''}>♾️ Lifetime</option>
                                    <option value="3 Months" ${c.subscription_type === '3 Months' ? 'selected' : ''}>3 Months</option>
                                    <option value="6 Months" ${c.subscription_type === '6 Months' ? 'selected' : ''}>6 Months</option>
                                    <option value="12 Months" ${c.subscription_type === '12 Months' ? 'selected' : ''}>12 Months</option>
                                </select>
                            </td>
                            <td>${c.expires_at ? new Date(c.expires_at).toLocaleDateString() : 'Never'}</td>
                            <td>
                                <input class="edit-input" id="edit-hwid-limit-${c.code}" type="number" min="1" max="10" value="${c.max_hwid_limit || 1}" style="width:70px;">
                            </td>
                            <td>${deactivationDisplay}</td>
                            <td>
                                <div class="action-buttons">
                                    <button onclick="saveEdit('${c.code}')" class="btn-small btn-save">💾 Save</button>
                                    <button onclick="cancelEdit()" class="btn-small btn-cancel">✖ Cancel</button>
                                </div>
                            </td>
                        </tr>
                    `;
                }
                
                return `
                    <tr>
                        <td><strong class="code-font">${c.code}</strong></td>
                        <td>${username || '<span class="text-muted">N/A</span>'}</td>
                        <td>${c.subscription_type || 'Lifetime'}</td>
