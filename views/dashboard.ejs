<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Dating Sites</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: Arial, sans-serif; background: #1a1a2e; color: #e0e0e0; padding: 20px; }
        .container { max-width: 1400px; margin: 0 auto; }
        .header { display: flex; justify-content: space-between; align-items: center; padding: 15px 20px; background: rgba(255,255,255,0.05); border-radius: 10px; margin-bottom: 20px; }
        .header h1 { font-size: 24px; color: #fff; }
        .header .user { font-size: 14px; color: #aaa; }
        .header .user strong { color: #4CAF50; }
        .header .logout-btn { padding: 8px 20px; background: #f44336; color: #fff; border: none; border-radius: 6px; cursor: pointer; font-size: 14px; }
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 15px; margin-bottom: 20px; }
        .stat-card { background: rgba(255,255,255,0.05); padding: 15px; border-radius: 10px; text-align: center; border: 1px solid rgba(255,255,255,0.08); }
        .stat-card .number { font-size: 28px; font-weight: bold; color: #4CAF50; }
        .stat-card .label { font-size: 12px; color: #888; margin-top: 5px; }
        .card { background: rgba(255,255,255,0.05); padding: 20px; border-radius: 10px; margin-bottom: 20px; border: 1px solid rgba(255,255,255,0.08); }
        .card h3 { color: #fff; margin-bottom: 15px; font-size: 18px; }
        .form-group { margin-bottom: 12px; }
        .form-group label { display: block; font-size: 13px; color: #aaa; margin-bottom: 4px; font-weight: bold; }
        .form-group input, .form-group select { width: 100%; padding: 10px; border: 1px solid #555; border-radius: 6px; background: #222; color: #fff; font-size: 14px; }
        .form-group input:focus, .form-group select:focus { border-color: #4CAF50; outline: none; }
        .form-row { display: flex; gap: 15px; }
        .form-row .form-group { flex: 1; }
        .btn-primary { padding: 10px 20px; background: #4CAF50; color: #fff; border: none; border-radius: 6px; cursor: pointer; font-size: 14px; font-weight: bold; }
        .btn-primary:hover { background: #45a049; }
        .btn-danger { padding: 8px 15px; background: #f44336; color: #fff; border: none; border-radius: 4px; cursor: pointer; font-size: 12px; }
        .btn-danger:hover { background: #d32f2f; }
        .btn-small { padding: 4px 10px; font-size: 12px; border: none; border-radius: 4px; cursor: pointer; }
        .btn-small.btn-danger { background: #f44336; color: white; }
        .btn-small.btn-danger:hover { background: #d32f2f; }
        table { width: 100%; border-collapse: collapse; font-size: 13px; }
        table th { text-align: left; padding: 10px 8px; background: rgba(255,255,255,0.05); color: #aaa; border-bottom: 2px solid #333; }
        table td { padding: 8px; border-bottom: 1px solid rgba(255,255,255,0.05); }
        table tr:hover { background: rgba(255,255,255,0.03); }
        .badge { display: inline-block; padding: 2px 10px; border-radius: 12px; font-size: 11px; font-weight: bold; }
        .badge.active { background: rgba(76,175,80,0.2); color: #4CAF50; }
        .badge.inactive { background: rgba(244,67,54,0.2); color: #f44336; }
        .badge.vip { background: rgba(255,152,0,0.2); color: #FF9800; }
        .badge.svip { background: rgba(76,175,80,0.2); color: #4CAF50; }
        .badge.pending { background: rgba(255,193,7,0.2); color: #ffc107; }
        .badge.expired { background: rgba(244,67,54,0.2); color: #f44336; }
        .tab-buttons { display: flex; gap: 10px; margin-bottom: 15px; flex-wrap: wrap; }
        .tab-btn { padding: 8px 20px; border: 2px solid #555; border-radius: 6px; background: transparent; color: #aaa; cursor: pointer; font-size: 14px; }
        .tab-btn.active { border-color: #4CAF50; color: #4CAF50; background: rgba(76,175,80,0.1); }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        .scroll-table { overflow-x: auto; }
        .refresh-btn { padding: 6px 15px; background: #2196F3; color: #fff; border: none; border-radius: 4px; cursor: pointer; font-size: 12px; margin-left: 10px; }
        .refresh-btn:hover { background: #1976D2; }
        #hwid-result { margin-top: 10px; }
        .code-font { font-family: monospace; font-size: 13px; }
        @media (max-width: 768px) { .form-row { flex-direction: column; } .stats-grid { grid-template-columns: repeat(2, 1fr); } }
    </style>
</head>
<body>
    <div class="container">
        <!-- HEADER -->
        <div class="header">
            <div>
                <h1>🔐 Admin Dashboard</h1>
                <div class="user">Logged in as: <strong><%= username %></strong></div>
            </div>
            <div>
                <button class="refresh-btn" onclick="refreshData()">🔄 Refresh</button>
                <a href="/logout"><button class="logout-btn">🚪 Logout</button></a>
            </div>
        </div>

        <!-- STATS -->
        <div class="stats-grid" id="stats-grid">
            <div class="stat-card"><div class="number" id="stat-total">0</div><div class="label">Total Devices</div></div>
            <div class="stat-card"><div class="number" id="stat-approved">0</div><div class="label">Approved</div></div>
            <div class="stat-card"><div class="number" id="stat-revoked">0</div><div class="label">Revoked</div></div>
            <div class="stat-card"><div class="number" id="stat-pings">0</div><div class="label">Total Pings</div></div>
            <div class="stat-card"><div class="number" id="stat-codes">0</div><div class="label">Total Codes</div></div>
            <div class="stat-card"><div class="number" id="stat-active-codes">0</div><div class="label">Active Codes</div></div>
            <div class="stat-card"><div class="number" id="stat-requests">0</div><div class="label">Pending Requests</div></div>
        </div>

        <!-- TABS -->
        <div class="tab-buttons">
            <button class="tab-btn active" onclick="switchTab('codes')">🔑 Codes</button>
            <button class="tab-btn" onclick="switchTab('devices')">📱 Devices</button>
            <button class="tab-btn" onclick="switchTab('hwid')">🔐 HWID Codes</button>
            <button class="tab-btn" onclick="switchTab('requests')">📨 Requests</button>
            <button class="tab-btn" onclick="switchTab('logs')">📋 Logs</button>
        </div>

        <!-- ============================================ -->
        <!-- TAB 1: CODES -->
        <!-- ============================================ -->
        <div class="tab-content active" id="tab-codes">
            <div class="card">
                <h3>➕ Generate New Code</h3>
                <form id="generate-code-form">
                    <div class="form-row">
                        <div class="form-group">
                            <label>👤 Username</label>
                            <input type="text" id="gen-username" placeholder="e.g., john_doe" required>
                        </div>
                        <div class="form-group">
                            <label>🔐 Access Level</label>
                            <select id="gen-access">
                                <option value="VIP">VIP</option>
                                <option value="SVIP">SVIP</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>📅 Subscription</label>
                            <select id="gen-subscription">
                                <option value="Lifetime">Lifetime</option>
                                <option value="3 Months">3 Months</option>
                                <option value="6 Months">6 Months</option>
                                <option value="12 Months">12 Months</option>
                            </select>
                        </div>
                    </div>
                    <button type="submit" class="btn-primary">✅ Generate Code</button>
                </form>
                <div id="gen-result" style="margin-top:10px;"></div>
            </div>

            <div class="card">
                <h3>📋 All Codes</h3>
                <div class="scroll-table">
                    <table>
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Username</th>
                                <th>Access</th>
                                <th>Subscription</th>
                                <th>Expires</th>
                                <th>Devices</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody id="codes-body">
                            <tr><td colspan="8" style="text-align:center;color:#888;">Loading...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ============================================ -->
        <!-- TAB 2: DEVICES -->
        <!-- ============================================ -->
        <div class="tab-content" id="tab-devices">
            <div class="card">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:15px;">
                    <h3>📱 All Devices</h3>
                    <button class="btn-danger" onclick="deleteAllDevices()">🗑️ Delete All Devices</button>
                </div>
                <div class="scroll-table">
                    <table>
                        <thead>
                            <tr>
                                <th>Device ID</th>
                                <th>Code</th>
                                <th>IP</th>
                                <th>Status</th>
                                <th>Pings</th>
                                <th>Created</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody id="devices-body">
                            <tr><td colspan="7" style="text-align:center;color:#888;">Loading...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ============================================ -->
        <!-- TAB 3: HWID CODES (NEW) -->
        <!-- ============================================ -->
        <div class="tab-content" id="tab-hwid">
            <div class="card">
                <h3>🔐 Add Activation Code with HWID</h3>
                <form id="add-hwid-code-form">
                    <div class="form-row">
                        <div class="form-group">
                            <label>👤 Username</label>
                            <input type="text" id="hwid-username" placeholder="e.g., john_doe" required>
                        </div>
                        <div class="form-group">
                            <label>🔑 Activation Code</label>
                            <div style="display:flex;gap:8px;">
                                <input type="text" id="hwid-code" placeholder="XXXX-XXXX" required style="flex:1;">
                                <button type="button" onclick="generateHwidCode()" class="btn-small" style="background:#2196F3;color:#fff;padding:0 15px;">🔄 Random</button>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>🖥️ HWID (64 characters - from user's Python software)</label>
                        <input type="text" id="hwid-input" placeholder="64-character HWID" required style="font-family:monospace;font-size:12px;">
                    </div>
                    <div class="form-group">
                        <label>🖥️ Fingerprint (optional)</label>
                        <input type="text" id="hwid-fingerprint" placeholder="e.g., 8f7e3a2b-1c4d5e6f-9a0b1c2d">
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>🔐 Access Level</label>
                            <select id="hwid-access">
                                <option value="VIP">VIP</option>
                                <option value="SVIP">SVIP</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>📅 Subscription</label>
                            <select id="hwid-subscription">
                                <option value="Lifetime">Lifetime</option>
                                <option value="3 Months">3 Months</option>
                                <option value="6 Months">6 Months</option>
                                <option value="12 Months">12 Months</option>
                            </select>
                        </div>
                    </div>
                    <button type="submit" class="btn-primary">✅ Add HWID Code</button>
                </form>
                <div id="hwid-result"></div>
            </div>

            <div class="card">
                <h3>📋 Registered HWID Codes</h3>
                <div class="scroll-table">
                    <table>
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Username</th>
                                <th>HWID</th>
                                <th>Access</th>
                                <th>Subscription</th>
                                <th>Devices</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody id="hwid-codes-body">
                            <tr><td colspan="8" style="text-align:center;color:#888;">Loading...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ============================================ -->
        <!-- TAB 4: REQUESTS -->
        <!-- ============================================ -->
        <div class="tab-content" id="tab-requests">
            <div class="card">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:15px;">
                    <h3>📨 Pending Requests</h3>
                    <button class="btn-danger" onclick="deleteAllRequests()">🗑️ Delete All Requests</button>
                </div>
                <div class="scroll-table">
                    <table>
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Device ID</th>
                                <th>Reason</th>
                                <th>Status</th>
                                <th>Requested</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody id="requests-body">
                            <tr><td colspan="6" style="text-align:center;color:#888;">Loading...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ============================================ -->
        <!-- TAB 5: LOGS -->
        <!-- ============================================ -->
        <div class="tab-content" id="tab-logs">
            <div class="card">
                <h3>📋 Usage Logs</h3>
                <div class="scroll-table">
                    <table>
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Device</th>
                                <th>Code</th>
                                <th>Action</th>
                                <th>Details</th>
                                <th>Time</th>
                            </tr>
                        </thead>
                        <tbody id="logs-body">
                            <tr><td colspan="6" style="text-align:center;color:#888;">Loading...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>

    <script>
        // ============================================
        // TAB SWITCHING
        // ============================================
        function switchTab(tab) {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
            document.querySelector(`.tab-btn[onclick="switchTab('${tab}')"]`).classList.add('active');
            document.getElementById(`tab-${tab}`).classList.add('active');
            
            if (tab === 'hwid') loadHwidCodes();
            if (tab === 'codes') loadCodes();
            if (tab === 'devices') loadDevices();
            if (tab === 'requests') loadRequests();
            if (tab === 'logs') loadLogs();
        }

        // ============================================
        // REFRESH DATA
        // ============================================
        async function refreshData() {
            try {
                const response = await fetch('/api/force-refresh', { method: 'POST' });
                const result = await response.json();
                if (result.success) {
                    console.log('✅ Data refreshed');
                    loadAll();
                }
            } catch (error) {
                console.error('Refresh error:', error);
            }
        }

        // ============================================
        // LOAD ALL DATA
        // ============================================
        async function loadAll() {
            try {
                const response = await fetch('/api/dashboard-data');
                const data = await response.json();
                
                // Update stats
                document.getElementById('stat-total').textContent = data.stats.total || 0;
                document.getElementById('stat-approved').textContent = data.stats.approved || 0;
                document.getElementById('stat-revoked').textContent = data.stats.revoked || 0;
                document.getElementById('stat-pings').textContent = data.stats.totalPings || 0;
                document.getElementById('stat-codes').textContent = data.stats.totalCodes || 0;
                document.getElementById('stat-active-codes').textContent = data.stats.activeCodes || 0;
                document.getElementById('stat-requests').textContent = data.stats.pendingRequests || 0;
                
                // Load tables
                loadCodesTable(data.codes);
                loadDevicesTable(data.devices);
                loadRequestsTable(data.requests);
                loadLogsTable(data.logs || []);
            } catch (error) {
                console.error('Load data error:', error);
            }
        }

        // ============================================
        // CODES
        // ============================================
        function loadCodesTable(codes) {
            const tbody = document.getElementById('codes-body');
            if (!codes || codes.length === 0) {
                tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;color:#888;">No codes found</td></tr>';
                return;
            }
            tbody.innerHTML = codes.map(c => `
                <tr>
                    <td><strong class="code-font">${c.code}</strong></td>
                    <td>${c.username || 'N/A'}</td>
                    <td><span class="badge ${c.access_level === 'SVIP' ? 'svip' : 'vip'}">${c.access_level || 'VIP'}</span></td>
                    <td>${c.subscription_type || 'Lifetime'}</td>
                    <td>${c.expires_at ? new Date(c.expires_at).toLocaleDateString() : 'Never'}</td>
                    <td>${c.used_count || 0}</td>
                    <td>
                        <span class="badge ${c.is_active ? 'active' : 'inactive'}">
                            ${c.is_active ? '✅ Active' : '❌ Inactive'}
                        </span>
                        ${c.status === 'expired' ? ' ⏰ Expired' : ''}
                    </td>
                    <td>
                        <button onclick="deactivateCode('${c.code}')" class="btn-small btn-danger">Deactivate</button>
                        <button onclick="deleteCode('${c.code}')" class="btn-small" style="background:#607D8B;color:#fff;margin-top:4px;">Delete</button>
                    </td>
                </tr>
            `).join('');
        }

        async function loadCodes() {
            try {
                const response = await fetch('/api/codes');
                const codes = await response.json();
                loadCodesTable(codes);
            } catch (error) {
                console.error('Load codes error:', error);
            }
        }

        // Generate Code Form
        document.getElementById('generate-code-form').addEventListener('submit', async function(e) {
            e.preventDefault();
            const username = document.getElementById('gen-username').value.trim();
            const accessLevel = document.getElementById('gen-access').value;
            const subscriptionType = document.getElementById('gen-subscription').value;
            
            if (!username) {
                document.getElementById('gen-result').innerHTML = '<div style="color:#f44336;">❌ Username is required</div>';
                return;
            }
            
            try {
                const response = await fetch('/api/generate-code', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username, accessLevel, subscriptionType })
                });
                const result = await response.json();
                
                if (result.success) {
                    document.getElementById('gen-result').innerHTML = `
                        <div style="color:#4CAF50;padding:10px;border:1px solid #4CAF50;border-radius:6px;">
                            ✅ Code generated!<br>
                            <strong>Code:</strong> ${result.code}<br>
                            <strong>Username:</strong> ${result.username}<br>
                            <strong>Access:</strong> ${result.access}<br>
                            <strong>Subscription:</strong> ${result.subscription}
                        </div>
                    `;
                    document.getElementById('gen-username').value = '';
                    loadCodes();
                } else {
                    document.getElementById('gen-result').innerHTML = `<div style="color:#f44336;">❌ ${result.error}</div>`;
                }
            } catch (error) {
                document.getElementById('gen-result').innerHTML = `<div style="color:#f44336;">❌ Error: ${error.message}</div>`;
            }
        });

        // ============================================
        // DEVICES
        // ============================================
        function loadDevicesTable(devices) {
            const tbody = document.getElementById('devices-body');
            if (!devices || devices.length === 0) {
                tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;color:#888;">No devices found</td></tr>';
                return;
            }
            tbody.innerHTML = devices.slice(0, 100).map(d => `
                <tr>
                    <td><small class="code-font">${d.device_id}</small></td>
                    <td><strong>${d.code || 'N/A'}</strong></td>
                    <td>${d.ip_address || 'N/A'}</td>
                    <td><span class="badge ${d.status === 'approved' ? 'active' : 'inactive'}">${d.status}</span></td>
                    <td>${d.ping_count || 0}</td>
                    <td>${d.created_at ? new Date(d.created_at).toLocaleString() : 'N/A'}</td>
                    <td>
                        <button onclick="removeUser('${d.device_id}')" class="btn-small btn-danger">Remove</button>
                    </td>
                </tr>
            `).join('');
        }

        async function loadDevices() {
            try {
                const response = await fetch('/api/dashboard-data');
                const data = await response.json();
                loadDevicesTable(data.devices);
            } catch (error) {
                console.error('Load devices error:', error);
            }
        }

        async function removeUser(deviceId) {
            if (!confirm(`Remove device ${deviceId}?`)) return;
            try {
                const response = await fetch(`/api/device/${deviceId}`, { method: 'DELETE' });
                const result = await response.json();
                if (result.success) {
                    alert('✅ User removed!');
                    loadAll();
                }
            } catch (error) {
                alert('❌ Error: ' + error.message);
            }
        }

        async function deleteAllDevices() {
            if (!confirm('⚠️ Delete ALL devices? This cannot be undone!')) return;
            try {
                const response = await fetch('/api/delete-all-devices', { method: 'POST' });
                const result = await response.json();
                if (result.success) {
                    alert(`✅ ${result.message}`);
                    loadAll();
                }
            } catch (error) {
                alert('❌ Error: ' + error.message);
            }
        }

        // ============================================
        // HWID CODES (NEW)
        // ============================================
        function generateHwidCode() {
            const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
            let code = '';
            for (let i = 0; i < 8; i++) {
                code += chars.charAt(Math.floor(Math.random() * chars.length));
            }
            document.getElementById('hwid-code').value = code.slice(0, 4) + '-' + code.slice(4);
        }

        document.getElementById('add-hwid-code-form').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const username = document.getElementById('hwid-username').value.trim();
            const code = document.getElementById('hwid-code').value.trim().toUpperCase();
            const hwid = document.getElementById('hwid-input').value.trim();
            const fingerprint = document.getElementById('hwid-fingerprint').value.trim();
            const accessLevel = document.getElementById('hwid-access').value;
            const subscriptionType = document.getElementById('hwid-subscription').value;
            
            if (!username || !code || !hwid) {
                document.getElementById('hwid-result').innerHTML = '<div style="color:#f44336;">❌ Please fill in all required fields</div>';
                return;
            }
            
            if (hwid.length !== 64) {
                document.getElementById('hwid-result').innerHTML = '<div style="color:#f44336;">❌ HWID must be exactly 64 characters</div>';
                return;
            }
            
            document.getElementById('hwid-result').innerHTML = '<div style="color:#FF9800;">⏳ Adding code...</div>';
            
            try {
                const response = await fetch('/api/admin/add-hwid-code', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ code, hwid, fingerprint, username, accessLevel, subscriptionType })
                });
                
                const result = await response.json();
                
                if (result.success) {
                    document.getElementById('hwid-result').innerHTML = `
                        <div style="color:#4CAF50;padding:10px;border:1px solid #4CAF50;border-radius:6px;">
                            ✅ Code added successfully!<br>
                            <strong>Code:</strong> ${code}<br>
                            <strong>Username:</strong> ${username}<br>
                            <strong>Access:</strong> ${accessLevel}<br>
                            <strong>Subscription:</strong> ${subscriptionType}
                        </div>
                    `;
                    document.getElementById('add-hwid-code-form').reset();
                    loadHwidCodes();
                } else {
                    document.getElementById('hwid-result').innerHTML = `<div style="color:#f44336;">❌ ${result.error}</div>`;
                }
            } catch (error) {
                document.getElementById('hwid-result').innerHTML = `<div style="color:#f44336;">❌ Error: ${error.message}</div>`;
            }
        });

        async function loadHwidCodes() {
            try {
                const response = await fetch('/api/admin/hwid-codes');
                const codes = await response.json();
                
                const tbody = document.getElementById('hwid-codes-body');
                if (!codes || codes.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;color:#888;">No HWID codes registered</td></tr>';
                    return;
                }
                
                tbody.innerHTML = codes.map(c => `
                    <tr>
                        <td><strong class="code-font">${c.code}</strong></td>
                        <td>${c.username || 'N/A'}</td>
                        <td><small class="code-font" style="font-size:11px;">${c.hwid || 'N/A'}</small></td>
                        <td><span class="badge ${c.access_level === 'SVIP' ? 'svip' : 'vip'}">${c.access_level}</span></td>
                        <td>${c.subscription_type}</td>
                        <td>${c.used_count || 0}</td>
                        <td>
                            <span class="badge ${c.is_active ? 'active' : 'inactive'}">
                                ${c.is_active ? '✅ Active' : '❌ Inactive'}
                            </span>
                            ${c.status === 'expired' ? ' ⏰ Expired' : ''}
                        </td>
                        <td>
                            <button onclick="deactivateHwidCode('${c.code}')" class="btn-small btn-danger">Deactivate</button>
                        </td>
                    </tr>
                `).join('');
            } catch (error) {
                console.error('Load HWID codes error:', error);
            }
        }

        async function deactivateHwidCode(code) {
            if (!confirm(`Deactivate code ${code}? This will revoke all devices.`)) return;
            try {
                const response = await fetch(`/api/code/${code}/deactivate`, { method: 'POST' });
                const result = await response.json();
                if (result.success) {
                    alert(`✅ Code ${code} deactivated!`);
                    loadHwidCodes();
                } else {
                    alert('❌ Error: ' + (result.error || 'Unknown error'));
                }
            } catch (error) {
                alert('❌ Error: ' + error.message);
            }
        }

        // ============================================
        // REQUESTS
        // ============================================
        function loadRequestsTable(requests) {
            const tbody = document.getElementById('requests-body');
            if (!requests || requests.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;color:#888;">No requests found</td></tr>';
                return;
            }
            tbody.innerHTML = requests.filter(r => r.status === 'pending').map(r => `
                <tr>
                    <td>${r.id}</td>
                    <td><small>${r.device_id}</small></td>
                    <td>${r.reason || 'N/A'}</td>
                    <td><span class="badge pending">${r.status}</span></td>
                    <td>${r.requested_at ? new Date(r.requested_at).toLocaleString() : 'N/A'}</td>
                    <td>
                        <button onclick="respondRequest(${r.id}, 'approved')" class="btn-small" style="background:#4CAF50;color:#fff;">✅ Approve</button>
                        <button onclick="respondRequest(${r.id}, 'rejected')" class="btn-small btn-danger">❌ Reject</button>
                    </td>
                </tr>
            `).join('');
        }

        async function loadRequests() {
            try {
                const response = await fetch('/api/dashboard-data');
                const data = await response.json();
                loadRequestsTable(data.requests);
            } catch (error) {
                console.error('Load requests error:', error);
            }
        }

        async function respondRequest(id, status) {
            if (!confirm(`${status === 'approved' ? '✅ Approve' : '❌ Reject'} request #${id}?`)) return;
            try {
                const response = await fetch(`/api/request/${id}/respond`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ status, response: `Admin ${status} request` })
                });
                const result = await response.json();
                if (result.success) {
                    alert(`✅ Request ${status}!`);
                    loadAll();
                }
            } catch (error) {
                alert('❌ Error: ' + error.message);
            }
        }

        async function deleteAllRequests() {
            if (!confirm('⚠️ Delete ALL requests?')) return;
            try {
                const response = await fetch('/api/delete-all-requests', { method: 'POST' });
                const result = await response.json();
                if (result.success) {
                    alert(`✅ ${result.message}`);
                    loadAll();
                }
            } catch (error) {
                alert('❌ Error: ' + error.message);
            }
        }

        // ============================================
        // LOGS
        // ============================================
        function loadLogsTable(logs) {
            const tbody = document.getElementById('logs-body');
            if (!logs || logs.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;color:#888;">No logs found</td></tr>';
                return;
            }
            tbody.innerHTML = logs.slice(0, 50).map(l => `
                <tr>
                    <td>${l.id}</td>
                    <td><small>${l.device_id || 'system'}</small></td>
                    <td>${l.code || 'N/A'}</td>
                    <td>${l.action}</td>
                    <td>${l.details || ''}</td>
                    <td>${l.created_at ? new Date(l.created_at).toLocaleString() : 'N/A'}</td>
                </tr>
            `).join('');
        }

        async function loadLogs() {
            try {
                const response = await fetch('/api/dashboard-data');
                const data = await response.json();
                loadLogsTable(data.logs || []);
            } catch (error) {
                console.error('Load logs error:', error);
            }
        }

        // ============================================
        // CODE ACTIONS
        // ============================================
        async function deactivateCode(code) {
            if (!confirm(`Deactivate code ${code}?`)) return;
            try {
                const response = await fetch(`/api/code/${code}/deactivate`, { method: 'POST' });
                const result = await response.json();
                if (result.success) {
                    alert(`✅ Code ${code} deactivated!`);
                    loadAll();
                }
            } catch (error) {
                alert('❌ Error: ' + error.message);
            }
        }

        async function deleteCode(code) {
            if (!confirm(`⚠️ Permanently delete code ${code}? This cannot be undone!`)) return;
            try {
                const response = await fetch(`/api/code/${code}`, { method: 'DELETE' });
                const result = await response.json();
                if (result.success) {
                    alert(`✅ ${result.message}`);
                    loadAll();
                }
            } catch (error) {
                alert('❌ Error: ' + error.message);
            }
        }

        // ============================================
        // INIT
        // ============================================
        document.addEventListener('DOMContentLoaded', function() {
            loadAll();
            // Auto-refresh every 60 seconds
            setInterval(loadAll, 60000);
        });
    </script>
</body>
</html>