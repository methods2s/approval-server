        function populateHwidCodeDropdown() {
            const select = document.getElementById('hwid-code-select');
            const currentValue = select.value;
            
            select.innerHTML = '<option value="">-- Select a code --</option>';
            allCodes.forEach(c => {
                const option = document.createElement('option');
                option.value = c.code;
                const statusText = c.is_active ? '' : ' (Inactive)';
                option.textContent = `${c.code} - ${c.username || 'N/A'}${statusText}`;
                if (c.code === currentValue) option.selected = true;
                select.appendChild(option);
            });
            
            if (currentValue) {
                loadHwidDetails();
            }
        }

        async function loadHwidDetails() {
            const code = document.getElementById('hwid-code-select').value;
            if (!code) {
                document.getElementById('hwid-info').style.display = 'none';
                document.getElementById('hwid-list-section').style.display = 'none';
                return;
            }
            
            try {
                // Show loading
                document.getElementById('hwid-info').style.display = 'block';
                document.getElementById('hwid-list-section').style.display = 'block';
                document.getElementById('hwid-list-body').innerHTML = '<tr><td colspan="5" style="text-align:center;color:#888;padding:20px;">Loading...</td></tr>';
                
                // Get HWID limit
                const limitResponse = await fetch(`/api/code/${code}/hwid-limit`);
                const limitData = await limitResponse.json();
                
                // Get all devices for this code
                const devicesResponse = await fetch('/api/dashboard-data');
                const devicesData = await devicesResponse.json();
                const allDevicesForCode = (devicesData.devices || []).filter(d => d.code === code);
                
                // Get HWIDs
                const hwidResponse = await fetch(`/api/code/${code}/hwids`);
                const hwidData = await hwidResponse.json();
                
                const currentCount = hwidData.hwids ? hwidData.hwids.length : 0;
                const maxLimit = limitData.max_hwid_limit || 1;
                const availableSlots = maxLimit - currentCount;
                
                document.getElementById('hwid-current-count').textContent = currentCount;
                document.getElementById('hwid-max-limit').textContent = maxLimit;
                document.getElementById('hwid-available-slots').textContent = availableSlots < 0 ? 0 : availableSlots;
                document.getElementById('hwid-total-profiles').textContent = allDevicesForCode.length || 0;
                document.getElementById('hwid-limit-input').value = maxLimit;
                
                // Get code info for hardware specs
                const codeInfo = allCodes.find(c => c.code === code);
                
                // Update hardware specs from the FIRST device (or code info)
                if (codeInfo) {
                    document.getElementById('hw-spec-cpu').textContent = codeInfo.cpu_name || 'N/A';
                    document.getElementById('hw-spec-gpu').textContent = codeInfo.gpu_name || 'N/A';
                    document.getElementById('hw-spec-ram').textContent = codeInfo.ram_total_gb ? codeInfo.ram_total_gb + ' GB' : 'N/A';
                    document.getElementById('hw-spec-storage').textContent = codeInfo.storage_total_gb ? codeInfo.storage_total_gb + ' GB' : 'N/A';
                    document.getElementById('hw-spec-device').textContent = codeInfo.device_name || 'N/A';
                    document.getElementById('hw-spec-profile').textContent = codeInfo.profile_name || 'N/A';
                } else {
                    // Try to get from devices
                    const firstDevice = allDevicesForCode[0];
                    if (firstDevice) {
                        document.getElementById('hw-spec-cpu').textContent = firstDevice.cpu_name || 'N/A';
                        document.getElementById('hw-spec-gpu').textContent = firstDevice.gpu_name || 'N/A';
                        document.getElementById('hw-spec-ram').textContent = firstDevice.ram_total_gb ? firstDevice.ram_total_gb + ' GB' : 'N/A';
                        document.getElementById('hw-spec-storage').textContent = firstDevice.storage_total_gb ? firstDevice.storage_total_gb + ' GB' : 'N/A';
                        document.getElementById('hw-spec-device').textContent = firstDevice.device_name || 'N/A';
                        document.getElementById('hw-spec-profile').textContent = firstDevice.browser_profile || 'N/A';
                    } else {
                        document.getElementById('hw-spec-cpu').textContent = 'N/A';
                        document.getElementById('hw-spec-gpu').textContent = 'N/A';
                        document.getElementById('hw-spec-ram').textContent = 'N/A';
                        document.getElementById('hw-spec-storage').textContent = 'N/A';
                        document.getElementById('hw-spec-device').textContent = 'N/A';
                        document.getElementById('hw-spec-profile').textContent = 'N/A';
                    }
                }
                
                // Update limit status
                const statusEl = document.getElementById('hwid-limit-status');
                if (availableSlots <= 0) {
                    statusEl.style.display = 'block';
                    statusEl.style.background = 'rgba(244,67,54,0.15)';
                    statusEl.style.color = '#f44336';
                    statusEl.style.border = '1px solid #f44336';
                    statusEl.innerHTML = `⚠️ HWID LIMIT REACHED! (${currentCount}/${maxLimit}) - New devices will AUTO-DEACTIVATE this code!`;
                } else if (availableSlots <= 2) {
                    statusEl.style.display = 'block';
                    statusEl.style.background = 'rgba(255,152,0,0.15)';
                    statusEl.style.color = '#FF9800';
                    statusEl.style.border = '1px solid #FF9800';
                    statusEl.innerHTML = `⚠️ Only ${availableSlots} slot(s) remaining (${currentCount}/${maxLimit})`;
                } else {
                    statusEl.style.display = 'none';
                }
                
                // Render HWID list
                renderHwidList(hwidData, allDevicesForCode);
                
            } catch (error) {
                console.error('Load HWID details error:', error);
                document.getElementById('hwid-list-body').innerHTML = `<tr><td colspan="5" style="text-align:center;color:#f44336;padding:20px;">❌ Error loading HWIDs: ${error.message}</td></tr>`;
                showMessage('❌ Error loading HWID details: ' + error.message, 'error');
            }
        }

        function renderHwidList(hwidData, devices) {
            const tbody = document.getElementById('hwid-list-body');
            
            // Check if hwidData has hwids array
            const hwids = (hwidData && hwidData.hwids && Array.isArray(hwidData.hwids)) ? hwidData.hwids : [];
            
            if (!hwids || hwids.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;color:#888;padding:20px;">No HWIDs assigned to this code</td></tr>';
                return;
            }
            
            tbody.innerHTML = hwids.map((h, index) => {
                const deviceCount = devices ? devices.filter(d => d.hwid === h.hwid && d.status === 'approved').length : 0;
                const canRemove = hwids.length > 1;
                
                // Get hardware specs from devices
                const device = devices ? devices.find(d => d.hwid === h.hwid) : null;
                const cpu = device?.cpu_name || 'N/A';
                const gpu = device?.gpu_name || 'N/A';
                const ram = device?.ram_total_gb ? device.ram_total_gb + ' GB' : 'N/A';
                const storage = device?.storage_total_gb ? device.storage_total_gb + ' GB' : 'N/A';
                const deviceName = device?.device_name || 'N/A';
                const profile = device?.browser_profile || 'N/A';
                
                return `
                    <tr>
                        <td>${index + 1}</td>
                        <td><code style="font-size:11px;">${h.hwid_masked || h.hwid.substring(0,16) + '...'}</code></td>
                        <td>
                            <span class="device-count-badge">
                                ${deviceCount} ${deviceCount === 1 ? 'Profile' : 'Profiles'}
                                ${deviceCount > 0 ? '👤' : ''}
                            </span>
                        </td>
                        <td style="font-size:11px;">
                            <span class="hw-spec-item hw-spec-cpu">CPU: ${cpu}</span>
                            <span class="hw-spec-item hw-spec-gpu">GPU: ${gpu}</span>
                            <span class="hw-spec-item hw-spec-ram">RAM: ${ram}</span>
                            <span class="hw-spec-item hw-spec-storage">Storage: ${storage}</span>
                            <span class="hw-spec-item hw-spec-device">Device: ${deviceName}</span>
                            <span class="hw-spec-item hw-spec-profile">Profile: ${profile}</span>
                        </td>
                        <td>
                            ${canRemove ? `
                                <button onclick="removeHwid('${h.hwid}')" class="btn-small btn-remove">
                                    🗑️ Remove
                                </button>
                            ` : `
                                <button class="btn-small" style="background:#555;color:#888;cursor:not-allowed;" disabled>
                                    🔒 Last HWID
                                </button>
                            `}
                        </td>
                    </tr>
                `;
            }).join('');
        }

        async function removeHwid(hwid) {
            const code = document.getElementById('hwid-code-select').value;
            
            if (!code || !hwid) {
                showMessage('❌ Invalid code or HWID', 'error');
                return;
            }
            
            if (!confirm(`⚠️ Remove this computer (HWID: ${hwid.substring(0,16)}...)?\n\nThis will revoke access for this computer.`)) {
                return;
            }
            
            try {
                const response = await fetch(`/api/code/${code}/hwid/${hwid}`, {
                    method: 'DELETE'
                });
                const result = await response.json();
                
                if (result.success) {
                    showMessage(`✅ ${result.message}`, 'success');
                    setTimeout(() => hideMessage(), 2000);
                    // Reload everything
                    await loadHwidDetails();
                    await loadAll();
                    await loadDevices();
                } else {
                    showMessage('❌ ' + (result.error || 'Failed to remove HWID'), 'error');
                }
            } catch (error) {
                showMessage('❌ Error: ' + error.message, 'error');
            }
        }

        async function updateHwidLimit() {
            const code = document.getElementById('hwid-code-select').value;
            const limit = parseInt(document.getElementById('hwid-limit-input').value);
            
            if (!code) {
                showMessage('❌ Please select a code first', 'error');
                return;
            }
            
            if (!limit || limit < 1 || limit > 10) {
                showMessage('❌ Limit must be between 1 and 10', 'error');
                return;
            }
            
            try {
                const response = await fetch(`/api/code/${code}/hwid-limit`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ limit })
                });
                const result = await response.json();
                
                if (result.success) {
                    showMessage(`✅ ${result.message}`, 'success');
                    setTimeout(() => hideMessage(), 2000);
                    loadHwidDetails();
                    await loadAll();
                } else {
                    showMessage('❌ ' + (result.error || 'Failed to update limit'), 'error');
                }
            } catch (error) {
                showMessage('❌ Error: ' + error.message, 'error');
            }
        }

        // ============================================
        // EDIT FUNCTIONS
        // ============================================
        function startEdit(code) {
            editingCode = null;
            editingCode = code;
            renderAllCodes();
            const row = document.querySelector(`tr.editing`);
            if (row) row.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        function cancelEdit() {
            editingCode = null;
            renderAllCodes();
        }

        async function saveEdit(code) {
            const username = document.getElementById(`edit-username-${code}`).value.trim();
            const accessLevel = document.getElementById(`edit-access-${code}`).value;
            const subscriptionType = document.getElementById(`edit-subscription-${code}`).value;
            const hwidLimit = parseInt(document.getElementById(`edit-hwid-limit-${code}`).value) || 1;
            
            try {
                showMessage('💾 Saving changes...', 'loading');
                
                const currentCode = allCodes.find(c => c.code === code);
                
                if (currentCode && username && currentCode.username !== username) {
                    const response = await fetch(`/api/code/${code}/username`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ username })
                    });
                    const result = await response.json();
                    if (!result.success) {
                        showMessage('❌ ' + (result.error || 'Failed to update username'), 'error');
                        return;
                    }
                }
                
                if (currentCode && currentCode.access_level !== accessLevel) {
                    const response = await fetch(`/api/code/${code}/access`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ accessLevel })
                    });
                    const result = await response.json();
                    if (!result.success) {
                        showMessage('❌ ' + (result.error || 'Failed to update access'), 'error');
                        return;
                    }
                }
                
                if (currentCode && currentCode.subscription_type !== subscriptionType) {
                    const response = await fetch(`/api/code/${code}/subscription`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ subscriptionType })
                    });
                    const result = await response.json();
                    if (!result.success) {
                        showMessage('❌ ' + (result.error || 'Failed to update subscription'), 'error');
                        return;
                    }
                }

                if (currentCode && currentCode.max_hwid_limit !== hwidLimit) {
                    const response = await fetch(`/api/code/${code}/hwid-limit`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ limit: hwidLimit })
                    });
                    const result = await response.json();
                    if (!result.success) {
                        showMessage('❌ ' + (result.error || 'Failed to update HWID limit'), 'error');
                        return;
                    }
                }
                
                editingCode = null;
                showMessage('✅ Changes saved successfully!', 'success');
                setTimeout(() => hideMessage(), 2000);
                await loadAll();
                
            } catch (error) {
                showMessage('❌ Error saving: ' + error.message, 'error');
            }
        }

        // ============================================
        // TOGGLE STATUS
        // ============================================
        async function toggleStatus(code) {
            const codeInfo = allCodes.find(c => c.code === code);
            if (!codeInfo) return;
            
            const action = codeInfo.is_active ? 'deactivate' : 'reactivate';
            const confirmMsg = codeInfo.is_active ? 
                `⚠️ Deactivate code ${code}? This will revoke all profiles.` :
                `🔓 Reactivate code ${code}? This will restore access.`;
            
            if (!confirm(confirmMsg)) return;
            
            try {
                let response;
                if (codeInfo.is_active) {
                    response = await fetch(`/api/code/${code}/deactivate`, { method: 'POST' });
                } else {
                    response = await fetch(`/api/code/${code}/reactivate`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ subscriptionType: codeInfo.subscription_type || 'Lifetime' })
                    });
                }
                const result = await response.json();
                if (result.success) {
                    showMessage(`✅ Code ${code} ${codeInfo.is_active ? 'deactivated' : 'reactivated'}!`, 'success');
                    setTimeout(() => hideMessage(), 2000);
                    await loadAll();
                } else {
                    showMessage('❌ ' + (result.error || 'Failed to toggle status'), 'error');
                }
            } catch (error) {
                showMessage('❌ Error: ' + error.message, 'error');
            }
        }

        // ============================================
        // DELETE CODE
        // ============================================
        async function deleteCode(code) {
            if (!confirm(`⚠️ Permanently delete code ${code}? This cannot be undone! All profiles and HWIDs will be removed.`)) return;
            
            try {
                const response = await fetch(`/api/code/${code}`, { method: 'DELETE' });
                const result = await response.json();
                if (result.success) {
                    showMessage(`✅ ${result.message}`, 'success');
                    setTimeout(() => hideMessage(), 2000);
                    await loadAll();
                } else {
                    showMessage('❌ ' + (result.error || 'Failed to delete code'), 'error');
                }
            } catch (error) {
                showMessage('❌ Error: ' + error.message, 'error');
            }
        }

        // ============================================
        // GENERATE CODE
        // ============================================
        document.getElementById('generate-code-form').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const username = document.getElementById('gen-username').value.trim();
            const accessLevel = document.getElementById('gen-access').value;
            const subscriptionType = document.getElementById('gen-subscription').value;
            
            if (!username) {
                showMessage('❌ Username is required!', 'error');
                return;
            }
            
            showMessage('⏳ Generating code...', 'loading');
            
            try {
                const response = await fetch('/api/generate-code', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username, accessLevel, subscriptionType })
                });
                
                const result = await response.json();
                
                if (result.success) {
                    showMessage(`
                        ✅ Code generated successfully!<br>
                        <strong>Code:</strong> ${result.code}<br>
                        <strong>Username:</strong> ${result.username}<br>
                        <strong>Access:</strong> ${result.access}<br>
                        <strong>Subscription:</strong> ${result.subscription}<br>
                        <span style="color:#FF9800;font-size:12px;">ℹ️ HWID will be auto-assigned when first used (Limit: 1)</span>
                    `, 'success');
                    
                    document.getElementById('gen-username').value = '';
                    
                    setTimeout(() => hideMessage(), 5000);
                    await loadAll();
                } else {
                    showMessage('❌ ' + (result.error || 'Unknown error'), 'error');
                }
            } catch (error) {
                showMessage('❌ Error: ' + error.message, 'error');
            }
        });

        // ============================================
        // MESSAGE HELPERS
        // ============================================
        function showMessage(msg, type) {
            const el = document.getElementById('result-message');
            if (!el) return;
            el.innerHTML = msg;
            el.className = type;
            el.style.display = 'block';
        }
        
        function hideMessage() {
            const el = document.getElementById('result-message');
            if (el) {
                el.style.display = 'none';
                el.className = '';
            }
        }

        // ============================================
        // INIT
        // ============================================
        document.addEventListener('DOMContentLoaded', function() {
            loadAll();
            setInterval(loadAll, 60000);
        });
    </script>
</body>
</html>