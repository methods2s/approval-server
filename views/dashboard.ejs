        // ============================================
        // EDIT FUNCTIONS
        // ============================================
        function startEdit(code) {
            editingCode = code;
            filterSVIP();
            filterVIP();
            const row = document.querySelector(`tr.editing`);
            if (row) row.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        function cancelEdit() {
            editingCode = null;
            filterSVIP();
            filterVIP();
        }

        async function saveEdit(code) {
            const username = document.getElementById(`edit-username-${code}`).value.trim();
            const subscriptionType = document.getElementById(`edit-subscription-${code}`).value;
            const hwidLimit = parseInt(document.getElementById(`edit-hwid-limit-${code}`).value) || 1;
            
            try {
                showMessage('💾 Saving...', 'loading');
                const currentCode = allCodes.find(c => c.code === code);
                
                if (currentCode && username && currentCode.username !== username) {
                    const response = await fastFetch(`/api/code/${code}/username`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ username })
                    });
                    const result = await response.json();
                    if (!result.success) {
                        showMessage('❌ ' + (result.error || 'Failed to update username'), 'error');
                        return;
                    }
                }
                
                if (currentCode && currentCode.subscription_type !== subscriptionType) {
                    const response = await fastFetch(`/api/code/${code}/subscription`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ subscriptionType })
                    });
                    const result = await response.json();
                    if (!result.success) {
                        showMessage('❌ ' + (result.error || 'Failed to update subscription'), 'error');
                        return;
                    }
                }

                if (currentCode && currentCode.max_hwid_limit !== hwidLimit) {
                    const response = await fastFetch(`/api/code/${code}/hwid-limit`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ limit: hwidLimit })
                    });
                    const result = await response.json();
                    if (!result.success) {
                        showMessage('❌ ' + (result.error || 'Failed to update HWID limit'), 'error');
                        return;
                    }
                }
                
                editingCode = null;
                showMessage('✅ Changes saved!', 'success');
                await loadAll();
                
            } catch (error) {
                showMessage('❌ Error saving: ' + error.message, 'error');
            }
        }

        // ============================================
        // TOGGLE STATUS
        // ============================================
        async function toggleStatus(code) {
            const codeInfo = allCodes.find(c => c.code === code);
            if (!codeInfo) return;
            
            const confirmMsg = codeInfo.is_active ? 
                `⚠️ Deactivate code ${code}?\n\nThis will remove all HWIDs and devices.` :
                `🔓 Reactivate code ${code}?\n\nThis will remove all existing HWIDs. User will need to run Python again.`;
            
            if (!confirm(confirmMsg)) return;
            
            try {
                let response;
                if (codeInfo.is_active) {
                    response = await fastFetch(`/api/code/${code}/deactivate`, { method: 'POST' });
                } else {
                    response = await fastFetch(`/api/code/${code}/reactivate`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ subscriptionType: codeInfo.subscription_type || 'Lifetime' })
                    });
                }
                const result = await response.json();
                if (result.success) {
                    let msg = `✅ Code ${code} ${codeInfo.is_active ? 'deactivated' : 'reactivated'}!`;
                    if (result.hwids_removed !== undefined && result.hwids_removed > 0) {
                        msg += ` ${result.hwids_removed} HWID(s) removed.`;
                    }
                    if (result.devices_removed !== undefined && result.devices_removed > 0) {
                        msg += ` ${result.devices_removed} device(s) removed.`;
                    }
                    showMessage(msg, 'success');
                    hwidDetailsCache = {};
                    await loadAll();
                } else {
                    showMessage('❌ ' + (result.error || 'Failed to toggle status'), 'error');
                }
            } catch (error) {
                showMessage('❌ Error: ' + error.message, 'error');
            }
        }

        // ============================================
        // DELETE CODE
        // ============================================
        async function deleteCode(code) {
            if (!confirm(`⚠️ Permanently delete code ${code}?`)) return;
            try {
                const response = await fastFetch(`/api/code/${code}`, { method: 'DELETE' });
                const result = await response.json();
                if (result.success) {
                    showMessage(`✅ ${result.message}`, 'success');
                    hwidDetailsCache = {};
                    await loadAll();
                } else {
                    showMessage('❌ ' + (result.error || 'Failed to delete code'), 'error');
                }
            } catch (error) {
                showMessage('❌ Error: ' + error.message, 'error');
            }
        }

        // ============================================
        // GENERATE CODE
        // ============================================
        document.getElementById('generate-code-form').addEventListener('submit', async function(e) {
            e.preventDefault();
            const username = document.getElementById('gen-username').value.trim();
            const accessLevel = document.getElementById('gen-access').value;
            const subscriptionType = document.getElementById('gen-subscription').value;
            
            if (!username) {
                showMessage('❌ Username is required!', 'error');
                return;
            }
            
            showMessage('⏳ Generating...', 'loading');
            try {
                const response = await fastFetch('/api/generate-code', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username, accessLevel, subscriptionType })
                });
                const result = await response.json();
                if (result.success) {
                    showMessage(`✅ Code ${result.code} generated for ${result.username}`, 'success');
                    document.getElementById('gen-username').value = '';
                    hwidDetailsCache = {};
                    await loadAll();
                } else {
                    showMessage('❌ ' + (result.error || 'Unknown error'), 'error');
                }
            } catch (error) {
                showMessage('❌ Error: ' + error.message, 'error');
            }
        });

        // ============================================
        // HWID MANAGEMENT FUNCTIONS
        // ============================================

        function populateHwidCodeDropdown() {
            const select = document.getElementById('hwid-code-select');
            const currentValue = select.value;
            select.innerHTML = '<option value="">-- Select a code --</option>';
            allCodes.forEach(c => {
                const option = document.createElement('option');
                option.value = c.code;
                const statusText = c.is_active ? '' : ' (Inactive)';
                option.textContent = `${c.code} - ${c.username || 'N/A'}${statusText}`;
                if (c.code === currentValue) option.selected = true;
                select.appendChild(option);
            });
        }

        async function loadHwidDetails() {
            const code = document.getElementById('hwid-code-select').value;
            if (!code) {
                document.getElementById('hwid-info').style.display = 'none';
                document.getElementById('hwid-list-section').style.display = 'none';
                document.getElementById('hwid-list-body').innerHTML = '<tr><td colspan="4" style="text-align:center;color:#888;padding:20px;">Select a code to view HWIDs</td></tr>';
                return;
            }
            
            hwidDetailsCache[code] = null;
            
            try {
                document.getElementById('hwid-info').style.display = 'block';
                document.getElementById('hwid-list-section').style.display = 'block';
                document.getElementById('hwid-list-body').innerHTML = '<tr><td colspan="4" style="text-align:center;color:#888;padding:20px;"><div class="loading-text"><span class="spinner"></span> Loading HWIDs...</div></td></tr>';
                
                const [limitResponse, hwidResponse] = await Promise.all([
                    fastFetch(`/api/code/${code}/hwid-limit`),
                    fastFetch(`/api/code/${code}/hwids`)
                ]);
                
                if (!limitResponse.ok || !hwidResponse.ok) {
                    throw new Error('Failed to fetch HWID data');
                }
                
                const limitData = await limitResponse.json();
                const hwidData = await hwidResponse.json();
                
                hwidDetailsCache[code] = {
                    timestamp: Date.now(),
                    limitData: limitData,
                    hwidData: hwidData
                };
                
                updateHwidStats({ limitData, hwidData });
                renderHwidList(hwidData);
                
            } catch (error) {
                console.error('Load HWID details error:', error);
                document.getElementById('hwid-list-body').innerHTML = `<tr><td colspan="4" style="text-align:center;color:#f44336;padding:20px;">❌ Error loading HWIDs: ${error.message}</td></tr>`;
                showMessage('❌ Error loading HWID details: ' + error.message, 'error');
            }
        }

        function updateHwidStats(data) {
            const currentCount = data.hwidData.hwids ? data.hwidData.hwids.length : 0;
            const maxLimit = data.limitData.max_hwid_limit || 1;
            const availableSlots = maxLimit - currentCount;
            
            document.getElementById('hwid-current-count').textContent = currentCount;
            document.getElementById('hwid-max-limit').textContent = maxLimit;
            document.getElementById('hwid-available-slots').textContent = availableSlots < 0 ? 0 : availableSlots;
            document.getElementById('hwid-limit-input').value = maxLimit;
            
            const statusEl = document.getElementById('hwid-limit-status');
            if (availableSlots <= 0) {
                statusEl.style.display = 'block';
                statusEl.style.background = 'rgba(244,67,54,0.15)';
                statusEl.style.color = '#f44336';
                statusEl.style.border = '1px solid #f44336';
                statusEl.innerHTML = `⚠️ HWID LIMIT REACHED! (${currentCount}/${maxLimit}) - New devices will AUTO-DEACTIVATE this code!`;
            } else if (availableSlots <= 2) {
                statusEl.style.display = 'block';
                statusEl.style.background = 'rgba(255,152,0,0.15)';
                statusEl.style.color = '#FF9800';
                statusEl.style.border = '1px solid #FF9800';
                statusEl.innerHTML = `⚠️ Only ${availableSlots} slot(s) remaining (${currentCount}/${maxLimit})`;
            } else {
                statusEl.style.display = 'none';
            }
        }

        function renderHwidList(hwidData) {
            const tbody = document.getElementById('hwid-list-body');
            const hwids = (hwidData && hwidData.hwids && Array.isArray(hwidData.hwids)) ? hwidData.hwids : [];
            
            if (!hwids || hwids.length === 0) {
                tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;color:#888;padding:20px;">No HWIDs assigned to this code</td></tr>';
                return;
            }
            
            tbody.innerHTML = hwids.map((h, index) => {
                const hwidFull = h.hwid || h.hwid_full || '';
                const hwidMasked = h.hwid_masked || (hwidFull ? hwidFull.substring(0, 16) + '...' : 'N/A');
                const hardware = h.hardware || {};
                
                const cpu = hardware.cpu || 'N/A';
                const gpu = hardware.gpu || 'N/A';
                const ram = hardware.ram_gb ? hardware.ram_gb + ' GB' : 'N/A';
                const deviceName = hardware.device_name || 'N/A';
                const profile = hardware.profile_name || 'N/A';
                const registeredOwner = hardware.registered_owner || 'N/A';
                
                const hasSpecs = cpu !== 'N/A' || gpu !== 'N/A';
                
                return `
                    <tr>
                        <td style="text-align:center;font-weight:bold;color:#888;">${index + 1}</td>
                        <td>
                            <code style="font-size:11px;font-weight:bold;color:#4CAF50;word-break:break-all;" title="${hwidFull}">${hwidMasked}</code>
                        </td>
                        <td style="font-size:11px;line-height:1.8;">
                            ${hasSpecs ? `
                                <div><span class="hwid-spec-detail cpu">🔧 CPU: ${cpu}</span></div>
                                <div><span class="hwid-spec-detail gpu">🎮 GPU: ${gpu}</span></div>
                                <div><span class="hwid-spec-detail ram">💾 RAM: ${ram}</span></div>
                                <div><span class="hwid-spec-detail device">💻 Device: ${deviceName}</span></div>
                                <div><span class="hwid-spec-detail profile">👤 Profile: ${profile}</span></div>
                                <div><span class="hwid-spec-detail owner">👔 Owner: ${registeredOwner}</span></div>
                            ` : `
                                <div style="color:#888;font-style:italic;">No hardware specs available. Please register a device first.</div>
                            `}
                        </td>
                        <td style="text-align:center;">
                            <button onclick="removeHwid('${hwidFull}')" class="btn-remove-hwid" id="remove-btn-${index}">
                                🗑️ Remove
                            </button>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        async function removeHwid(hwid) {
            const code = document.getElementById('hwid-code-select').value;
            if (!code || !hwid) {
                showMessage('❌ Invalid code or HWID', 'error');
                return;
            }
            if (!confirm(`⚠️ Remove this HWID from code ${code}?`)) {
                return;
            }
            
            document.querySelectorAll('.btn-remove-hwid').forEach(btn => {
                btn.disabled = true;
                btn.textContent = '⏳';
            });
            
            try {
                const response = await fastFetch(`/api/code/${code}/hwid/${hwid}`, { method: 'DELETE' });
                const result = await response.json();
                if (result.success) {
                    showMessage(`✅ ${result.message}`, 'success');
                    hwidDetailsCache = {};
                    await loadHwidDetails();
                    await loadAll();
                } else {
                    showMessage('❌ ' + (result.error || 'Failed to remove HWID'), 'error');
                    document.querySelectorAll('.btn-remove-hwid').forEach(btn => {
                        btn.disabled = false;
                        btn.textContent = '🗑️ Remove';
                    });
                }
            } catch (error) {
                showMessage('❌ Error: ' + error.message, 'error');
                document.querySelectorAll('.btn-remove-hwid').forEach(btn => {
                    btn.disabled = false;
                    btn.textContent = '🗑️ Remove';
                });
            }
        }

        async function updateHwidLimit() {
            const code = document.getElementById('hwid-code-select').value;
            const limit = parseInt(document.getElementById('hwid-limit-input').value);
            
            if (!code) {
                showMessage('❌ Please select a code first', 'error');
                return;
            }
            if (!limit || limit < 1 || limit > 10) {
                showMessage('❌ Limit must be between 1 and 10', 'error');
                return;
            }
            
            try {
                const response = await fastFetch(`/api/code/${code}/hwid-limit`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ limit })
                });
                const result = await response.json();
                if (result.success) {
                    showMessage(`✅ ${result.message}`, 'success');
                    hwidDetailsCache = {};
                    loadHwidDetails();
                    await loadAll();
                } else {
                    showMessage('❌ ' + (result.error || 'Failed to update limit'), 'error');
                }
            } catch (error) {
                showMessage('❌ Error: ' + error.message, 'error');
            }
        }

        // ============================================
        // FORMAT HARDWARE FOR DISPLAY (Device, Profile, Owner only)
        // ============================================
        function formatHardwareForDisplay(hardware) {
            if (!hardware) return 'No hardware specs';
            const parts = [];
            const cpu = hardware.cpu_name || hardware.cpu;
            const gpu = hardware.gpu_name || hardware.gpu;
            const ram = hardware.ram_total_gb || hardware.ram_gb;
            const storage = hardware.storage_total_gb || hardware.storage_gb;
            const device = hardware.device_name || hardware.device;
            const profile = hardware.profile_name || hardware.profile;
            const owner = hardware.registered_owner || hardware.owner;
            if (cpu && cpu !== 'Unknown' && cpu !== 'N/A') parts.push('🖥️ ' + cpu);
            if (gpu && gpu !== 'Unknown' && gpu !== 'N/A') parts.push('🎮 ' + gpu);
            if (ram && Number(ram) > 0) parts.push('💾 ' + ram + 'GB RAM');
            if (storage && Number(storage) > 0) parts.push('📀 ' + storage + 'GB');
            if (device && device !== 'Unknown' && device !== 'N/A' && device !== '') parts.push('💻 ' + device);
            if (profile && profile !== 'Default' && profile !== 'Unknown' && profile !== 'N/A') parts.push('👤 ' + profile);
            if (owner && owner !== 'Unknown' && owner !== 'N/A' && owner !== '') parts.push('👔 ' + owner);
            return parts.length > 0 ? parts.join(' | ') : 'No hardware specs';
        }

        // ============================================
        // AUTO-DEACTIVATED CODES FUNCTIONS
        // ============================================

        async function loadAutoDeactivatedCodes() {
            const tbody = document.getElementById('auto-deactivated-body');
            if (!tbody) return;
            
            // Check if we already have data and it's not empty
            if (autoDeactivatedCodes.length > 0 && !isLoading) {
                renderAutoDeactivatedCodes(autoDeactivatedCodes);
                return;
            }
            
            tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;color:#888;padding:20px;"><div class="loading-text"><span class="spinner"></span> Loading auto-deactivated codes...</div></td></tr>';
            
            try {
                const response = await fastFetch('/api/auto-deactivated-codes');
                const data = await response.json();
                
                if (data.success) {
                    autoDeactivatedCodes = data.codes || [];
                    const countEl = document.getElementById('auto-deactivated-count');
                    if (countEl) {
                        countEl.textContent = autoDeactivatedCodes.length + ' codes';
                        countEl.className = 'badge badge-new-count' + (autoDeactivatedCodes.length === 0 ? ' zero' : '');
                    }
                    
                    if (autoDeactivatedCodes.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;color:#4CAF50;padding:30px;">✅ No auto-deactivated codes found</td></tr>';
                    } else {
                        renderAutoDeactivatedCodes(autoDeactivatedCodes);
                    }
                } else {
                    tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;color:#f44336;padding:20px;">' + (data.error || 'Failed to load data') + '</td></tr>';
                }
            } catch (error) {
                console.error('Load auto-deactivated codes error:', error);
                tbody.innerHTML = `<tr><td colspan="7" style="text-align:center;color:#f44336;padding:20px;">Error: ${error.message}</td></tr>`;
            }
        }

        function renderAutoDeactivatedCodes(codes) {
            const tbody = document.getElementById('auto-deactivated-body');
            if (!tbody) return;
            
            if (!codes || codes.length === 0) {
                tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;color:#4CAF50;padding:30px;">✅ No auto-deactivated codes found</td></tr>';
                return;
            }
            
            tbody.innerHTML = codes.map((code, index) => {
                const hwids = (code.existing_hwids && code.existing_hwids.length) ? code.existing_hwids : (code.hwids || []);
                const limit = code.max_hwid_limit || 1;
                const triggeredAt = code.triggered_at ? new Date(code.triggered_at).toLocaleString() : 'Unknown';
                
                // Find the HWID that triggered the deactivation
                let newHwid = code.trigger_hwid || null;
                let newHwidHardware = code.trigger_hardware || code.trigger_hwid_specs || null;
                
                // If trigger_hardware is null, try to get from trigger_log
                if (!newHwidHardware && code.trigger_log) {
                    const details = code.trigger_log.details || '';
                    const deviceMatch = details.match(/Device:\s*([^,|]+)/i);
                    const profileMatch = details.match(/Profile:\s*([^,|]+)/i);
                    const ownerMatch = details.match(/Owner:\s*([^,|]+)/i);
                    
                    newHwidHardware = {};
                    if (deviceMatch) newHwidHardware.device_name = deviceMatch[1].trim();
                    if (profileMatch) newHwidHardware.profile_name = profileMatch[1].trim();
                    if (ownerMatch) newHwidHardware.registered_owner = ownerMatch[1].trim();
                    
                    if (Object.keys(newHwidHardware).length === 0) newHwidHardware = null;
                }
                
                // If still no hardware and we have a newHwid, try to find in hwids list
                if (!newHwidHardware && newHwid) {
                    for (const h of hwids) {
                        if (h.hwid === newHwid && h.hardware) {
                            newHwidHardware = h.hardware;
                            break;
                        }
                    }
                }
                
                // If still no new HWID, use first HWID if available
                if (!newHwid && hwids.length > 0) {
                    newHwid = hwids[0].hwid;
                    newHwidHardware = hwids[0].hardware;
                }
                
                // Find existing HWIDs (all except the new one)
                const existingHwids = hwids.filter(h => h.hwid !== newHwid);
                
                // Format HWID display
                const formatHwid = (hwid) => {
                    if (!hwid) return 'N/A';
                    return hwid.substring(0, 16) + '...' + hwid.substring(48);
                };
                
                // Build HWID list HTML for existing HWIDs - with Device, Profile, Owner only
                const buildExistingHwidList = (hwidList) => {
                    if (!hwidList || hwidList.length === 0) {
                        return '<span style="color:#888;">No existing HWIDs</span>';
                    }
                    return hwidList.map(h => {
                        const hwidDisplay = formatHwid(h.hwid);
                        const hardwareStr = formatHardwareForDisplay(h.hardware);
                        return `
                            <div style="border-left:3px solid #4CAF50;background:rgba(76,175,80,0.05);padding:6px 10px;margin-bottom:4px;border-radius:4px;font-size:11px;">
                                <code style="color:#4CAF50;font-weight:bold;">${hwidDisplay}</code>
                                ${hardwareStr !== 'No hardware specs' ? `<span style="color:#aaa;font-size:10px;margin-left:8px;">${hardwareStr}</span>` : ''}
                            </div>
                        `;
                    }).join('');
                };
                
                // New HWID display - with Device, Profile, Owner only
                const newHwidHtml = newHwid ? 
                    `<div style="border-left:3px solid #FF9800;background:rgba(255,152,0,0.08);padding:6px 10px;border-radius:4px;font-size:11px;">
                        <code style="color:#FF9800;font-weight:bold;">${formatHwid(newHwid)}</code>
                        ${newHwidHardware ? `<span style="color:#aaa;font-size:10px;margin-left:8px;">${formatHardwareForDisplay(newHwidHardware)}</span>` : ''}
                        <span style="color:#f44336;font-size:9px;font-weight:bold;margin-left:8px;">⚠️ TRIGGER</span>
                    </div>` :
                    '<span style="color:#888;">No new HWID detected</span>';
                
                const existingHwidsHtml = buildExistingHwidList(existingHwids);
                
                return `
                    <tr style="background:rgba(244,67,54,0.05);">
                        <td><strong class="code-font">${code.code}</strong></td>
                        <td>${code.username || '<span class="text-muted">N/A</span>'}</td>
                        <td style="font-size:12px;color:#FF9800;white-space:nowrap;">${triggeredAt}</td>
                        <td style="text-align:center;"><span style="color:#FF9800;font-weight:bold;">${limit}</span></td>
                        <td>${newHwidHtml}</td>
                        <td style="max-width:350px;">${existingHwidsHtml}</td>
                        <td>
                            <div class="action-buttons">
                                <button onclick="viewAutoDeactivatedDetail('${code.code}')" class="btn-small btn-info" style="background:#2196F3;color:#fff;">📋 Details</button>
                                <button onclick="reactivateAutoDeactivated('${code.code}')" class="btn-small btn-success">🔓 Reactivate</button>
                                <button onclick="deleteAutoDeactivatedLogs('${code.code}')" class="btn-small btn-delete-logs" style="background:#FF9800;color:#fff;">🗑️ Delete Logs</button>
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        // ============================================
        // DELETE AUTO-DEACTIVATED CODE LOGS AND REMOVE FROM AUTO-DEACTIVATED LIST
        // ============================================

        async function deleteAutoDeactivatedLogs(code) {
            if (!confirm(`🗑️ Delete ALL logs for auto-deactivated code ${code}?\n\nThis will:\n- Delete all HWID logs\n- Remove this code from Auto-Deactivated list\n- The code will remain in All Codes tab as inactive\n\nContinue?`)) {
                return;
            }
            
            try {
                showMessage('⏳ Deleting logs and removing from list...', 'loading');
                const response = await fastFetch(`/api/auto-deactivated-code/${code}/logs`, {
                    method: 'DELETE'
                });
                const result = await response.json();
                
                if (result.success) {
                    showMessage(`✅ ${result.message} (${result.deleted} entries deleted)`, 'success');
                    
                    // REMOVE THE CODE FROM THE LOCAL autoDeactivatedCodes ARRAY
                    autoDeactivatedCodes = autoDeactivatedCodes.filter(c => c.code !== code);
                    
                    // UPDATE THE TABLE DIRECTLY
                    if (autoDeactivatedCodes.length === 0) {
                        document.getElementById('auto-deactivated-body').innerHTML = 
                            '<tr><td colspan="7" style="text-align:center;color:#4CAF50;padding:30px;">✅ No auto-deactivated codes found</td></tr>';
                    } else {
                        renderAutoDeactivatedCodes(autoDeactivatedCodes);
                    }
                    
                    // UPDATE THE COUNT
                    const countEl = document.getElementById('auto-deactivated-count');
                    if (countEl) {
                        countEl.textContent = autoDeactivatedCodes.length + ' codes';
                        countEl.className = 'badge badge-new-count' + (autoDeactivatedCodes.length === 0 ? ' zero' : '');
                    }
                    
                    // Also reload all data to sync
                    await loadAll();
                    
                } else {
                    showMessage('❌ ' + (result.error || 'Failed to delete logs'), 'error');
                }
            } catch (error) {
                showMessage('❌ Error: ' + error.message, 'error');
            }
        }

        async function viewAutoDeactivatedDetail(code) {
            try {
                const response = await fastFetch(`/api/auto-deactivated-code/${code}`);
                const data = await response.json();
                
                if (!data.success) {
                    showMessage('❌ ' + (data.error || 'Failed to load details'), 'error');
                    return;
                }
                
                detailCodeData = data.code;
                const c = data.code;
                
                document.getElementById('detail-code').textContent = c.code;
                document.getElementById('detail-username').textContent = c.username || 'N/A';
                document.getElementById('detail-access').textContent = c.access_level || 'VIP';
                document.getElementById('detail-subscription').textContent = c.subscription_type || 'Lifetime';
                document.getElementById('detail-status').textContent = c.status || 'auto_deactivated';
                document.getElementById('detail-limit').textContent = c.max_hwid_limit || 1;
                document.getElementById('detail-count').textContent = c.hwid_count || 0;
                document.getElementById('detail-created').textContent = c.created_at ? new Date(c.created_at).toLocaleString() : 'N/A';
                const trigEl = document.getElementById('detail-triggered');
                if (trigEl) trigEl.textContent = c.triggered_at ? new Date(c.triggered_at).toLocaleString() : 'Unknown';
                const reasonEl = document.getElementById('detail-reason');
                if (reasonEl) reasonEl.textContent = c.trigger_reason || c.status || 'N/A';
                document.getElementById('detail-expires').textContent = c.expires_at ? new Date(c.expires_at).toLocaleString() : 'Never';
                
                // Find new HWID - use trigger_hardware from server
                const hwids = (c.existing_hwids && c.existing_hwids.length) ? c.existing_hwids : (c.hwids || []);
                let newHwid = c.trigger_hwid || null;
                let newHwidHardware = c.trigger_hardware || c.trigger_hwid_specs || null;
                
                // If trigger_hardware is null, try to extract from trigger_log
                if (!newHwidHardware && c.trigger_log) {
                    const details = c.trigger_log.details || '';
                    const deviceMatch = details.match(/Device:\s*([^,|]+)/i);
                    const profileMatch = details.match(/Profile:\s*([^,|]+)/i);
                    const ownerMatch = details.match(/Owner:\s*([^,|]+)/i);
                    
                    newHwidHardware = {};
                    if (deviceMatch) newHwidHardware.device_name = deviceMatch[1].trim();
                    if (profileMatch) newHwidHardware.profile_name = profileMatch[1].trim();
                    if (ownerMatch) newHwidHardware.registered_owner = ownerMatch[1].trim();
                    
                    if (Object.keys(newHwidHardware).length === 0) newHwidHardware = null;
                }
                
                if (!newHwid && hwids.length > 0) {
                    newHwid = hwids[0].hwid;
                    newHwidHardware = hwids[0].hardware;
                }
                
                // Format hardware for display - Device, Profile, Owner only
                const formatHardwareDisplay = (hardware) => {
                    if (!hardware) return 'No hardware specs available';
                    const parts = [];
                    const cpu = hardware.cpu_name || hardware.cpu;
                    const gpu = hardware.gpu_name || hardware.gpu;
                    const ram = hardware.ram_total_gb || hardware.ram_gb;
                    const storage = hardware.storage_total_gb || hardware.storage_gb;
                    const device = hardware.device_name || hardware.device;
                    const profile = hardware.profile_name || hardware.profile;
                    const owner = hardware.registered_owner || hardware.owner;
                    if (cpu && cpu !== 'Unknown' && cpu !== 'N/A') parts.push('🖥️ CPU: ' + cpu);
                    if (gpu && gpu !== 'Unknown' && gpu !== 'N/A') parts.push('🎮 GPU: ' + gpu);
                    if (ram && Number(ram) > 0) parts.push('💾 RAM: ' + ram + ' GB');
                    if (storage && Number(storage) > 0) parts.push('📀 Storage: ' + storage + ' GB');
                    if (device && device !== 'Unknown' && device !== 'N/A' && device !== '') parts.push('💻 Device: ' + device);
                    if (profile && profile !== 'Default' && profile !== 'Unknown' && profile !== 'N/A') parts.push('👤 Profile: ' + profile);
                    if (owner && owner !== 'Unknown' && owner !== 'N/A' && owner !== '') parts.push('👔 Owner: ' + owner);
                    return parts.length > 0 ? parts.join('<br>') : 'No hardware specs available';
                };
                
                // Render new HWID
                const newHwidDiv = document.getElementById('detail-new-hwid');
                if (newHwid) {
                    newHwidDiv.innerHTML = `
                        <div style="border-left:3px solid #FF9800;padding:10px;background:rgba(255,152,0,0.05);border-radius:4px;">
                            <code style="color:#FF9800;font-weight:bold;word-break:break-all;">${newHwid}</code>
                            <div style="color:#aaa;font-size:12px;margin-top:8px;line-height:1.6;">
                                ${formatHardwareDisplay(newHwidHardware)}
                            </div>
                            <span style="color:#f44336;font-size:12px;font-weight:bold;display:block;margin-top:8px;">⚠️ This HWID triggered the deactivation</span>
                        </div>
                    `;
                } else {
                    newHwidDiv.innerHTML = '<p style="color:#888;">No new HWID detected</p>';
                }
                
                // Render existing HWIDs
                const existingHwids = hwids.filter(h => h.hwid !== newHwid);
                const existingDiv = document.getElementById('detail-existing-hwids');
                if (existingHwids.length > 0) {
                    existingDiv.innerHTML = existingHwids.map(h => {
                        return `
                            <div style="border-left:3px solid #4CAF50;padding:10px;background:rgba(76,175,80,0.05);border-radius:4px;margin-bottom:8px;">
                                <code style="color:#4CAF50;font-weight:bold;word-break:break-all;">${h.hwid}</code>
                                <div style="color:#aaa;font-size:12px;margin-top:8px;line-height:1.6;">
                                    ${formatHardwareDisplay(h.hardware)}
                                </div>
                                <div style="color:#888;font-size:11px;margin-top:4px;">Assigned: ${h.assigned_at ? new Date(h.assigned_at).toLocaleString() : 'N/A'}</div>
                            </div>
                        `;
                    }).join('');
                } else {
                    existingDiv.innerHTML = '<p style="color:#888;">No existing HWIDs found</p>';
                }
                
                document.getElementById('auto-deactivated-detail').style.display = 'block';
                document.body.style.overflow = 'hidden';
                
            } catch (error) {
                showMessage('❌ Error loading details: ' + error.message, 'error');
            }
        }

        function closeDetail() {
            document.getElementById('auto-deactivated-detail').style.display = 'none';
            document.body.style.overflow = 'auto';
            detailCodeData = null;
        }

        async function reactivateFromDetail() {
            if (detailCodeData) {
                await reactivateAutoDeactivated(detailCodeData.code);
                closeDetail();
            }
        }

        async function reactivateAutoDeactivated(code) {
            if (!confirm(`🔓 Reactivate code ${code}?\n\nThis will remove all existing HWIDs and allow the user to register again.\n\nThe user will need to run the Python software again.`)) {
                return;
            }
            
            try {
                const response = await fastFetch(`/api/code/${code}/reactivate`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ subscriptionType: 'Lifetime' })
                });
                const result = await response.json();
                if (result.success) {
                    showMessage(`✅ Code ${code} reactivated! ${result.hwids_removed || 0} HWID(s) removed.`, 'success');
                    hwidDetailsCache = {};
                    await loadAll();
                    await loadAutoDeactivatedCodes();
                } else {
                    showMessage('❌ ' + (result.error || 'Failed to reactivate'), 'error');
                }
            } catch (error) {
                showMessage('❌ Error: ' + error.message, 'error');
            }
        }

        // ============================================
        // INIT
        // ============================================
        document.addEventListener('DOMContentLoaded', function() {
            loadAll();
            
            setInterval(function() {
                if (!isLoading) {
                    loadAll();
                }
            }, 20000);
            
            setInterval(function() {
                hwidDetailsCache = {};
            }, 120000);
        });
        
        document.addEventListener('visibilitychange', function() {
            if (!document.hidden && !isLoading) {
                loadAll();
            }
        });
    </script>
</body>
</html>