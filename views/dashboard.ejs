<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Approval Server Dashboard</title>
    <style>
        /* ============================================================
           RESET & BASE
           ============================================================ */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #0b0e14;
            color: #e8edf5;
            padding: 20px;
            min-height: 100vh;
        }

        a {
            color: #58a6ff;
            text-decoration: none;
        }
        a:hover {
            text-decoration: underline;
        }

        /* ============================================================
           LAYOUT
           ============================================================ */
        .container {
            max-width: 1600px;
            margin: 0 auto;
        }

        /* ============================================================
           HEADER
           ============================================================ */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
            margin-bottom: 28px;
            padding-bottom: 16px;
            border-bottom: 1px solid #1f2937;
        }

        .header-left h1 {
            font-size: 26px;
            font-weight: 700;
            background: linear-gradient(135deg, #58a6ff, #a78bfa);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .header-left .sub {
            font-size: 14px;
            color: #8b95a9;
            margin-top: 2px;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
        }

        .header-right .user-badge {
            background: #1f2937;
            padding: 6px 16px;
            border-radius: 40px;
            font-size: 14px;
            color: #c9d1d9;
        }

        .header-right .user-badge strong {
            color: #58a6ff;
        }

        .header-right .btn-outline {
            background: transparent;
            border: 1px solid #30363d;
            color: #c9d1d9;
            padding: 6px 18px;
            border-radius: 40px;
            font-size: 14px;
            cursor: pointer;
            transition: 0.2s;
        }
        .header-right .btn-outline:hover {
            border-color: #58a6ff;
            color: #58a6ff;
        }

        /* ============================================================
           STATUS BAR (Auto-Refresh Indicator)
           ============================================================ */
        .status-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            background: #141a23;
            border-radius: 12px;
            padding: 12px 20px;
            margin-bottom: 28px;
            border: 1px solid #1f2937;
        }

        .status-bar .left {
            display: flex;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            font-weight: 600;
            padding: 4px 14px;
            border-radius: 40px;
        }
        .status-badge.online {
            background: #0d2818;
            color: #4ade80;
        }
        .status-badge.online::before {
            content: '';
            display: inline-block;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #4ade80;
            animation: pulse-dot 1.8s ease-in-out infinite;
        }

        @keyframes pulse-dot {
            0%,
            100% {
                opacity: 1;
                transform: scale(1);
            }
            50% {
                opacity: 0.5;
                transform: scale(0.85);
            }
        }

        .status-bar .timestamp {
            font-size: 13px;
            color: #8b95a9;
        }

        .status-bar .refresh-info {
            font-size: 13px;
            color: #8b95a9;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .status-bar .refresh-info .spinner {
            display: inline-block;
            width: 16px;
            height: 16px;
            border: 2px solid #1f2937;
            border-top: 2px solid #58a6ff;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        .btn-refresh {
            background: #1f2937;
            border: none;
            color: #c9d1d9;
            padding: 6px 18px;
            border-radius: 40px;
            font-size: 13px;
            cursor: pointer;
            transition: 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .btn-refresh:hover {
            background: #2d3748;
            color: #fff;
        }
        .btn-refresh:active {
            transform: scale(0.96);
        }

        /* ============================================================
           STAT CARDS
           ============================================================ */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 16px;
            margin-bottom: 28px;
        }

        .stat-card {
            background: #141a23;
            border-radius: 12px;
            padding: 18px 16px;
            border: 1px solid #1f2937;
            transition: 0.2s;
        }
        .stat-card:hover {
            border-color: #30363d;
        }

        .stat-card .label {
            font-size: 13px;
            color: #8b95a9;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .stat-card .value {
            font-size: 28px;
            font-weight: 700;
            margin-top: 4px;
            color: #e8edf5;
        }
        .stat-card .value.green {
            color: #4ade80;
        }
        .stat-card .value.blue {
            color: #58a6ff;
        }
        .stat-card .value.purple {
            color: #a78bfa;
        }
        .stat-card .value.orange {
            color: #fbbf24;
        }
        .stat-card .value.red {
            color: #f87171;
        }
        .stat-card .value.pink {
            color: #f472b6;
        }
        .stat-card .value.cyan {
            color: #22d3ee;
        }

        /* ============================================================
           TABLES
           ============================================================ */
        .section {
            background: #141a23;
            border-radius: 12px;
            border: 1px solid #1f2937;
            margin-bottom: 28px;
            overflow: hidden;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px 20px;
            border-bottom: 1px solid #1f2937;
            flex-wrap: wrap;
            gap: 12px;
        }

        .section-header h2 {
            font-size: 18px;
            font-weight: 600;
        }

        .section-header .count-badge {
            background: #1f2937;
            padding: 2px 14px;
            border-radius: 40px;
            font-size: 13px;
            color: #8b95a9;
        }

        .table-wrap {
            overflow-x: auto;
            padding: 0 4px 4px 4px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
        }

        thead {
            background: #0f151e;
        }

        th {
            text-align: left;
            padding: 12px 16px;
            font-weight: 600;
            color: #8b95a9;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            border-bottom: 1px solid #1f2937;
            white-space: nowrap;
        }

        td {
            padding: 12px 16px;
            border-bottom: 1px solid #1a222e;
            vertical-align: middle;
            word-break: break-word;
        }

        tr:hover td {
            background: #1a222e;
        }

        /* status tags */
        .tag {
            display: inline-block;
            padding: 2px 12px;
            border-radius: 40px;
            font-size: 12px;
            font-weight: 600;
        }
        .tag.approved {
            background: #0d2818;
            color: #4ade80;
        }
        .tag.revoked {
            background: #2a0f14;
            color: #f87171;
        }
        .tag.pending {
            background: #1e1b0b;
            color: #fbbf24;
        }
        .tag.inactive {
            background: #1f1a2e;
            color: #a78bfa;
        }
        .tag.active {
            background: #0d2818;
            color: #4ade80;
        }
        .tag.expired {
            background: #2a0f14;
            color: #f87171;
        }
        .tag.auto_deactivated {
            background: #2a0f14;
            color: #f87171;
        }
        .tag.auto_deactivated_limit_exceeded {
            background: #2a0f14;
            color: #f87171;
        }
        .tag.auto_deactivated_multiple_hwids {
            background: #2a0f14;
            color: #f87171;
        }
        .tag.auto_deactivated_unauthorized {
            background: #2a0f14;
            color: #f87171;
        }
        .tag.code_inactive {
            background: #1f1a2e;
            color: #a78bfa;
        }
        .tag.not_found {
            background: #1f2937;
            color: #8b95a9;
        }

        .text-muted {
            color: #8b95a9;
            font-size: 13px;
        }

        .text-truncate {
            max-width: 180px;
            display: inline-block;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        /* ============================================================
           BUTTONS
           ============================================================ */
        .btn-sm {
            padding: 4px 12px;
            border-radius: 6px;
            font-size: 12px;
            border: none;
            cursor: pointer;
            transition: 0.2s;
        }
        .btn-sm.danger {
            background: #7f1d1d;
            color: #fca5a5;
        }
        .btn-sm.danger:hover {
            background: #991b1b;
        }
        .btn-sm.primary {
            background: #1e3a5f;
            color: #93c5fd;
        }
        .btn-sm.primary:hover {
            background: #1e40af;
        }
        .btn-sm.success {
            background: #14532d;
            color: #86efac;
        }
        .btn-sm.success:hover {
            background: #166534;
        }
        .btn-sm.warning {
            background: #78350f;
            color: #fcd34d;
        }
        .btn-sm.warning:hover {
            background: #92400e;
        }

        /* ============================================================
           RESPONSIVE
           ============================================================ */
        @media (max-width: 640px) {
            .header {
                flex-direction: column;
                align-items: stretch;
            }
            .header-right {
                justify-content: flex-start;
            }
            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .stat-card .value {
                font-size: 22px;
            }
            .status-bar {
                flex-direction: column;
                align-items: stretch;
            }
            .status-bar .left {
                flex-wrap: wrap;
            }
        }

        @media (max-width: 480px) {
            .stats-grid {
                grid-template-columns: 1fr 1fr;
                gap: 10px;
            }
            .stat-card {
                padding: 12px;
            }
            .stat-card .value {
                font-size: 20px;
            }
        }

        /* ============================================================
           SCROLLBAR
           ============================================================ */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #0b0e14;
        }
        ::-webkit-scrollbar-thumb {
            background: #2d3748;
            border-radius: 8px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #4a5568;
        }

        /* ============================================================
           EMPTY STATE
           ============================================================ */
        .empty-state {
            text-align: center;
            padding: 40px 20px;
            color: #8b95a9;
        }
        .empty-state .icon {
            font-size: 48px;
            margin-bottom: 12px;
        }
        .empty-state h3 {
            font-size: 18px;
            color: #c9d1d9;
            margin-bottom: 4px;
        }
    </style>
</head>

<body>
    <div class="container">

        <!-- ============================================================
        HEADER
        ============================================================ -->
        <header class="header">
            <div class="header-left">
                <h1>📊 Approval Server</h1>
                <div class="sub">Real-time dashboard &bull; <span id="connection-status">connected</span></div>
            </div>
            <div class="header-right">
                <span class="user-badge">👤 <strong><%= username || 'Admin' %></strong></span>
                <a href="/logout" class="btn-outline">Logout</a>
            </div>
        </header>

        <!-- ============================================================
        STATUS BAR
        ============================================================ -->
        <div class="status-bar">
            <div class="left">
                <span class="status-badge online">Live</span>
                <span class="timestamp" id="last-update">
                    Last updated: <%= new Date().toLocaleString() %>
                </span>
                <span class="refresh-info" id="refresh-info">
                    <span class="spinner" id="refresh-spinner"></span>
                    Auto-refresh every <strong id="refresh-interval-display">5</strong>s
                </span>
            </div>
            <div>
                <button class="btn-refresh" id="manual-refresh-btn">
                    🔄 Refresh now
                </button>
            </div>
        </div>

        <!-- ============================================================
        STATS GRID
        ============================================================ -->
        <section class="stats-grid">
            <div class="stat-card">
                <div class="label">Total Devices</div>
                <div class="value blue" data-stat="total"><%= stats.total || 0 %></div>
            </div>
            <div class="stat-card">
                <div class="label">Approved</div>
                <div class="value green" data-stat="approved"><%= stats.approved || 0 %></div>
            </div>
            <div class="stat-card">
                <div class="label">Revoked</div>
                <div class="value red" data-stat="revoked"><%= stats.revoked || 0 %></div>
            </div>
            <div class="stat-card">
                <div class="label">Total Pings</div>
                <div class="value cyan" data-stat="totalPings"><%= stats.totalPings || 0 %></div>
            </div>
            <div class="stat-card">
                <div class="label">Total Codes</div>
                <div class="value purple" data-stat="totalCodes"><%= stats.totalCodes || 0 %></div>
            </div>
            <div class="stat-card">
                <div class="label">Active Codes</div>
                <div class="value green" data-stat="activeCodes"><%= stats.activeCodes || 0 %></div>
            </div>
            <div class="stat-card">
                <div class="label">Pending Requests</div>
                <div class="value orange" data-stat="pendingRequests"><%= stats.pendingRequests || 0 %></div>
            </div>
            <div class="stat-card">
                <div class="label">Cache Age</div>
                <div class="value pink" id="cache-age"><%= (stats.cache_age !== undefined ? stats.cache_age : 0) %>s</div>
            </div>
        </section>

        <!-- ============================================================
        DEVICES TABLE
        ============================================================ -->
        <section class="section">
            <div class="section-header">
                <h2>📱 Devices <span class="count-badge" id="device-count"><%= devices ? devices.length : 0 %></span></h2>
                <div style="display:flex;gap:8px;flex-wrap:wrap;">
                    <button class="btn-sm danger" id="delete-all-devices-btn">🗑 Delete All</button>
                </div>
            </div>
            <div class="table-wrap">
                <table id="devices-table">
                    <thead>
                        <tr>
                            <th>Device ID</th>
                            <th>Code</th>
                            <th>Status</th>
                            <th>Profile</th>
                            <th>Device Name</th>
                            <th>CPU</th>
                            <th>GPU</th>
                            <th>RAM</th>
                            <th>Last Ping</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (devices && devices.length) { %>
                            <% devices.forEach(function(device) { %>
                                <tr>
                                    <td><span class="text-truncate" title="<%= device.device_id %>"><%= device.device_id %></span></td>
                                    <td><%= device.code || '—' %></td>
                                    <td><span class="tag <%= device.status %>"><%= device.status %></span></td>
                                    <td><%= device.profile_name || '—' %></td>
                                    <td><%= device.device_name || '—' %></td>
                                    <td><%= device.cpu_name || '—' %></td>
                                    <td><%= device.gpu_name || '—' %></td>
                                    <td><%= device.ram_total_gb || 0 %> GB</td>
                                    <td><%= device.last_ping ? new Date(device.last_ping).toLocaleString() : 'Never' %></td>
                                    <td>
                                        <button class="btn-sm danger revoke-btn" data-device="<%= device.device_id %>">Revoke</button>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="10">
                                    <div class="empty-state">
                                        <div class="icon">📭</div>
                                        <h3>No devices found</h3>
                                        <p>Devices will appear here once they register.</p>
                                    </div>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- ============================================================
        CODES TABLE
        ============================================================ -->
        <section class="section">
            <div class="section-header">
                <h2>🔑 Codes <span class="count-badge" id="code-count"><%= codes ? codes.length : 0 %></span></h2>
                <div style="display:flex;gap:8px;flex-wrap:wrap;">
                    <button class="btn-sm primary" id="generate-code-btn">+ Generate Code</button>
                    <button class="btn-sm danger" id="delete-all-codes-btn">🗑 Delete All</button>
                </div>
            </div>
            <div class="table-wrap">
                <table id="codes-table">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Username</th>
                            <th>Access</th>
                            <th>Subscription</th>
                            <th>Status</th>
                            <th>Active</th>
                            <th>HWID Limit</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (codes && codes.length) { %>
                            <% codes.forEach(function(code) { %>
                                <tr>
                                    <td><strong><%= code.code %></strong></td>
                                    <td><%= code.username || '—' %></td>
                                    <td><%= code.access_level || '—' %></td>
                                    <td><%= code.subscription_type || '—' %></td>
                                    <td><span class="tag <%= code.status %>"><%= code.status %></span></td>
                                    <td><%= code.is_active ? '✅' : '❌' %></td>
                                    <td><%= code.max_hwid_limit || 1 %></td>
                                    <td><%= code.created_at ? new Date(code.created_at).toLocaleDateString() : '—' %></td>
                                    <td style="display:flex;gap:4px;flex-wrap:wrap;">
                                        <button class="btn-sm danger deactivate-code-btn" data-code="<%= code.code %>">Deactivate</button>
                                        <button class="btn-sm success reactivate-code-btn" data-code="<%= code.code %>">Reactivate</button>
                                        <button class="btn-sm warning hwid-btn" data-code="<%= code.code %>">HWIDs</button>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="9">
                                    <div class="empty-state">
                                        <div class="icon">🔑</div>
                                        <h3>No codes found</h3>
                                        <p>Generate a code to get started.</p>
                                    </div>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- ============================================================
        REQUESTS TABLE
        ============================================================ -->
        <section class="section">
            <div class="section-header">
                <h2>📋 Pending Requests <span class="count-badge" id="request-count"><%= requests ? requests.length : 0 %></span></h2>
                <div style="display:flex;gap:8px;flex-wrap:wrap;">
                    <button class="btn-sm danger" id="delete-all-requests-btn">🗑 Delete All</button>
                </div>
            </div>
            <div class="table-wrap">
                <table id="requests-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Device</th>
                            <th>Code</th>
                            <th>Reason</th>
                            <th>Status</th>
                            <th>Requested</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (requests && requests.length) { %>
                            <% requests.forEach(function(req) { %>
                                <tr>
                                    <td><%= req.id %></td>
                                    <td><span class="text-truncate" title="<%= req.device_id %>"><%= req.device_id %></span></td>
                                    <td><%= req.code || '—' %></td>
                                    <td><%= req.reason || '—' %></td>
                                    <td><span class="tag pending"><%= req.status %></span></td>
                                    <td><%= req.requested_at ? new Date(req.requested_at).toLocaleString() : '—' %></td>
                                    <td style="display:flex;gap:4px;flex-wrap:wrap;">
                                        <button class="btn-sm success approve-request-btn" data-id="<%= req.id %>">Approve</button>
                                        <button class="btn-sm danger reject-request-btn" data-id="<%= req.id %>">Reject</button>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="7">
                                    <div class="empty-state">
                                        <div class="icon">📭</div>
                                        <h3>No pending requests</h3>
                                        <p>All requests have been handled.</p>
                                    </div>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- ============================================================
        GENERATE CODE MODAL
        ============================================================ -->
        <div id="generate-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:999;align-items:center;justify-content:center;">
            <div style="background:#141a23;border-radius:16px;padding:32px;max-width:420px;width:90%;border:1px solid #1f2937;">
                <h2 style="margin-bottom:8px;">Generate Code</h2>
                <p style="color:#8b95a9;margin-bottom:20px;font-size:14px;">Create a new activation code for a user.</p>
                <form id="generate-form">
                    <div style="margin-bottom:12px;">
                        <label style="display:block;font-size:13px;color:#8b95a9;margin-bottom:4px;">Username *</label>
                        <input type="text" id="gen-username" placeholder="e.g. johndoe" required style="width:100%;padding:10px 14px;border-radius:8px;border:1px solid #1f2937;background:#0b0e14;color:#e8edf5;font-size:14px;">
                    </div>
                    <div style="margin-bottom:12px;">
                        <label style="display:block;font-size:13px;color:#8b95a9;margin-bottom:4px;">Access Level</label>
                        <select id="gen-access" style="width:100%;padding:10px 14px;border-radius:8px;border:1px solid #1f2937;background:#0b0e14;color:#e8edf5;font-size:14px;">
                            <option value="VIP">VIP</option>
                            <option value="SVIP">SVIP</option>
                        </select>
                    </div>
                    <div style="margin-bottom:20px;">
                        <label style="display:block;font-size:13px;color:#8b95a9;margin-bottom:4px;">Subscription</label>
                        <select id="gen-subscription" style="width:100%;padding:10px 14px;border-radius:8px;border:1px solid #1f2937;background:#0b0e14;color:#e8edf5;font-size:14px;">
                            <option value="Lifetime">Lifetime</option>
                            <option value="3 Months">3 Months</option>
                            <option value="6 Months">6 Months</option>
                            <option value="9 Months">9 Months</option>
                            <option value="12 Months">12 Months</option>
                        </select>
                    </div>
                    <div style="display:flex;gap:12px;justify-content:flex-end;">
                        <button type="button" id="modal-close" style="padding:10px 20px;border-radius:8px;border:1px solid #1f2937;background:transparent;color:#c9d1d9;cursor:pointer;">Cancel</button>
                        <button type="submit" style="padding:10px 24px;border-radius:8px;border:none;background:#1e3a5f;color:#93c5fd;font-weight:600;cursor:pointer;">Generate</button>
                    </div>
                </form>
                <div id="gen-result" style="margin-top:16px;font-size:14px;text-align:center;display:none;"></div>
            </div>
        </div>

        <!-- ============================================================
        HWID MODAL
        ============================================================ -->
        <div id="hwid-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:999;align-items:center;justify-content:center;">
            <div style="background:#141a23;border-radius:16px;padding:32px;max-width:700px;width:90%;max-height:80vh;overflow-y:auto;border:1px solid #1f2937;">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
                    <h2 id="hwid-modal-title">HWIDs for: <span id="hwid-code-display">—</span></h2>
                    <button id="hwid-modal-close" style="background:transparent;border:none;color:#8b95a9;font-size:24px;cursor:pointer;">&times;</button>
                </div>
                <div id="hwid-list">
                    <p style="color:#8b95a9;text-align:center;padding:20px;">Loading HWIDs...</p>
                </div>
                <div style="margin-top:16px;padding-top:16px;border-top:1px solid #1f2937;">
                    <h4 style="margin-bottom:8px;">Add HWID</h4>
                    <div style="display:flex;gap:8px;flex-wrap:wrap;">
                        <input type="text" id="hwid-add-input" placeholder="64-character HWID" style="flex:1;min-width:200px;padding:10px 14px;border-radius:8px;border:1px solid #1f2937;background:#0b0e14;color:#e8edf5;font-size:14px;font-family:monospace;">
                        <button id="hwid-add-btn" class="btn-sm primary" style="padding:10px 20px;">Add</button>
                    </div>
                    <div id="hwid-add-result" style="margin-top:8px;font-size:13px;display:none;"></div>
                </div>
            </div>
        </div>

    </div>

    <!-- ============================================================
    AUTO-REFRESH & DASHBOARD SCRIPT
    ============================================================ -->
    <script>
        (function() {
            'use strict';

            // ============================================================
            // CONFIG
            // ============================================================
            const REFRESH_INTERVAL = 5000; // 5 seconds
            let refreshTimer = null;
            let isRefreshing = false;
            let isFirstLoad = true;

            // ============================================================
            // DOM REFS
            // ============================================================
            const $ = (sel) => document.querySelector(sel);
            const $$ = (sel) => document.querySelectorAll(sel);

            const lastUpdateEl = $('#last-update');
            const cacheAgeEl = $('#cache-age');
            const refreshSpinner = $('#refresh-spinner');
            const refreshIntervalDisplay = $('#refresh-interval-display');
            const manualRefreshBtn = $('#manual-refresh-btn');

            // ============================================================
            // UPDATE DASHBOARD
            // ============================================================
            function updateDashboard(data) {
                // Update stats
                if (data.stats) {
                    document.querySelectorAll('[data-stat]').forEach(el => {
                        const key = el.dataset.stat;
                        if (data.stats[key] !== undefined) {
                            el.textContent = data.stats[key];
                        }
                    });
                }

                // Update cache age
                if (data.cache_age !== undefined) {
                    cacheAgeEl.textContent = data.cache_age + 's';
                }

                // Update counts
                const deviceCount = $('#device-count');
                if (deviceCount && data.devices) {
                    deviceCount.textContent = data.devices.length;
                }

                const codeCount = $('#code-count');
                if (codeCount && data.codes) {
                    codeCount.textContent = data.codes.length;
                }

                const requestCount = $('#request-count');
                if (requestCount && data.requests) {
                    requestCount.textContent = data.requests.length;
                }

                // Update devices table
                const devicesTbody = document.querySelector('#devices-table tbody');
                if (devicesTbody && data.devices) {
                    if (data.devices.length === 0) {
                        devicesTbody.innerHTML = `
                            <tr>
                                <td colspan="10">
                                    <div class="empty-state">
                                        <div class="icon">📭</div>
                                        <h3>No devices found</h3>
                                        <p>Devices will appear here once they register.</p>
                                    </div>
                                </td>
                            </tr>
                        `;
                    } else {
                        devicesTbody.innerHTML = data.devices.map(device => `
                            <tr>
                                <td><span class="text-truncate" title="${escapeHtml(device.device_id)}">${escapeHtml(device.device_id)}</span></td>
                                <td>${device.code || '—'}</td>
                                <td><span class="tag ${device.status}">${device.status}</span></td>
                                <td>${escapeHtml(device.profile_name || '—')}</td>
                                <td>${escapeHtml(device.device_name || '—')}</td>
                                <td>${escapeHtml(device.cpu_name || '—')}</td>
                                <td>${escapeHtml(device.gpu_name || '—')}</td>
                                <td>${device.ram_total_gb || 0} GB</td>
                                <td>${device.last_ping ? new Date(device.last_ping).toLocaleString() : 'Never'}</td>
                                <td>
                                    <button class="btn-sm danger revoke-btn" data-device="${escapeHtml(device.device_id)}">Revoke</button>
                                </td>
                            </tr>
                        `).join('');
                    }
                    // Re-bind revoke buttons
                    document.querySelectorAll('.revoke-btn').forEach(btn => {
                        btn.addEventListener('click', revokeDevice);
                    });
                }

                // Update codes table
                const codesTbody = document.querySelector('#codes-table tbody');
                if (codesTbody && data.codes) {
                    if (data.codes.length === 0) {
                        codesTbody.innerHTML = `
                            <tr>
                                <td colspan="9">
                                    <div class="empty-state">
                                        <div class="icon">🔑</div>
                                        <h3>No codes found</h3>
                                        <p>Generate a code to get started.</p>
                                    </div>
                                </td>
                            </tr>
                        `;
                    } else {
                        codesTbody.innerHTML = data.codes.map(code => `
                            <tr>
                                <td><strong>${escapeHtml(code.code)}</strong></td>
                                <td>${escapeHtml(code.username || '—')}</td>
                                <td>${escapeHtml(code.access_level || '—')}</td>
                                <td>${escapeHtml(code.subscription_type || '—')}</td>
                                <td><span class="tag ${code.status}">${code.status}</span></td>
                                <td>${code.is_active ? '✅' : '❌'}</td>
                                <td>${code.max_hwid_limit || 1}</td>
                                <td>${code.created_at ? new Date(code.created_at).toLocaleDateString() : '—'}</td>
                                <td style="display:flex;gap:4px;flex-wrap:wrap;">
                                    <button class="btn-sm danger deactivate-code-btn" data-code="${escapeHtml(code.code)}">Deactivate</button>
                                    <button class="btn-sm success reactivate-code-btn" data-code="${escapeHtml(code.code)}">Reactivate</button>
                                    <button class="btn-sm warning hwid-btn" data-code="${escapeHtml(code.code)}">HWIDs</button>
                                </td>
                            </tr>
                        `).join('');
                    }
                    // Re-bind code buttons
                    document.querySelectorAll('.deactivate-code-btn').forEach(btn => {
                        btn.addEventListener('click', deactivateCode);
                    });
                    document.querySelectorAll('.reactivate-code-btn').forEach(btn => {
                        btn.addEventListener('click', reactivateCode);
                    });
                    document.querySelectorAll('.hwid-btn').forEach(btn => {
                        btn.addEventListener('click', openHwidModal);
                    });
                }

                // Update requests table
                const requestsTbody = document.querySelector('#requests-table tbody');
                if (requestsTbody && data.requests) {
                    if (data.requests.length === 0) {
                        requestsTbody.innerHTML = `
                            <tr>
                                <td colspan="7">
                                    <div class="empty-state">
                                        <div class="icon">📭</div>
                                        <h3>No pending requests</h3>
                                        <p>All requests have been handled.</p>
                                    </div>
                                </td>
                            </tr>
                        `;
                    } else {
                        requestsTbody.innerHTML = data.requests.map(req => `
                            <tr>
                                <td>${req.id}</td>
                                <td><span class="text-truncate" title="${escapeHtml(req.device_id)}">${escapeHtml(req.device_id)}</span></td>
                                <td>${req.code || '—'}</td>
                                <td>${escapeHtml(req.reason || '—')}</td>
                                <td><span class="tag pending">${req.status}</span></td>
                                <td>${req.requested_at ? new Date(req.requested_at).toLocaleString() : '—'}</td>
                                <td style="display:flex;gap:4px;flex-wrap:wrap;">
                                    <button class="btn-sm success approve-request-btn" data-id="${req.id}">Approve</button>
                                    <button class="btn-sm danger reject-request-btn" data-id="${req.id}">Reject</button>
                                </td>
                            </tr>
                        `).join('');
                    }
                    // Re-bind request buttons
                    document.querySelectorAll('.approve-request-btn').forEach(btn => {
                        btn.addEventListener('click', approveRequest);
                    });
                    document.querySelectorAll('.reject-request-btn').forEach(btn => {
                        btn.addEventListener('click', rejectRequest);
                    });
                }

                // Update last update timestamp
                if (lastUpdateEl) {
                    lastUpdateEl.textContent = 'Last updated: ' + new Date().toLocaleString();
                }
            }

            // ============================================================
            // HELPER: Escape HTML
            // ============================================================
            function escapeHtml(str) {
                if (!str) return '';
                return String(str)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#039;');
            }

            // ============================================================
            // REFRESH DASHBOARD
            // ============================================================
            function refreshDashboard() {
                if (isRefreshing) return;
                isRefreshing = true;

                if (refreshSpinner) {
                    refreshSpinner.style.display = 'inline-block';
                }

                console.log('🔄 Auto-refreshing dashboard...');

                fetch('/api/dashboard-data', {
                        credentials: 'same-origin',
                        headers: {
                            'Accept': 'application/json'
                        }
                    })
                    .then(response => {
                        if (!response.ok) throw new Error('HTTP ' + response.status);
                        return response.json();
                    })
                    .then(data => {
                        console.log('✅ Dashboard data refreshed');
                        updateDashboard(data);
                        isRefreshing = false;
                        if (refreshSpinner) {
                            refreshSpinner.style.display = 'none';
                        }
                        if (isFirstLoad) {
                            isFirstLoad = false;
                        }
                    })
                    .catch(error => {
                        console.error('❌ Refresh error:', error);
                        isRefreshing = false;
                        if (refreshSpinner) {
                            refreshSpinner.style.display = 'none';
                        }
                    });
            }

            // ============================================================
            // AUTO-REFRESH CONTROLS
            // ============================================================
            function startAutoRefresh() {
                if (refreshTimer) {
                    clearInterval(refreshTimer);
                }
                refreshTimer = setInterval(refreshDashboard, REFRESH_INTERVAL);
                if (refreshIntervalDisplay) {
                    refreshIntervalDisplay.textContent = (REFRESH_INTERVAL / 1000);
                }
                console.log(`✅ Auto-refresh started (${REFRESH_INTERVAL/1000}s)`);
            }

            function stopAutoRefresh() {
                if (refreshTimer) {
                    clearInterval(refreshTimer);
                    refreshTimer = null;
                    console.log('⏹️ Auto-refresh stopped');
                }
            }

            // ============================================================
            // API ACTIONS
            // ============================================================

            // Revoke Device
            function revokeDevice(e) {
                const deviceId = e.target.dataset.device;
                if (!deviceId) return;
                if (!confirm(`Revoke device "${deviceId}"?`)) return;

                fetch('/api/device/' + deviceId, { method: 'DELETE' })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            alert('Device revoked successfully!');
                            refreshDashboard();
                        } else {
                            alert('Error: ' + (data.error || 'Unknown error'));
                        }
                    })
                    .catch(err => {
                        alert('Error: ' + err.message);
                    });
            }

            // Deactivate Code
            function deactivateCode(e) {
                const code = e.target.dataset.code;
                if (!code) return;
                if (!confirm(`Deactivate code "${code}"? This will remove all HWIDs and devices.`)) return;

                fetch('/api/code/' + code + '/deactivate', { method: 'POST' })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            alert(data.message || 'Code deactivated!');
                            refreshDashboard();
                        } else {
                            alert('Error: ' + (data.error || 'Unknown error'));
                        }
                    })
                    .catch(err => {
                        alert('Error: ' + err.message);
                    });
            }

            // Reactivate Code
            function reactivateCode(e) {
                const code = e.target.dataset.code;
                if (!code) return;
                const sub = prompt('Enter subscription type (Lifetime, 3 Months, 6 Months, 9 Months, 12 Months):', 'Lifetime');
                if (sub === null) return;

                fetch('/api/code/' + code + '/reactivate', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ subscriptionType: sub })
                    })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            alert(data.message || 'Code reactivated!');
                            refreshDashboard();
                        } else {
                            alert('Error: ' + (data.error || 'Unknown error'));
                        }
                    })
                    .catch(err => {
                        alert('Error: ' + err.message);
                    });
            }

            // Approve Request
            function approveRequest(e) {
                const id = e.target.dataset.id;
                if (!id) return;
                if (!confirm(`Approve request #${id}?`)) return;

                fetch('/api/request/' + id + '/approve', { method: 'POST' })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            alert('Request approved!');
                            refreshDashboard();
                        } else {
                            alert('Error: ' + (data.error || 'Unknown error'));
                        }
                    })
                    .catch(err => {
                        alert('Error: ' + err.message);
                    });
            }

            // Reject Request
            function rejectRequest(e) {
                const id = e.target.dataset.id;
                if (!id) return;
                if (!confirm(`Reject request #${id}?`)) return;

                fetch('/api/request/' + id + '/reject', { method: 'POST' })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            alert('Request rejected!');
                            refreshDashboard();
                        } else {
                            alert('Error: ' + (data.error || 'Unknown error'));
                        }
                    })
                    .catch(err => {
                        alert('Error: ' + err.message);
                    });
            }

            // ============================================================
            // GENERATE CODE MODAL
            // ============================================================
            const genModal = $('#generate-modal');
            const genForm = $('#generate-form');
            const genResult = $('#gen-result');

            $('#generate-code-btn').addEventListener('click', function() {
                genModal.style.display = 'flex';
                genResult.style.display = 'none';
                genResult.textContent = '';
                document.getElementById('gen-username').focus();
            });

            $('#modal-close').addEventListener('click', function() {
                genModal.style.display = 'none';
            });

            genModal.addEventListener('click', function(e) {
                if (e.target === genModal) genModal.style.display = 'none';
            });

            genForm.addEventListener('submit', function(e) {
                e.preventDefault();
                const username = document.getElementById('gen-username').value.trim();
                const access = document.getElementById('gen-access').value;
                const subscription = document.getElementById('gen-subscription').value;

                if (!username) {
                    genResult.textContent = '❌ Username is required.';
                    genResult.style.display = 'block';
                    genResult.style.color = '#f87171';
                    return;
                }

                genResult.textContent = '⏳ Generating...';
                genResult.style.display = 'block';
                genResult.style.color = '#8b95a9';

                fetch('/api/generate-code', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ username, accessLevel: access, subscriptionType: subscription })
                    })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            genResult.innerHTML = '✅ Code generated: <strong>' + data.code +
                                '</strong><br>Username: ' + data.username +
                                '<br>Access: ' + data.access +
                                '<br>Subscription: ' + data.subscription;
                            genResult.style.color = '#4ade80';
                            document.getElementById('gen-username').value = '';
                            refreshDashboard();
                        } else {
                            genResult.textContent = '❌ Error: ' + (data.error || 'Unknown error');
                            genResult.style.color = '#f87171';
                        }
                    })
                    .catch(err => {
                        genResult.textContent = '❌ Error: ' + err.message;
                        genResult.style.color = '#f87171';
                    });
            });

            // ============================================================
            // HWID MODAL
            // ============================================================
            const hwidModal = $('#hwid-modal');
            const hwidList = $('#hwid-list');
            const hwidCodeDisplay = $('#hwid-code-display');
            const hwidAddInput = $('#hwid-add-input');
            const hwidAddBtn = $('#hwid-add-btn');
            const hwidAddResult = $('#hwid-add-result');
            let currentHwidCode = null;

            function openHwidModal(e) {
                const code = e.target.dataset.code;
                if (!code) return;
                currentHwidCode = code;
                hwidCodeDisplay.textContent = code;
                hwidModal.style.display = 'flex';
                hwidList.innerHTML = '<p style="color:#8b95a9;text-align:center;padding:20px;">Loading HWIDs...</p>';
                hwidAddResult.style.display = 'none';
                hwidAddResult.textContent = '';
                hwidAddInput.value = '';

                fetch('/api/code/' + code + '/hwids')
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            if (data.hwids && data.hwids.length > 0) {
                                let html = `
                                    <div style="margin-bottom:12px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;">
                                        <span style="color:#8b95a9;">HWIDs: ${data.current_count} / ${data.max_hwid_limit}</span>
                                        <span style="color:#8b95a9;">Available: ${data.available_slots}</span>
                                    </div>
                                    <table style="width:100%;font-size:13px;">
                                        <thead>
                                            <tr>
                                                <th>HWID</th>
                                                <th>Assigned</th>
                                                <th>Last Used</th>
                                                <th>Hardware</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                `;
                                data.hwids.forEach(h => {
                                    const hwSpecs = h.hardware ? 
                                        `<div style="font-size:11px;color:#8b95a9;">
                                            ${h.hardware.cpu || '—'} | ${h.hardware.gpu || '—'}<br>
                                            ${h.hardware.ram_gb || 0}GB | ${h.hardware.device_name || '—'}
                                            ${h.hardware.wallpaper ? ' | 🖼️ ' + h.hardware.wallpaper : ''}
                                        </div>` :
                                        '<span style="color:#8b95a9;font-size:11px;">No hardware specs</span>';
                                    
                                    html += `
                                        <tr>
                                            <td><code style="font-size:11px;background:#0b0e14;padding:2px 6px;border-radius:4px;">${h.hwid_masked || h.hwid}</code></td>
                                            <td>${h.assigned_at ? new Date(h.assigned_at).toLocaleString() : '—'}</td>
                                            <td>${h.last_used ? new Date(h.last_used).toLocaleString() : 'Never'}</td>
                                            <td>${hwSpecs}</td>
                                            <td>
                                                <button class="btn-sm danger remove-hwid-btn" data-code="${currentHwidCode}" data-hwid="${h.hwid}">Remove</button>
                                            </td>
                                        </tr>
                                    `;
                                });
                                html += `</tbody></table>`;
                                hwidList.innerHTML = html;

                                // Re-bind remove buttons
                                document.querySelectorAll('.remove-hwid-btn').forEach(btn => {
                                    btn.addEventListener('click', removeHwid);
                                });
                            } else {
                                hwidList.innerHTML = `
                                    <div class="empty-state">
                                        <div class="icon">🔑</div>
                                        <h3>No HWIDs assigned</h3>
                                        <p>This code has no HWIDs yet.</p>
                                    </div>
                                `;
                            }
                        } else {
                            hwidList.innerHTML = `<p style="color:#f87171;text-align:center;padding:20px;">❌ ${data.error || 'Failed to load HWIDs'}</p>`;
                        }
                    })
                    .catch(err => {
                        hwidList.innerHTML = `<p style="color:#f87171;text-align:center;padding:20px;">❌ Error: ${err.message}</p>`;
                    });
            }

            function removeHwid(e) {
                const code = e.target.dataset.code;
                const hwid = e.target.dataset.hwid;
                if (!code || !hwid) return;
                if (!confirm(`Remove HWID "${hwid.substring(0, 16)}..." from code "${code}"? This will also delete any associated devices.`)) return;

                fetch('/api/code/' + code + '/hwid/' + hwid, { method: 'DELETE' })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            alert(data.message || 'HWID removed!');
                            // Re-open modal to refresh list
                            openHwidModal({ target: { dataset: { code: code } } });
                            refreshDashboard();
                        } else {
                            alert('Error: ' + (data.error || 'Unknown error'));
                        }
                    })
                    .catch(err => {
                        alert('Error: ' + err.message);
                    });
            }

            $('#hwid-modal-close').addEventListener('click', function() {
                hwidModal.style.display = 'none';
            });

            hwidModal.addEventListener('click', function(e) {
                if (e.target === hwidModal) hwidModal.style.display = 'none';
            });

            hwidAddBtn.addEventListener('click', function() {
                const hwid = hwidAddInput.value.trim();
                if (!hwid) {
                    hwidAddResult.textContent = '❌ Please enter a HWID.';
                    hwidAddResult.style.display = 'block';
                    hwidAddResult.style.color = '#f87171';
                    return;
                }
                if (hwid.length !== 64) {
                    hwidAddResult.textContent = '❌ HWID must be exactly 64 characters.';
                    hwidAddResult.style.display = 'block';
                    hwidAddResult.style.color = '#f87171';
                    return;
                }

                hwidAddResult.textContent = '⏳ Adding...';
                hwidAddResult.style.display = 'block';
                hwidAddResult.style.color = '#8b95a9';

                fetch('/api/code/' + currentHwidCode + '/hwid', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ hwid: hwid })
                    })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            hwidAddResult.textContent = '✅ HWID added successfully!';
                            hwidAddResult.style.color = '#4ade80';
                            hwidAddInput.value = '';
                            // Refresh list
                            openHwidModal({ target: { dataset: { code: currentHwidCode } } });
                            refreshDashboard();
                        } else {
                            hwidAddResult.textContent = '❌ Error: ' + (data.error || 'Unknown error');
                            hwidAddResult.style.color = '#f87171';
                        }
                    })
                    .catch(err => {
                        hwidAddResult.textContent = '❌ Error: ' + err.message;
                        hwidAddResult.style.color = '#f87171';
                    });
            });

            hwidAddInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') hwidAddBtn.click();
            });

            // ============================================================
            // BULK DELETE ACTIONS
            // ============================================================
            $('#delete-all-devices-btn').addEventListener('click', function() {
                if (!confirm('⚠️ Delete ALL devices? This cannot be undone!')) return;
                if (!confirm('Are you sure? This will remove all registered devices.')) return;

                fetch('/api/delete-all-devices', { method: 'POST' })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            alert(data.message);
                            refreshDashboard();
                        } else {
                            alert('Error: ' + (data.error || 'Unknown error'));
                        }
                    })
                    .catch(err => {
                        alert('Error: ' + err.message);
                    });
            });

            $('#delete-all-codes-btn').addEventListener('click', function() {
                if (!confirm('⚠️ Delete ALL codes and devices? This cannot be undone!')) return;
                if (!confirm('Are you sure? This will remove all codes and all devices.')) return;

                fetch('/api/delete-all-codes', { method: 'POST' })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            alert(data.message);
                            refreshDashboard();
                        } else {
                            alert('Error: ' + (data.error || 'Unknown error'));
                        }
                    })
                    .catch(err => {
                        alert('Error: ' + err.message);
                    });
            });

            $('#delete-all-requests-btn').addEventListener('click', function() {
                if (!confirm('Delete ALL pending requests?')) return;

                fetch('/api/delete-all-requests', { method: 'POST' })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            alert(data.message);
                            refreshDashboard();
                        } else {
                            alert('Error: ' + (data.error || 'Unknown error'));
                        }
                    })
                    .catch(err => {
                        alert('Error: ' + err.message);
                    });
            });

            // ============================================================
            // MANUAL REFRESH BUTTON
            // ============================================================
            if (manualRefreshBtn) {
                manualRefreshBtn.addEventListener('click', function() {
                    refreshDashboard();
                });
            }

            // ============================================================
            // VISIBILITY CHANGE - Stop/Start on tab switch
            // ============================================================
            document.addEventListener('visibilitychange', function() {
                if (document.hidden) {
                    stopAutoRefresh();
                } else {
                    startAutoRefresh();
                    refreshDashboard(); // Immediate refresh on visibility
                }
            });

            // ============================================================
            // INITIALIZE
            // ============================================================
            document.addEventListener('DOMContentLoaded', function() {
                startAutoRefresh();

                // Bind initial buttons
                document.querySelectorAll('.revoke-btn').forEach(btn => {
                    btn.addEventListener('click', revokeDevice);
                });
                document.querySelectorAll('.deactivate-code-btn').forEach(btn => {
                    btn.addEventListener('click', deactivateCode);
                });
                document.querySelectorAll('.reactivate-code-btn').forEach(btn => {
                    btn.addEventListener('click', reactivateCode);
                });
                document.querySelectorAll('.hwid-btn').forEach(btn => {
                    btn.addEventListener('click', openHwidModal);
                });
                document.querySelectorAll('.approve-request-btn').forEach(btn => {
                    btn.addEventListener('click', approveRequest);
                });
                document.querySelectorAll('.reject-request-btn').forEach(btn => {
                    btn.addEventListener('click', rejectRequest);
                });

                // Initial refresh after 1 second
                setTimeout(refreshDashboard, 1000);
            });

            // ============================================================
            // EXPOSE FOR DEBUGGING
            // ============================================================
            window.__dashboard = {
                refresh: refreshDashboard,
                startAutoRefresh: startAutoRefresh,
                stopAutoRefresh: stopAutoRefresh,
                update: updateDashboard
            };

            console.log('✅ Dashboard initialized');
            console.log('📊 Auto-refresh:', REFRESH_INTERVAL / 1000 + 's');
            console.log('🔧 Use window.__dashboard for manual control');

        })();
    </script>

</body>
</html>