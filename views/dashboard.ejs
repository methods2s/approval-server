        // ============================================
        // HWID MANAGEMENT FUNCTIONS
        // ============================================

        function populateHwidCodeDropdown() {
            const select = document.getElementById('hwid-code-select');
            const currentValue = select.value;
            select.innerHTML = '<option value="">-- Select a code --</option>';
            allCodes.forEach(c => {
                const option = document.createElement('option');
                option.value = c.code;
                const statusText = c.is_active ? '' : ' (Inactive)';
                option.textContent = `${c.code} - ${c.username || 'N/A'}${statusText}`;
                if (c.code === currentValue) option.selected = true;
                select.appendChild(option);
            });
        }

        async function loadHwidDetails() {
            const code = document.getElementById('hwid-code-select').value;
            if (!code) {
                document.getElementById('hwid-info').style.display = 'none';
                document.getElementById('hwid-list-section').style.display = 'none';
                document.getElementById('hwid-list-body').innerHTML = '<tr><td colspan="4" style="text-align:center;color:#888;padding:20px;">Select a code to view HWIDs</td></tr>';
                return;
            }
            
            hwidDetailsCache[code] = null;
            
            try {
                document.getElementById('hwid-info').style.display = 'block';
                document.getElementById('hwid-list-section').style.display = 'block';
                document.getElementById('hwid-list-body').innerHTML = '<tr><td colspan="4" style="text-align:center;color:#888;padding:20px;"><div class="loading-text"><span class="spinner"></span> Loading HWIDs...</div></td></tr>';
                
                const [limitResponse, hwidResponse] = await Promise.all([
                    fastFetch(`/api/code/${code}/hwid-limit`),
                    fastFetch(`/api/code/${code}/hwids`)
                ]);
                
                if (!limitResponse.ok || !hwidResponse.ok) {
                    throw new Error('Failed to fetch HWID data');
                }
                
                const limitData = await limitResponse.json();
                const hwidData = await hwidResponse.json();
                
                console.log('📊 HWID Data:', hwidData);
                
                hwidDetailsCache[code] = {
                    timestamp: Date.now(),
                    limitData: limitData,
                    hwidData: hwidData
                };
                
                updateHwidStats({ limitData, hwidData });
                renderHwidList(hwidData);
                
            } catch (error) {
                console.error('Load HWID details error:', error);
                document.getElementById('hwid-list-body').innerHTML = `<tr><td colspan="4" style="text-align:center;color:#f44336;padding:20px;">❌ Error loading HWIDs: ${error.message}</td></tr>`;
                showMessage('❌ Error loading HWID details: ' + error.message, 'error');
            }
        }

        function updateHwidStats(data) {
            const currentCount = data.hwidData.hwids ? data.hwidData.hwids.length : 0;
            const maxLimit = data.limitData.max_hwid_limit || 1;
            const availableSlots = maxLimit - currentCount;
            
            document.getElementById('hwid-current-count').textContent = currentCount;
            document.getElementById('hwid-max-limit').textContent = maxLimit;
            document.getElementById('hwid-available-slots').textContent = availableSlots < 0 ? 0 : availableSlots;
            document.getElementById('hwid-limit-input').value = maxLimit;
            
            const statusEl = document.getElementById('hwid-limit-status');
            if (availableSlots <= 0) {
                statusEl.style.display = 'block';
                statusEl.style.background = 'rgba(244,67,54,0.15)';
                statusEl.style.color = '#f44336';
                statusEl.style.border = '1px solid #f44336';
                statusEl.innerHTML = `⚠️ HWID LIMIT REACHED! (${currentCount}/${maxLimit}) - New devices will AUTO-DEACTIVATE this code!`;
            } else if (availableSlots <= 2) {
                statusEl.style.display = 'block';
                statusEl.style.background = 'rgba(255,152,0,0.15)';
                statusEl.style.color = '#FF9800';
                statusEl.style.border = '1px solid #FF9800';
                statusEl.innerHTML = `⚠️ Only ${availableSlots} slot(s) remaining (${currentCount}/${maxLimit})`;
            } else {
                statusEl.style.display = 'none';
            }
        }

        function renderHwidList(hwidData) {
            const tbody = document.getElementById('hwid-list-body');
            const hwids = (hwidData && hwidData.hwids && Array.isArray(hwidData.hwids)) ? hwidData.hwids : [];
            
            console.log('📊 Rendering HWIDs:', hwids.length);
            
            if (!hwids || hwids.length === 0) {
                tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;color:#888;padding:20px;">No HWIDs assigned to this code</td></tr>';
                return;
            }
            
            tbody.innerHTML = hwids.map((h, index) => {
                const hwidFull = h.hwid || h.hwid_full || '';
                const hwidMasked = h.hwid_masked || (hwidFull ? hwidFull.substring(0, 16) + '...' : 'N/A');
                const hardware = h.hardware || {};
                
                const cpu = hardware.cpu || 'N/A';
                const gpu = hardware.gpu || 'N/A';
                const ram = hardware.ram_gb ? hardware.ram_gb + ' GB' : 'N/A';
                const deviceName = hardware.device_name || 'N/A';
                const profile = hardware.profile_name || 'N/A';
                const registeredOwner = hardware.registered_owner || 'N/A';
                
                const hasSpecs = cpu !== 'N/A' || gpu !== 'N/A';
                
                return `
                    <tr>
                        <td style="text-align:center;font-weight:bold;color:#888;">${index + 1}</td>
                        <td>
                            <code style="font-size:11px;font-weight:bold;color:#4CAF50;word-break:break-all;" title="${hwidFull}">${hwidMasked}</code>
                        </td>
                        <td style="font-size:11px;line-height:1.8;">
                            ${hasSpecs ? `
                                <div><span class="hwid-spec-detail cpu">🔧 CPU: ${cpu}</span></div>
                                <div><span class="hwid-spec-detail gpu">🎮 GPU: ${gpu}</span></div>
                                <div><span class="hwid-spec-detail ram">💾 RAM: ${ram}</span></div>
                                <div><span class="hwid-spec-detail device">💻 Device: ${deviceName}</span></div>
                                <div><span class="hwid-spec-detail profile">👤 Profile: ${profile}</span></div>
                                <div><span class="hwid-spec-detail owner">👔 Owner: ${registeredOwner}</span></div>
                            ` : `
                                <div style="color:#888;font-style:italic;">No hardware specs available. Please register a device first.</div>
                            `}
                        </td>
                        <td style="text-align:center;">
                            <button onclick="removeHwid('${hwidFull}')" class="btn-remove-hwid" id="remove-btn-${index}">
                                🗑️ Remove
                            </button>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        async function removeHwid(hwid) {
            const code = document.getElementById('hwid-code-select').value;
            if (!code || !hwid) {
                showMessage('❌ Invalid code or HWID', 'error');
                return;
            }
            if (!confirm(`⚠️ Remove this HWID from code ${code}?`)) {
                return;
            }
            
            document.querySelectorAll('.btn-remove-hwid').forEach(btn => {
                btn.disabled = true;
                btn.textContent = '⏳';
            });
            
            try {
                const response = await fastFetch(`/api/code/${code}/hwid/${hwid}`, { method: 'DELETE' });
                const result = await response.json();
                if (result.success) {
                    showMessage(`✅ ${result.message}`, 'success');
                    hwidDetailsCache = {};
                    await loadHwidDetails();
                    await loadAll();
                } else {
                    showMessage('❌ ' + (result.error || 'Failed to remove HWID'), 'error');
                    document.querySelectorAll('.btn-remove-hwid').forEach(btn => {
                        btn.disabled = false;
                        btn.textContent = '🗑️ Remove';
                    });
                }
            } catch (error) {
                showMessage('❌ Error: ' + error.message, 'error');
                document.querySelectorAll('.btn-remove-hwid').forEach(btn => {
                    btn.disabled = false;
                    btn.textContent = '🗑️ Remove';
                });
            }
        }

        async function updateHwidLimit() {
            const code = document.getElementById('hwid-code-select').value;
            const limit = parseInt(document.getElementById('hwid-limit-input').value);
            
            if (!code) {
                showMessage('❌ Please select a code first', 'error');
                return;
            }
            if (!limit || limit < 1 || limit > 10) {
                showMessage('❌ Limit must be between 1 and 10', 'error');
                return;
            }
            
            try {
                const response = await fastFetch(`/api/code/${code}/hwid-limit`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ limit })
                });
                const result = await response.json();
                if (result.success) {
                    showMessage(`✅ ${result.message}`, 'success');
                    hwidDetailsCache = {};
                    loadHwidDetails();
                    await loadAll();
                } else {
                    showMessage('❌ ' + (result.error || 'Failed to update limit'), 'error');
                }
            } catch (error) {
                showMessage('❌ Error: ' + error.message, 'error');
            }
        }

        // ============================================
        // HWID LOGS
        // ============================================
        async function loadHwidLogs() {
            const tbody = document.getElementById('hwid-logs-body');
            if (!tbody) return;
            
            tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;color:#888;padding:20px;"><div class="loading-text"><span class="spinner"></span> Loading logs...</div></td></tr>';
            
            try {
                const response = await fastFetch('/api/hwid-logs?limit=200');
                if (!response.ok) {
                    throw new Error('Server returned ' + response.status);
                }
                const data = await response.json();
                
                if (data.success) {
                    const countEl = document.getElementById('new-hwid-count');
                    if (countEl) {
                        const newCount = data.new_count || 0;
                        countEl.textContent = newCount + ' new';
                        countEl.className = 'badge badge-new-count' + (newCount === 0 ? ' zero' : '');
                    }
                    
                    const logs = data.logs || [];
                    if (logs.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;color:#4CAF50;padding:30px;">✅ No unassigned HWIDs found - all HWIDs are assigned to codes!</td></tr>';
                    } else {
                        renderHwidLogs(logs);
                    }
                } else {
                    tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;color:#f44336;padding:20px;">' + (data.error || 'Failed to load logs') + '</td></tr>';
                }
            } catch (error) {
                console.error('Load HWID logs error:', error);
                tbody.innerHTML = `<tr><td colspan="5" style="text-align:center;color:#f44336;padding:20px;">Error: ${error.message}</td></tr>`;
            }
        }

        function renderHwidLogs(logs) {
            const tbody = document.getElementById('hwid-logs-body');
            if (!tbody) return;
            
            if (!logs || logs.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;color:#4CAF50;padding:30px;">✅ No unassigned HWID logs found</td></tr>';
                return;
            }
            
            tbody.innerHTML = logs.map((log, index) => {
                const time = new Date(log.created_at).toLocaleString();
                const isNew = log.status === 'new';
                const hwid = log.hwid || '';
                const hwidDisplay = hwid ? hwid.substring(0, 16) + '...' : 'N/A';
                
                let cpu = 'N/A', gpu = 'N/A', ram = 'N/A', device = 'N/A', profile = 'N/A', owner = 'N/A';
                
                if (log.details) {
                    const cpuMatch = log.details.match(/CPU:\s*([^,|]+)/i);
                    const gpuMatch = log.details.match(/GPU:\s*([^,|]+)/i);
                    const ramMatch = log.details.match(/RAM:\s*([^,|]+)\s*GB/i);
                    const deviceMatch = log.details.match(/Device:\s*([^,|]+)/i);
                    const profileMatch = log.details.match(/Profile:\s*([^,|]+)/i);
                    const ownerMatch = log.details.match(/Owner:\s*([^,|]+)/i);
                    
                    if (cpuMatch) cpu = cpuMatch[1].trim();
                    if (gpuMatch) gpu = gpuMatch[1].trim();
                    if (ramMatch) ram = ramMatch[1].trim() + ' GB';
                    if (deviceMatch) device = deviceMatch[1].trim();
                    if (profileMatch) profile = profileMatch[1].trim();
                    if (ownerMatch) owner = ownerMatch[1].trim();
                }
                
                if (log.browser_profile && profile === 'N/A') {
                    profile = log.browser_profile;
                }
                
                const hasSpecs = cpu !== 'N/A' || gpu !== 'N/A' || ram !== 'N/A';
                const hardwareHtml = hasSpecs ? `
                    <div style="font-size:10px;line-height:1.6;">
                        ${cpu !== 'N/A' ? `<span class="hwid-spec-item cpu">🔧 ${cpu}</span>` : ''}
                        ${gpu !== 'N/A' ? `<span class="hwid-spec-item gpu">🎮 ${gpu}</span>` : ''}
                        ${ram !== 'N/A' ? `<span class="hwid-spec-item ram">💾 ${ram}</span>` : ''}
                        ${device !== 'N/A' ? `<span class="hwid-spec-item device">💻 ${device}</span>` : ''}
                        ${profile !== 'N/A' ? `<span class="hwid-spec-item profile">👤 ${profile}</span>` : ''}
                        ${owner !== 'N/A' ? `<span class="hwid-spec-item owner">👔 ${owner}</span>` : ''}
                        <span class="hwid-spec-item unregistered">🔓 UNASSIGNED</span>
                    </div>
                ` : `
                    <div style="color:#888;font-size:11px;font-style:italic;">No hardware specs available</div>
                    <span class="hwid-spec-item unregistered">🔓 UNASSIGNED</span>
                `;
                
                return `
                    <tr style="${isNew ? 'background:rgba(244,67,54,0.08);' : ''}">
                        <td style="text-align:center;font-weight:bold;color:#888;">${index + 1}</td>
                        <td>
                            <span style="font-weight:bold;color:#FF9800;">
                                🖥️ ${hwidDisplay}
                            </span>
                            ${isNew ? ' 🔴' : ''}
                        </td>
                        <td><span class="text-muted" style="font-size:10px;">No code assigned</span></td>
                        <td>${hardwareHtml}</td>
                        <td><small>${time}</small></td>
                    </tr>
                `;
            }).join('');
        }

        // ============================================
        // NEW HWID FUNCTIONS
        // ============================================

        async function loadNewHwids() {
            const tbody = document.getElementById('new-hwid-body');
            if (!tbody) return;
            
            tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;color:#888;padding:20px;"><div class="loading-text"><span class="spinner"></span> Loading new HWIDs...</div></td></tr>';
            
            try {
                const response = await fastFetch('/api/hwid-new?limit=100');
                const data = await response.json();
                
                if (data.success) {
                    const countEl = document.getElementById('new-hwid-unique-count');
                    if (countEl) {
                        const count = data.total || 0;
                        countEl.textContent = count + ' new';
                        countEl.className = 'badge badge-new-count' + (count === 0 ? ' zero' : '');
                    }
                    
                    const hwids = data.hwids || [];
                    if (hwids.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;color:#4CAF50;padding:30px;">✅ No new unique HWIDs found - all HWIDs are assigned to codes!</td></tr>';
                    } else {
                        renderNewHwids(hwids);
                    }
                } else {
                    tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;color:#f44336;padding:20px;">' + (data.error || 'Failed to load new HWIDs') + '</td></tr>';
                }
            } catch (error) {
                console.error('Load new HWIDs error:', error);
                tbody.innerHTML = `<tr><td colspan="5" style="text-align:center;color:#f44336;padding:20px;">Error: ${error.message}</td></tr>`;
            }
        }

        function renderNewHwids(hwids) {
            const tbody = document.getElementById('new-hwid-body');
            if (!tbody) return;
            
            tbody.innerHTML = hwids.map((item, index) => {
                const hwid = item.hwid || '';
                const hwidDisplay = hwid ? hwid.substring(0, 16) + '...' + hwid.substring(48) : 'N/A';
                const time = item.created_at ? new Date(item.created_at).toLocaleString() : 'N/A';
                
                let cpu = 'N/A', gpu = 'N/A', ram = 'N/A', device = 'N/A', profile = 'N/A', owner = 'N/A';
                
                if (item.details) {
                    const cpuMatch = item.details.match(/CPU:\s*([^,|]+)/i);
                    const gpuMatch = item.details.match(/GPU:\s*([^,|]+)/i);
                    const ramMatch = item.details.match(/RAM:\s*([^,|]+)\s*GB/i);
                    const deviceMatch = item.details.match(/Device:\s*([^,|]+)/i);
                    const profileMatch = item.details.match(/Profile:\s*([^,|]+)/i);
                    const ownerMatch = item.details.match(/Owner:\s*([^,|]+)/i);
                    
                    if (cpuMatch) cpu = cpuMatch[1].trim();
                    if (gpuMatch) gpu = gpuMatch[1].trim();
                    if (ramMatch) ram = ramMatch[1].trim() + ' GB';
                    if (deviceMatch) device = deviceMatch[1].trim();
                    if (profileMatch) profile = profileMatch[1].trim();
                    if (ownerMatch) owner = ownerMatch[1].trim();
                }
                
                if (item.browser_profile && profile === 'N/A') {
                    profile = item.browser_profile;
                }
                
                const hasSpecs = cpu !== 'N/A' || gpu !== 'N/A' || ram !== 'N/A';
                
                const codeOptions = allCodes
                    .filter(c => c.is_active)
                    .map(c => `<option value="${c.code}">${c.code} - ${c.username || 'N/A'}</option>`)
                    .join('');
                
                return `
                    <tr>
                        <td style="text-align:center;font-weight:bold;color:#FF9800;">${index + 1}</td>
                        <td>
                            <code style="font-size:11px;font-weight:bold;color:#FF9800;word-break:break-all;" title="${hwid}">${hwidDisplay}</code>
                        </td>
                        <td style="font-size:11px;line-height:1.8;">
                            ${hasSpecs ? `
                                <div><span class="hwid-spec-detail cpu">🔧 CPU: ${cpu}</span></div>
                                <div><span class="hwid-spec-detail gpu">🎮 GPU: ${gpu}</span></div>
                                <div><span class="hwid-spec-detail ram">💾 RAM: ${ram}</span></div>
                                <div><span class="hwid-spec-detail device">💻 Device: ${device}</span></div>
                                <div><span class="hwid-spec-detail profile">👤 Profile: ${profile}</span></div>
                                <div><span class="hwid-spec-detail owner">👔 Owner: ${owner}</span></div>
                            ` : `
                                <div style="color:#888;font-style:italic;">No hardware specs available</div>
                            `}
                        </td>
                        <td><small>${time}</small></td>
                        <td>
                            <div class="action-buttons" style="flex-direction:column;gap:5px;align-items:stretch;">
                                <div style="display:flex;gap:4px;">
                                    <select class="edit-select" id="assign-code-${index}" style="flex:1;font-size:11px;padding:4px;">
                                        <option value="">-- Select Code --</option>
                                        ${codeOptions}
                                    </select>
                                    <button onclick="assignNewHwid('${hwid}', ${index})" class="btn-small btn-success">Assign</button>
                                </div>
                                <button onclick="markNewHwidSeen('${hwid}', ${index})" class="btn-small btn-warning" style="font-size:10px;">👁️ Mark as Seen</button>
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        async function assignNewHwid(hwid, index) {
            const select = document.getElementById(`assign-code-${index}`);
            const code = select.value;
            
            if (!code) {
                showMessage('❌ Please select a code first', 'error');
                return;
            }
            if (!confirm(`Assign HWID to code ${code}?`)) return;
            
            try {
                showMessage('⏳ Assigning...', 'loading');
                const response = await fastFetch('/api/hwid-new/assign', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ hwid, code })
                });
                const result = await response.json();
                if (result.success) {
                    showMessage(`✅ ${result.message}`, 'success');
                    await loadNewHwids();
                    await loadAll();
                } else {
                    showMessage('❌ ' + (result.error || 'Failed to assign'), 'error');
                }
            } catch (error) {
                showMessage('❌ Error: ' + error.message, 'error');
            }
        }

        async function markNewHwidSeen(hwid, index) {
            try {
                const response = await fastFetch('/api/hwid-new/mark-seen', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ hwid })
                });
                const result = await response.json();
                if (result.success) {
                    showMessage(`✅ HWID marked as seen`, 'success');
                    const row = document.querySelector(`#new-hwid-body tr:nth-child(${index + 1})`);
                    if (row) row.remove();
                    const countEl = document.getElementById('new-hwid-unique-count');
                    if (countEl) {
                        const current = parseInt(countEl.textContent) || 0;
                        countEl.textContent = Math.max(0, current - 1) + ' new';
                    }
                } else {
                    showMessage('❌ ' + (result.error || 'Failed to mark as seen'), 'error');
                }
            } catch (error) {
                showMessage('❌ Error: ' + error.message, 'error');
            }
        }

        // ============================================
        // CLEANUP OLD LOGS
        // ============================================
        async function cleanupOldLogs() {
            if (!confirm('🧹 Delete ALL HWID activity logs?\n\nThis will permanently delete ALL HWID logs from the database.\n\nAre you sure?')) {
                return;
            }
            try {
                showMessage('⏳ Deleting all logs...', 'loading');
                const response = await fastFetch('/api/cleanup-logs', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ delete_all: true })
                });
                const result = await response.json();
                if (result.success) {
                    showMessage(`✅ ${result.message} (${result.deleted} logs deleted)`, 'success');
                    await loadNewHwids();
                    await loadHwidLogs();
                    const countElements = document.querySelectorAll('.badge-new-count');
                    countElements.forEach(el => {
                        el.textContent = '0 new';
                        el.className = 'badge badge-new-count zero';
                    });
                } else {
                    showMessage('❌ ' + (result.error || 'Failed to delete logs'), 'error');
                }
            } catch (error) {
                showMessage('❌ Error: ' + error.message, 'error');
            }
        }

        // ============================================
        // INIT
        // ============================================
        document.addEventListener('DOMContentLoaded', function() {
            loadAll();
            
            // Auto-refresh every 20 seconds (less frequent to avoid 429)
            setInterval(function() {
                if (!isLoading) {
                    loadAll();
                }
            }, 20000);
            
            // Clear HWID cache every 2 minutes
            setInterval(function() {
                hwidDetailsCache = {};
            }, 120000);
        });
        
        document.addEventListener('visibilitychange', function() {
            if (!document.hidden && !isLoading) {
                loadAll();
            }
        });
    </script>
</body>
</html>