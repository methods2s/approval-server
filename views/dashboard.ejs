    </div>

    <!-- WALLPAPER MODAL -->
    <div class="wallpaper-modal" id="wallpaper-modal">
        <button class="close-modal" onclick="closeWallpaperModal()">&times;</button>
        <img id="wallpaper-modal-img" src="" alt="Wallpaper">
        <div class="wallpaper-info" id="wallpaper-modal-info"></div>
    </div>

    <!-- Result Message -->
    <div id="result-message">
        <button class="close-msg" onclick="hideMessage()">✕</button>
        <span id="result-text"></span>
    </div>

    <script>
        // ============================================
        // MESSAGE HELPERS
        // ============================================
        function showMessage(msg, type = 'success') {
            const el = document.getElementById('result-message');
            const text = document.getElementById('result-text');
            if (!el || !text) return;
            text.innerHTML = msg;
            el.className = type;
            el.style.display = 'block';
            clearTimeout(window.msgTimeout);
            window.msgTimeout = setTimeout(() => {
                hideMessage();
            }, 4000);
        }
        
        function hideMessage() {
            const el = document.getElementById('result-message');
            if (el) {
                el.style.display = 'none';
                el.className = '';
            }
        }

        // ============================================
        // WALLPAPER MODAL
        // ============================================
        function openWallpaperModal(base64Image, fileName, size, resolution) {
            const modal = document.getElementById('wallpaper-modal');
            const img = document.getElementById('wallpaper-modal-img');
            const info = document.getElementById('wallpaper-modal-info');
            
            if (!base64Image) {
                showMessage('❌ No wallpaper image available', 'error');
                return;
            }
            
            const imageSrc = base64Image.startsWith('data:image') ? base64Image : 'data:image/jpeg;base64,' + base64Image;
            img.src = imageSrc;
            
            const sizeNum = parseFloat(size) || 0;
            const resolutionText = (resolution && resolution !== '0x0') ? resolution : '';
            
            info.innerHTML = `
                <strong>${fileName}</strong> 
                ${sizeNum > 0 ? `📦 ${sizeNum.toFixed(1)} KB` : ''} 
                ${resolutionText ? `📐 ${resolutionText}` : ''}
            `;
            
            modal.classList.add('active');
            
            modal.onclick = function(e) {
                if (e.target === modal) {
                    closeWallpaperModal();
                }
            };
        }

        function closeWallpaperModal() {
            document.getElementById('wallpaper-modal').classList.remove('active');
            document.getElementById('wallpaper-modal-img').src = '';
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeWallpaperModal();
            }
        });

        // ============================================
        // WALLPAPER HTML HELPERS
        // ============================================
        function getWallpaperHtml(wallpaper, showPreview = true, small = false) {
            if (!wallpaper) {
                return '<span style="color:#666;font-size:10px;">No wallpaper</span>';
            }
            
            let html = '';
            const name = wallpaper.name || wallpaper.file_name || 'Unknown';
            const size = parseFloat(wallpaper.size_kb) || 0;
            const width = parseInt(wallpaper.width) || 0;
            const height = parseInt(wallpaper.height) || 0;
            const base64 = wallpaper.base64 || null;
            const resolution = (width > 0 && height > 0) ? `${width}x${height}` : '';
            
            const previewClass = small ? 'wallpaper-preview-sm' : 'wallpaper-preview';
            const placeholderClass = small ? 'wallpaper-placeholder-sm' : 'wallpaper-placeholder';
            
            if (showPreview && base64) {
                const imageSrc = base64.startsWith('data:image') ? base64 : 'data:image/jpeg;base64,' + base64;
                html += `<div class="wallpaper-cell">`;
                html += `<img class="${previewClass}" src="${imageSrc}" 
                           onclick="event.stopPropagation(); openWallpaperModal('${base64}', '${name}', ${size}, '${resolution}')" 
                           title="Click to enlarge" alt="${name}"
                           onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">`;
                html += `<div class="${placeholderClass}" style="display:none;">🖼️</div>`;
                html += `<div class="wallpaper-info-text">`;
                html += `<span class="name">${name}</span>`;
                if (size > 0) {
                    html += ` <span class="size">(${size.toFixed(1)} KB)</span>`;
                }
                if (resolution) {
                    html += `<br><span class="res">📐 ${resolution}</span>`;
                }
                html += `</div>`;
                html += `</div>`;
            } else if (showPreview && !base64) {
                html += `<div class="wallpaper-cell">`;
                html += `<div class="${placeholderClass}">🖼️</div>`;
                html += `<div class="wallpaper-info-text">`;
                html += `<span class="name">${name}</span>`;
                if (size > 0) {
                    html += ` <span class="size">(${size.toFixed(1)} KB)</span>`;
                }
                if (resolution) {
                    html += `<br><span class="res">📐 ${resolution}</span>`;
                }
                html += `</div>`;
                html += `</div>`;
            } else {
                html = `<span style="color:#666;font-size:10px;">${name}</span>`;
            }
            
            return html;
        }

        // ============================================
        // COPY FUNCTION
        // ============================================
        function copyCodeAndUser(code, username) {
            const textToCopy = `Code: ${code}\nUsername: ${username || 'N/A'}`;
            
            navigator.clipboard.writeText(textToCopy).then(() => {
                showMessage(`✅ Copied!\nCode: ${code}\nUsername: ${username || 'N/A'}`, 'success');
            }).catch(() => {
                const textArea = document.createElement('textarea');
                textArea.value = textToCopy;
                document.body.appendChild(textArea);
                textArea.select();
                document.execCommand('copy');
                document.body.removeChild(textArea);
                showMessage(`✅ Copied!\nCode: ${code}\nUsername: ${username || 'N/A'}`, 'success');
            });
        }

        // ============================================
        // STATE
        // ============================================
        let editingCode = null;
        let allCodes = [];
        let allDevices = [];
        let filteredDevices = [];
        let codeHwidsMap = {};
        let isLoading = false;
        let loadError = false;
        let filteredCodes = [];

        // ============================================
        // DEACTIVATION REASON MAPPING
        // ============================================
        const deactivationReasons = {
            'auto_deactivated': '⚠️ Auto-deactivated (General)',
            'auto_deactivated_multiple_hwids': '🚨 Multiple HWIDs detected',
            'auto_deactivated_limit_exceeded': '🚨 HWID limit exceeded',
            'auto_deactivated_unauthorized': '🚨 Unauthorized use detected',
            'inactive': 'Manually deactivated',
            'expired': '⏰ Subscription expired'
        };

        function getDeactivationReason(status) {
            return deactivationReasons[status] || status || 'Unknown reason';
        }

        // ============================================
        // TAB SWITCHING
        // ============================================
        function switchTab(tab) {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
            document.querySelector(`.tab-btn[onclick="switchTab('${tab}')"]`).classList.add('active');
            document.getElementById(`tab-${tab}`).classList.add('active');
            
            if (tab === 'profiles') {
                loadDevices();
            } else if (tab === 'hwid') {
                populateHwidCodeDropdown();
            } else if (tab === 'hwidlogs') {
                loadHwidLogs();
            } else {
                renderCurrentTab();
            }
        }

        function renderCurrentTab() {
            const activeTab = document.querySelector('.tab-content.active');
            if (!activeTab) return;
            
            const id = activeTab.id;
            if (id === 'tab-codes') renderAllCodes();
            else if (id === 'tab-svip') renderSVIP();
            else if (id === 'tab-vip') renderVIP();
        }

        // ============================================
        // REFRESH
        // ============================================
        async function refreshData() {
            showMessage('🔄 Refreshing...', 'loading');
            try {
                const response = await fetch('/api/force-refresh', { method: 'POST' });
                const result = await response.json();
                if (result.success) {
                    await loadAll();
                    showMessage('✅ Data refreshed!', 'success');
                } else {
                    showMessage('❌ Refresh failed', 'error');
                }
            } catch (error) {
                showMessage('❌ Error refreshing: ' + error.message, 'error');
            }
        }

        // ============================================
        // LOAD ALL DATA
        // ============================================
        async function loadAll() {
            if (isLoading) return;
            isLoading = true;
            loadError = false;
            
            try {
                const response = await fetch('/api/dashboard-data');
                
                if (!response.ok) {
                    throw new Error('Server returned ' + response.status);
                }
                
                const data = await response.json();
                
                const stats = data.stats || {};
                document.getElementById('stat-total').textContent = stats.total || 0;
                document.getElementById('stat-codes').textContent = stats.totalCodes || 0;
                
                const codes = data.codes || [];
                const svipCount = codes.filter(c => c.access_level === 'SVIP').length;
                const vipCount = codes.filter(c => c.access_level === 'VIP').length;
                document.getElementById('stat-svip').textContent = svipCount;
                document.getElementById('stat-vip').textContent = vipCount;
                
                allCodes = codes;
                filteredCodes = [...codes];
                allDevices = data.devices || [];
                
                await loadHwidStatusForCodes();
                
                populateHwidCodeDropdown();
                renderCurrentTab();
                
                document.getElementById('device-total-count').textContent = allDevices.length;
                updateTotalProfileCount();
                
                isLoading = false;
                
            } catch (error) {
                console.error('Load data error:', error);
                loadError = true;
                isLoading = false;
                
                document.getElementById('codes-body').innerHTML = `
                    <tr><td colspan="9" style="text-align:center;padding:30px;">
                        <div class="error-box">
                            <span class="error-icon">❌</span>
                            <strong>Error loading data</strong><br>
                            <span style="font-size:12px;color:#888;">${error.message}</span><br>
                            <button onclick="loadAll()" class="btn-refresh" style="margin-top:10px;">🔄 Retry</button>
                        </div>
                    </td></tr>
                `;
                
                showMessage('❌ Error loading data: ' + error.message, 'error');
            }
        }

        // ============================================
        // UPDATE TOTAL PROFILE COUNT
        // ============================================
        function updateTotalProfileCount() {
            const totalProfiles = allDevices.length;
            const countEl = document.getElementById('codes-count');
            if (countEl) {
                countEl.textContent = `${totalProfiles} profiles total`;
            }
        }

        // ============================================
        // FILTER CODES BY USERNAME
        // ============================================
        function filterCodesByUsername() {
            const search = document.getElementById('code-username-search').value.toLowerCase().trim();
            
            if (!search) {
                filteredCodes = [...allCodes];
            } else {
                filteredCodes = allCodes.filter(c => {
                    const username = (c.username || '').toLowerCase();
                    return username.includes(search);
                });
            }
            
            renderAllCodes();
        }

        // ============================================
        // LOAD HWID STATUS FOR CODES - BATCHED
        // ============================================
        async function loadHwidStatusForCodes() {
            codeHwidsMap = {};
            
            const promises = allCodes.map(async (code) => {
                try {
                    const response = await fetch(`/api/code/${code.code}/hwid-limit`);
                    const data = await response.json();
                    return { code: code.code, data: data };
                } catch (error) {
                    return { code: code.code, data: { current_hwid_count: 0, max_hwid_limit: 1 } };
                }
            });
            
            const results = await Promise.all(promises);
            results.forEach(result => {
                codeHwidsMap[result.code] = {
                    count: result.data.current_hwid_count || 0,
                    limit: result.data.max_hwid_limit || 1
                };
            });
        }

        // ============================================
        // LOAD PROFILES
        // ============================================
        async function loadDevices() {
            const tbody = document.getElementById('devices-body');
            tbody.innerHTML = `<tr><td colspan="4" style="text-align:center;color:#888;padding:30px;">
                <div class="loading-text"><span class="spinner"></span> Loading profiles...</div>
            </td></tr>`;
            
            try {
                const response = await fetch('/api/dashboard-data');
                const data = await response.json();
                allDevices = data.devices || [];
                document.getElementById('device-total-count').textContent = allDevices.length;
                updateTotalProfileCount();
                filterDevices();
            } catch (error) {
                console.error('Load profiles error:', error);
                tbody.innerHTML = `<tr><td colspan="4" style="text-align:center;padding:30px;">
                    <div class="error-box">
                        <span class="error-icon">❌</span>
                        Error loading profiles<br>
                        <span style="font-size:12px;color:#888;">${error.message}</span>
                    </div>
                </td></tr>`;
            }
        }

        function filterDevices() {
            const filterCode = document.getElementById('device-filter-code').value.toLowerCase().trim();
            filteredDevices = allDevices.filter(d => {
                const matchCode = !filterCode || (d.code && d.code.toLowerCase().includes(filterCode));
                return matchCode;
            });
            renderDevices();
        }

        // ============================================
        // RENDER PROFILES
        // ============================================
        function renderDevices() {
            const tbody = document.getElementById('devices-body');
            
            if (!filteredDevices || filteredDevices.length === 0) {
                tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;color:#888;padding:30px;">No profiles found</td></tr>';
                return;
            }
            
            tbody.innerHTML = filteredDevices.map(d => {
                const codeInfo = allCodes.find(c => c.code === d.code);
                const username = codeInfo?.username || d.browser_profile || 'Default';
                
                let wallpaperHtml = '<span style="color:#666;font-size:11px;">No wallpaper</span>';
                if (d.wallpaper_name || d.wallpaper_base64) {
                    const wallpaper = {
                        name: d.wallpaper_name || 'Unknown',
                        size_kb: d.wallpaper_size_kb || 0,
                        width: d.wallpaper_width || 0,
                        height: d.wallpaper_height || 0,
                        base64: d.wallpaper_base64 || null
                    };
                    wallpaperHtml = getWallpaperHtml(wallpaper, true);
                }
                
                return `
                    <tr>
                        <td><strong style="color:#2196F3;">${username}</strong></td>
                        <td><strong>${d.code || '<span class="text-muted">N/A</span>'}</strong></td>
                        <td>${wallpaperHtml}</td>
                        <td>
                            <button onclick="removeDevice('${d.device_id}')" class="btn-small btn-remove">🗑️ Remove</button>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        async function removeDevice(deviceId) {
            if (!confirm(`⚠️ Remove profile ${deviceId}?`)) return;
            
            try {
                const response = await fetch(`/api/device/${deviceId}`, { method: 'DELETE' });
                const result = await response.json();
                if (result.success) {
                    showMessage('✅ Profile removed!', 'success');
                    await loadAll();
                    await loadDevices();
                } else {
                    showMessage('❌ ' + (result.error || 'Failed to remove'), 'error');
                }
            } catch (error) {
                showMessage('❌ Error: ' + error.message, 'error');
            }
        }

        // ============================================
        // RENDER ALL CODES - WITH FILTER
        // ============================================
        function renderAllCodes() {
            const tbody = document.getElementById('codes-body');
            
            if (loadError) {
                return;
            }
            
            if (!filteredCodes || filteredCodes.length === 0) {
                const search = document.getElementById('code-username-search').value.trim();
                const msg = search ? `No codes found for username: "${search}"` : 'No codes found. Generate one above!';
                tbody.innerHTML = `<tr><td colspan="9" style="text-align:center;color:#888;padding:30px;">${msg}</td></tr>`;
                return;
            }
            
            updateTotalProfileCount();
            
            tbody.innerHTML = filteredCodes.map(c => {
                const isEditing = editingCode === c.code;
                const accessClass = c.access_level === 'SVIP' ? 'svip' : 'vip';
                const accessLabel = c.access_level === 'SVIP' ? '⭐ SVIP' : '🔶 VIP';
                const deactivationReason = !c.is_active ? getDeactivationReason(c.status) : '';
                const username = c.username || '';
                
                const hwidInfo = codeHwidsMap[c.code] || { count: 0, limit: 1 };
                const hasHwid = hwidInfo.count > 0;
                const isFull = hwidInfo.count >= hwidInfo.limit;
