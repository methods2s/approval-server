<!-- views/dashboard.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Device Management Dashboard</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: Arial, sans-serif; background: #1a1a2e; color: #e0e0e0; padding: 20px; }
        
        .container { max-width: 1400px; margin: 0 auto; }
        .header { display: flex; justify-content: space-between; align-items: center; padding: 20px 0; border-bottom: 1px solid #333; margin-bottom: 30px; }
        .header h1 { color: #4CAF50; }
        .header .user-info { color: #aaa; }
        .header .logout-btn { background: #f44336; color: white; padding: 8px 20px; border: none; border-radius: 4px; cursor: pointer; text-decoration: none; }
        .header .logout-btn:hover { background: #d32f2f; }

        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 15px; margin-bottom: 30px; }
        .stat-card { background: #16213e; padding: 20px; border-radius: 12px; text-align: center; border: 1px solid #2a3a5e; }
        .stat-card .number { font-size: 32px; font-weight: bold; color: #4CAF50; }
        .stat-card .label { color: #888; font-size: 14px; margin-top: 5px; }

        .card { background: #16213e; border-radius: 12px; border: 1px solid #2a3a5e; margin-bottom: 30px; overflow: hidden; }
        .card-header { padding: 20px 24px; border-bottom: 1px solid #2a3a5e; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; }
        .card-header h3 { color: #e0e0e0; }
        .card-body { padding: 20px 24px; overflow-x: auto; }

        .table { width: 100%; border-collapse: collapse; font-size: 14px; }
        .table th { text-align: left; padding: 12px 10px; color: #888; font-weight: 600; border-bottom: 2px solid #2a3a5e; }
        .table td { padding: 10px; border-bottom: 1px solid #1a2a3e; }
        .table tr:hover { background: #1a2a4e; }

        .badge { display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: 12px; font-weight: 600; }
        .badge-success { background: #1b5e20; color: #a5d6a7; }
        .badge-danger { background: #b71c1c; color: #ef9a9a; }
        .badge-warning { background: #e65100; color: #ffcc80; }
        .badge-info { background: #0d47a1; color: #90caf9; }
        .badge-gold { background: #b8860b; color: #ffd700; }
        .badge-blue { background: #1a237e; color: #64b5f6; }

        .btn { padding: 6px 14px; border: none; border-radius: 4px; cursor: pointer; font-size: 12px; transition: background 0.3s; }
        .btn-primary { background: #1976d2; color: white; }
        .btn-primary:hover { background: #1565c0; }
        .btn-success { background: #2e7d32; color: white; }
        .btn-success:hover { background: #1b5e20; }
        .btn-danger { background: #c62828; color: white; }
        .btn-danger:hover { background: #b71c1c; }
        .btn-warning { background: #e65100; color: white; }
        .btn-warning:hover { background: #bf360c; }
        .btn-info { background: #0d47a1; color: white; }
        .btn-info:hover { background: #0a3a8a; }
        .btn-secondary { background: #455a64; color: white; }
        .btn-secondary:hover { background: #37474f; }
        .btn-sm { padding: 4px 10px; font-size: 11px; }

        .btn-group { display: flex; gap: 4px; flex-wrap: wrap; }

        .modal { position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); display: none; align-items: center; justify-content: center; }
        .modal-content { background: #1a1a2e; border-radius: 12px; padding: 30px; max-width: 500px; width: 90%; max-height: 80vh; overflow-y: auto; border: 1px solid #333; }
        .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
        .modal-header h3 { color: #e0e0e0; }
        .close-btn { background: none; border: none; font-size: 28px; cursor: pointer; color: #888; }
        .close-btn:hover { color: #fff; }
        .modal-body { margin-bottom: 20px; }
        .modal-footer { display: flex; justify-content: flex-end; gap: 10px; padding-top: 20px; border-top: 1px solid #2a3a5e; }

        .form-group { margin-bottom: 15px; }
        .form-group label { display: block; margin-bottom: 5px; color: #aaa; font-weight: 600; }
        .form-group input, .form-group select { width: 100%; padding: 10px; border: 1px solid #2a3a5e; border-radius: 4px; background: #0d1a2e; color: #e0e0e0; font-size: 14px; }
        .form-group input:focus, .form-group select:focus { outline: none; border-color: #4CAF50; }

        .hwid-list { list-style: none; padding: 0; max-height: 150px; overflow-y: auto; background: #0d1a2e; border-radius: 4px; padding: 10px; border: 1px solid #2a3a5e; }
        .hwid-list li { padding: 6px 0; font-family: monospace; font-size: 13px; color: #90caf9; border-bottom: 1px solid #1a2a3e; }
        .hwid-list li:last-child { border-bottom: none; }
        .hwid-list .empty { color: #666; font-style: italic; }

        .hwid-limit-display { font-weight: bold; color: #4CAF50; margin-right: 8px; }

        .status-msg { padding: 10px 20px; border-radius: 4px; margin-bottom: 20px; }
        .status-msg.success { background: #1b5e20; color: #a5d6a7; }
        .status-msg.error { background: #b71c1c; color: #ef9a9a; }

        .refresh-btn { background: #455a64; color: white; padding: 8px 16px; border: none; border-radius: 4px; cursor: pointer; }
        .refresh-btn:hover { background: #37474f; }

        .mobile-msg { display: none; }
        @media (max-width: 768px) {
            .mobile-msg { display: block; padding: 20px; background: #16213e; border-radius: 12px; text-align: center; }
            .mobile-msg h2 { color: #f44336; margin-bottom: 10px; }
            .desktop-only { display: none; }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>📊 Device Management</h1>
            <div class="user-info">
                👤 <%= username %> 
                <a href="/logout" class="logout-btn">Logout</a>
            </div>
        </div>

        <% if (locals.error) { %>
            <div class="status-msg error"><%= error %></div>
        <% } %>

        <!-- Stats -->
        <div class="stats-grid">
            <div class="stat-card"><div class="number"><%= stats.total || 0 %></div><div class="label">Total Devices</div></div>
            <div class="stat-card"><div class="number" style="color:#4CAF50"><%= stats.approved || 0 %></div><div class="label">Approved</div></div>
            <div class="stat-card"><div class="number" style="color:#f44336"><%= stats.revoked || 0 %></div><div class="label">Revoked</div></div>
            <div class="stat-card"><div class="number" style="color:#ffa500"><%= stats.totalCodes || 0 %></div><div class="label">Total Codes</div></div>
            <div class="stat-card"><div class="number" style="color:#4CAF50"><%= stats.activeCodes || 0 %></div><div class="label">Active Codes</div></div>
            <div class="stat-card"><div class="number" style="color:#ff9800"><%= stats.totalPings || 0 %></div><div class="label">Total Pings</div></div>
        </div>

        <!-- Codes Table -->
        <div class="card">
            <div class="card-header">
                <h3>📋 Activation Codes</h3>
                <div>
                    <button onclick="refreshData()" class="refresh-btn">🔄 Refresh</button>
                    <button onclick="showGenerateCodeModal()" class="btn btn-primary">➕ Generate Code</button>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table" id="codes-table">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Username</th>
                                <th>Access</th>
                                <th>Subscription</th>
                                <th>Expires</th>
                                <th>Devices</th>
                                <th>HWID Limit</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="codes-tbody">
                            <% if (codes && codes.length > 0) { %>
                                <% codes.forEach(code => { %>
                                <tr>
                                    <td><strong><%= code.code %></strong></td>
                                    <td><%= code.username || 'N/A' %></td>
                                    <td>
                                        <span class="badge <%= code.access_level === 'SVIP' ? 'badge-gold' : 'badge-blue' %>">
                                            <%= code.access_level || 'VIP' %>
                                        </span>
                                    </td>
                                    <td><%= code.subscription_type || 'Lifetime' %></td>
                                    <td><%= code.expires_at ? new Date(code.expires_at).toLocaleDateString() : '∞' %></td>
                                    <td><%= code.used_count || 0 %></td>
                                    <td>
                                        <span class="hwid-limit-display" data-code="<%= code.code %>">
                                            <%= code.hwid_limit || 1 %>
                                        </span>
                                        <button onclick="editHwidLimit('<%= code.code %>', <%= code.hwid_limit || 1 %>)" 
                                                class="btn btn-sm btn-warning" title="Edit HWID Limit">
                                            ✏️
                                        </button>
                                    </td>
                                    <td>
                                        <% if (code.is_active) { %>
                                            <span class="badge badge-success">Active</span>
                                        <% } else { %>
                                            <span class="badge badge-danger">Inactive</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <div class="btn-group">
                                            <button onclick="viewCodeDetails('<%= code.code %>')" class="btn btn-sm btn-info">👁️</button>
                                            <% if (code.is_active) { %>
                                                <button onclick="deactivateCode('<%= code.code %>')" class="btn btn-sm btn-warning">⏸️</button>
                                            <% } else { %>
                                                <button onclick="reactivateCode('<%= code.code %>')" class="btn btn-sm btn-success">▶️</button>
                                            <% } %>
                                            <button onclick="deleteCode('<%= code.code %>')" class="btn btn-sm btn-danger">🗑️</button>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                            <% } else { %>
                                <tr><td colspan="9" style="text-align:center;color:#666;padding:30px;">No codes found</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Devices Table -->
        <div class="card">
            <div class="card-header">
                <h3>🖥️ Registered Devices</h3>
                <button onclick="deleteAllDevices()" class="btn btn-danger">🗑️ Delete All</button>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Device ID</th>
                                <th>Code</th>
                                <th>IP</th>
                                <th>Status</th>
                                <th>Pings</th>
                                <th>Approved</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (devices && devices.length > 0) { %>
                                <% devices.forEach(device => { %>
                                <tr>
                                    <td><span style="font-size:12px;font-family:monospace;"><%= device.device_id %></span></td>
                                    <td><%= device.code || 'N/A' %></td>
                                    <td><%= device.ip_address || 'N/A' %></td>
                                    <td>
                                        <span class="badge <%= device.status === 'approved' ? 'badge-success' : device.status === 'pending' ? 'badge-warning' : 'badge-danger' %>">
                                            <%= device.status %>
                                        </span>
                                    </td>
                                    <td><%= device.ping_count || 0 %></td>
                                    <td><%= device.approved_at ? new Date(device.approved_at).toLocaleDateString() : 'N/A' %></td>
                                    <td>
                                        <button onclick="removeDevice('<%= device.device_id %>')" class="btn btn-sm btn-danger">Remove</button>
                                    </td>
                                </tr>
                                <% }) %>
                            <% } else { %>
                                <tr><td colspan="7" style="text-align:center;color:#666;padding:30px;">No devices registered</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Generate Code Modal -->
    <div id="generateCodeModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3>➕ Generate New Code</h3>
                <button onclick="closeModal('generateCodeModal')" class="close-btn">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Username *</label>
                    <input type="text" id="gen-username" placeholder="Enter username">
                </div>
                <div class="form-group">
                    <label>Access Level</label>
                    <select id="gen-access">
                        <option value="VIP">VIP</option>
                        <option value="SVIP">SVIP</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Subscription Type</label>
                    <select id="gen-subscription">
                        <option value="Lifetime">Lifetime</option>
                        <option value="3 Months">3 Months</option>
                        <option value="6 Months">6 Months</option>
                        <option value="9 Months">9 Months</option>
                        <option value="12 Months">12 Months</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button onclick="closeModal('generateCodeModal')" class="btn btn-secondary">Cancel</button>
                <button onclick="generateCode()" class="btn btn-primary">Generate</button>
            </div>
        </div>
    </div>

    <!-- HWID Limit Modal -->
    <div id="hwidLimitModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3>✏️ Edit HWID Limit</h3>
                <button onclick="closeModal('hwidLimitModal')" class="close-btn">&times;</button>
            </div>
            <div class="modal-body">
                <p style="color:#aaa;margin-bottom:15px;">Set the maximum number of devices (HWIDs) that can use this code.</p>
                <div class="form-group">
                    <label>Maximum Devices:</label>
                    <input type="number" id="hwid-limit-input" min="1" max="100" value="1">
                </div>
                <div class="form-group">
                    <label>Current HWIDs using this code:</label>
                    <ul id="hwid-list" class="hwid-list">
                        <li class="empty">Loading...</li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button onclick="closeModal('hwidLimitModal')" class="btn btn-secondary">Cancel</button>
                <button onclick="saveHwidLimit()" class="btn btn-primary">💾 Save</button>
            </div>
        </div>
    </div>

    <!-- View Code Details Modal -->
    <div id="viewCodeModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3>👁️ Code Details</h3>
                <button onclick="closeModal('viewCodeModal')" class="close-btn">&times;</button>
            </div>
            <div class="modal-body" id="view-code-body">
                Loading...
            </div>
        </div>
    </div>

    <script>
        let currentHwidCode = null;
        let currentHwidLimit = 1;

        // ============================================
        // MODAL FUNCTIONS
        // ============================================

        function closeModal(id) {
            document.getElementById(id).style.display = 'none';
        }

        function openModal(id) {
            document.getElementById(id).style.display = 'flex';
        }

        // Close modal when clicking outside
        document.addEventListener('click', function(event) {
            document.querySelectorAll('.modal').forEach(modal => {
                if (event.target === modal) {
                    modal.style.display = 'none';
                }
            });
        });

        // ============================================
        // GENERATE CODE
        // ============================================

        function showGenerateCodeModal() {
            document.getElementById('gen-username').value = '';
            openModal('generateCodeModal');
        }

        async function generateCode() {
            const username = document.getElementById('gen-username').value.trim();
            const accessLevel = document.getElementById('gen-access').value;
            const subscriptionType = document.getElementById('gen-subscription').value;

            if (!username) {
                alert('❌ Username is required!');
                return;
            }

            try {
                const response = await fetch('/api/generate-code', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ username, accessLevel, subscriptionType })
                });

                const result = await response.json();

                if (result.success) {
                    alert(`✅ Code generated: ${result.code}\nUsername: ${result.username}\nAccess: ${result.access}\nSubscription: ${result.subscription}`);
                    closeModal('generateCodeModal');
                    location.reload();
                } else {
                    alert('❌ Error: ' + result.error);
                }
            } catch (error) {
                console.error('Generate code error:', error);
                alert('❌ Failed to generate code');
            }
        }

        // ============================================
        // HWID LIMIT
        // ============================================

        function editHwidLimit(code, currentLimit) {
            currentHwidCode = code;
            currentHwidLimit = currentLimit;
            
            document.getElementById('hwid-limit-input').value = currentLimit;
            openModal('hwidLimitModal');
            
            // Load current HWIDs
            loadHwidList(code);
        }

        async function loadHwidList(code) {
            const list = document.getElementById('hwid-list');
            list.innerHTML = '<li class="empty">Loading...</li>';
            
            try {
                const response = await fetch(`/api/code/${code}/hwids`, {
                    credentials: 'include'
                });
                const data = await response.json();
                
                if (data.success && data.hwids.length > 0) {
                    list.innerHTML = data.hwids.map(hwid => 
                        `<li>🖥️ ${hwid}</li>`
                    ).join('');
                } else {
                    list.innerHTML = '<li class="empty">No devices registered yet</li>';
                }
            } catch (error) {
                console.error('Failed to load HWIDs:', error);
                list.innerHTML = '<li class="empty">Failed to load HWIDs</li>';
            }
        }

        async function saveHwidLimit() {
            const newLimit = parseInt(document.getElementById('hwid-limit-input').value);
            
            if (isNaN(newLimit) || newLimit < 1 || newLimit > 100) {
                alert('Please enter a number between 1 and 100');
                return;
            }
            
            try {
                const response = await fetch(`/api/code/${currentHwidCode}/hwid-limit`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ hwidLimit: newLimit })
                });
                
                const result = await response.json();
                
                if (result.success) {
                    alert(`✅ HWID limit updated to ${newLimit}`);
                    closeModal('hwidLimitModal');
                    location.reload();
                } else {
                    alert('❌ Error: ' + result.error);
                }
            } catch (error) {
                console.error('Save HWID limit error:', error);
                alert('❌ Failed to update HWID limit');
            }
        }

        // ============================================
        // VIEW CODE DETAILS
        // ============================================

        async function viewCodeDetails(code) {
            const body = document.getElementById('view-code-body');
            body.innerHTML = 'Loading...';
            openModal('viewCodeModal');
            
            try {
                const response = await fetch(`/api/code/${code}/hwids`, {
                    credentials: 'include'
                });
                const data = await response.json();
                
                if (data.success) {
                    body.innerHTML = `
                        <div style="margin-bottom:15px;">
                            <strong>Code:</strong> <span style="color:#4CAF50;">${code}</span>
                        </div>
                        <div style="margin-bottom:15px;">
                            <strong>HWID Limit:</strong> ${data.hwid_limit}
                        </div>
                        <div style="margin-bottom:15px;">
                            <strong>Devices Used:</strong> ${data.hwid_count}
                        </div>
                        <div>
                            <strong>Registered HWIDs:</strong>
                            <ul class="hwid-list" style="margin-top:10px;">
                                ${data.hwids.length > 0 ? data.hwids.map(h => `<li>🖥️ ${h}</li>`).join('') : '<li class="empty">No devices registered</li>'}
                            </ul>
                        </div>
                    `;
                } else {
                    body.innerHTML = `<div class="status-msg error">${data.error || 'Failed to load details'}</div>`;
                }
            } catch (error) {
                console.error('View code error:', error);
                body.innerHTML = '<div class="status-msg error">Failed to load code details</div>';
            }
        }

        // ============================================
        // CODE ACTIONS
        // ============================================

        async function deactivateCode(code) {
            if (!confirm(`Deactivate code ${code}? This will revoke all devices using it.`)) return;
            
            try {
                const response = await fetch(`/api/code/${code}/deactivate`, {
                    method: 'POST',
                    credentials: 'include'
                });
                const result = await response.json();
                
                if (result.success) {
                    alert(`✅ ${result.message}`);
                    location.reload();
                } else {
                    alert('❌ Error: ' + result.error);
                }
            } catch (error) {
                console.error('Deactivate error:', error);
                alert('❌ Failed to deactivate code');
            }
        }

        async function reactivateCode(code) {
            const subType = prompt('Enter subscription type (Lifetime, 3 Months, 6 Months, 9 Months, 12 Months):', 'Lifetime');
            if (!subType) return;
            
            try {
                const response = await fetch(`/api/code/${code}/reactivate`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ subscriptionType: subType })
                });
                const result = await response.json();
                
                if (result.success) {
                    alert(`✅ ${result.message}`);
                    location.reload();
                } else {
                    alert('❌ Error: ' + result.error);
                }
            } catch (error) {
                console.error('Reactivate error:', error);
                alert('❌ Failed to reactivate code');
            }
        }

        async function deleteCode(code) {
            if (!confirm(`⚠️ Permanently delete code ${code}? This cannot be undone!`)) return;
            
            try {
                const response = await fetch(`/api/code/${code}`, {
                    method: 'DELETE',
                    credentials: 'include'
                });
                const result = await response.json();
                
                if (result.success) {
                    alert(`✅ ${result.message}`);
                    location.reload();
                } else {
                    alert('❌ Error: ' + result.error);
                }
            } catch (error) {
                console.error('Delete error:', error);
                alert('❌ Failed to delete code');
            }
        }

        // ============================================
        // DEVICE ACTIONS
        // ============================================

        async function removeDevice(deviceId) {
            if (!confirm(`Remove device ${deviceId}?`)) return;
            
            try {
                const response = await fetch(`/api/device/${deviceId}`, {
                    method: 'DELETE',
                    credentials: 'include'
                });
                const result = await response.json();
                
                if (result.success) {
                    alert('✅ Device removed');
                    location.reload();
                } else {
                    alert('❌ Error: ' + result.error);
                }
            } catch (error) {
                console.error('Remove device error:', error);
                alert('❌ Failed to remove device');
            }
        }

        async function deleteAllDevices() {
            if (!confirm('⚠️ Delete ALL devices? This cannot be undone!')) return;
            
            try {
                const response = await fetch('/api/delete-all-devices', {
                    method: 'POST',
                    credentials: 'include'
                });
                const result = await response.json();
                
                if (result.success) {
                    alert(`✅ ${result.message}`);
                    location.reload();
                } else {
                    alert('❌ Error: ' + result.error);
                }
            } catch (error) {
                console.error('Delete all error:', error);
                alert('❌ Failed to delete devices');
            }
        }

        // ============================================
        // REFRESH DATA
        // ============================================

        async function refreshData() {
            const btn = document.querySelector('.refresh-btn');
            btn.textContent = '⏳ Loading...';
            btn.disabled = true;
            
            try {
                const response = await fetch('/api/force-refresh', {
                    method: 'POST',
                    credentials: 'include'
                });
                const result = await response.json();
                
                if (result.success) {
                    location.reload();
                } else {
                    alert('❌ Failed to refresh data');
                    btn.textContent = '🔄 Refresh';
                    btn.disabled = false;
                }
            } catch (error) {
                console.error('Refresh error:', error);
                alert('❌ Failed to refresh data');
                btn.textContent = '🔄 Refresh';
                btn.disabled = false;
            }
        }
    </script>
</body>
</html>