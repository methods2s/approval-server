        // HWID MANAGEMENT FUNCTIONS
        // ============================================

        function populateHwidCodeDropdown() {
            const select = document.getElementById('hwid-code-select');
            const currentValue = select.value;
            
            select.innerHTML = '<option value="">-- Select a code --</option>';
            allCodes.forEach(c => {
                const option = document.createElement('option');
                option.value = c.code;
                const statusText = c.is_active ? '' : ' (Inactive)';
                option.textContent = `${c.code} - ${c.username || 'N/A'}${statusText}`;
                if (c.code === currentValue) option.selected = true;
                select.appendChild(option);
            });
            
            if (currentValue) {
                loadHwidDetails();
            }
        }

        async function loadHwidDetails() {
            const code = document.getElementById('hwid-code-select').value;
            if (!code) {
                document.getElementById('hwid-info').style.display = 'none';
                document.getElementById('hwid-list-section').style.display = 'none';
                return;
            }
            
            try {
                document.getElementById('hwid-info').style.display = 'block';
                document.getElementById('hwid-list-section').style.display = 'block';
                document.getElementById('hwid-list-body').innerHTML = '<tr><td colspan="5" style="text-align:center;color:#888;padding:20px;"><div class="loading-text"><span class="spinner"></span> Loading...</div></td></tr>';
                
                const [limitResponse, devicesResponse, hwidResponse] = await Promise.all([
                    fetch(`/api/code/${code}/hwid-limit`),
                    fetch('/api/dashboard-data'),
                    fetch(`/api/code/${code}/hwids`)
                ]);
                
                const limitData = await limitResponse.json();
                const devicesData = await devicesResponse.json();
                const hwidData = await hwidResponse.json();
                
                const allDevicesForCode = (devicesData.devices || []).filter(d => d.code === code);
                
                const currentCount = hwidData.hwids ? hwidData.hwids.length : 0;
                const maxLimit = limitData.max_hwid_limit || 1;
                const availableSlots = maxLimit - currentCount;
                
                document.getElementById('hwid-current-count').textContent = currentCount;
                document.getElementById('hwid-max-limit').textContent = maxLimit;
                document.getElementById('hwid-available-slots').textContent = availableSlots < 0 ? 0 : availableSlots;
                document.getElementById('hwid-total-profiles').textContent = allDevicesForCode.length || 0;
                document.getElementById('hwid-limit-input').value = maxLimit;
                
                const statusEl = document.getElementById('hwid-limit-status');
                if (availableSlots <= 0) {
                    statusEl.style.display = 'block';
                    statusEl.style.background = 'rgba(244,67,54,0.15)';
                    statusEl.style.color = '#f44336';
                    statusEl.style.border = '1px solid #f44336';
                    statusEl.innerHTML = `⚠️ HWID LIMIT REACHED! (${currentCount}/${maxLimit}) - New devices will AUTO-DEACTIVATE this code!`;
                } else if (availableSlots <= 2) {
                    statusEl.style.display = 'block';
                    statusEl.style.background = 'rgba(255,152,0,0.15)';
                    statusEl.style.color = '#FF9800';
                    statusEl.style.border = '1px solid #FF9800';
                    statusEl.innerHTML = `⚠️ Only ${availableSlots} slot(s) remaining (${currentCount}/${maxLimit})`;
                } else {
                    statusEl.style.display = 'none';
                }
                
                renderHwidList(hwidData, allDevicesForCode);
                
            } catch (error) {
                console.error('Load HWID details error:', error);
                document.getElementById('hwid-list-body').innerHTML = `<tr><td colspan="5" style="text-align:center;color:#f44336;padding:20px;">❌ Error loading HWIDs: ${error.message}</td></tr>`;
                showMessage('❌ Error loading HWID details', 'error');
            }
        }

        // ============================================
        // RENDER HWID LIST
        // ============================================
        function renderHwidList(hwidData, devices) {
            const tbody = document.getElementById('hwid-list-body');
            
            const hwids = (hwidData && hwidData.hwids && Array.isArray(hwidData.hwids)) ? hwidData.hwids : [];
            
            if (!hwids || hwids.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;color:#888;padding:20px;">No HWIDs assigned to this code</td></tr>';
                return;
            }
            
            tbody.innerHTML = hwids.map((h, index) => {
                const hwidDevices = devices ? devices.filter(d => d.hwid === h.hwid) : [];
                const approvedDevices = hwidDevices.filter(d => d.status === 'approved');
                const deviceCount = approvedDevices.length;
                
                const device = approvedDevices[0] || hwidDevices[0] || null;
                
                const cpu = device?.cpu_name || 'N/A';
                const gpu = device?.gpu_name || 'N/A';
                const ram = device?.ram_total_gb ? device.ram_total_gb + ' GB' : 'N/A';
                const storage = device?.storage_total_gb ? device.storage_total_gb + ' GB' : 'N/A';
                const deviceName = device?.device_name || 'N/A';
                const profile = device?.browser_profile || device?.profile_name || 'Default';
                const hwidFull = h.hwid || '';
                const hwidMasked = h.hwid_masked || (hwidFull ? hwidFull.substring(0, 16) + '...' : 'N/A');
                
                let wallpaperHtml = '';
                if (device?.wallpaper_name || device?.wallpaper_base64) {
                    const wallpaper = {
                        name: device.wallpaper_name || 'Unknown',
                        size_kb: device.wallpaper_size_kb || 0,
                        width: device.wallpaper_width || 0,
                        height: device.wallpaper_height || 0,
                        base64: device.wallpaper_base64 || null
                    };
                    wallpaperHtml = getWallpaperHtml(wallpaper, true);
                } else {
                    wallpaperHtml = '<span style="color:#666;font-size:10px;">No wallpaper</span>';
                }
                
                const hasSpecs = cpu !== 'N/A' && cpu !== 'Unknown';
                
                return `
                    <tr>
                        <td style="text-align:center;font-weight:bold;color:#888;">${index + 1}</td>
                        <td>
                            <code style="font-size:11px;font-weight:bold;color:#4CAF50;word-break:break-all;" title="${hwidFull}">${hwidMasked}</code>
                        </td>
                        <td>
                            <span class="device-count-badge">
                                ${deviceCount} ${deviceCount === 1 ? 'Profile' : 'Profiles'}
                                ${deviceCount > 0 ? ' 👤' : ''}
                            </span>
                        </td>
                        <td style="font-size:11px;line-height:1.8;">
                            ${hasSpecs ? `
                                <div><span class="hwid-spec-detail cpu">🔧 CPU: ${cpu}</span></div>
                                <div><span class="hwid-spec-detail gpu">🎮 GPU: ${gpu}</span></div>
                                <div><span class="hwid-spec-detail ram">💾 RAM: ${ram}</span></div>
                                <div><span class="hwid-spec-detail storage">💿 Storage: ${storage}</span></div>
                                <div><span class="hwid-spec-detail device">💻 Device: ${deviceName}</span></div>
                                <div><span class="hwid-spec-detail profile">👤 Profile: ${profile}</span></div>
                                <div style="margin-top:6px;border-top:1px solid rgba(255,255,255,0.05);padding-top:6px;">
                                    <span class="hwid-spec-detail wallpaper">🖼️ ${wallpaperHtml}</span>
                                </div>
                            ` : `
                                <div style="color:#888;font-style:italic;">No hardware specs available. Please register a device first.</div>
                            `}
                        </td>
                        <td style="text-align:center;">
                            <button onclick="removeHwid('${hwidFull}')" class="btn-remove-hwid" id="remove-btn-${index}">
                                🗑️ Remove
                            </button>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        async function removeHwid(hwid) {
            const code = document.getElementById('hwid-code-select').value;
            
            if (!code || !hwid) {
                showMessage('❌ Invalid code or HWID', 'error');
                return;
            }
            
            let profilesToDelete = 0;
            try {
                const devicesResponse = await fetch('/api/dashboard-data');
                const devicesData = await devicesResponse.json();
                profilesToDelete = (devicesData.devices || []).filter(d => d.hwid === hwid && d.code === code).length;
            } catch (error) {}
            
            let confirmMessage = `⚠️ Remove this computer (HWID: ${hwid.substring(0,16)}...)?`;
            if (profilesToDelete > 0) {
                confirmMessage += `\n\nThis will also delete ${profilesToDelete} profile(s).`;
            }
            confirmMessage += `\n\nContinue?`;
            
            if (!confirm(confirmMessage)) {
                return;
            }
            
            document.querySelectorAll('.btn-remove-hwid').forEach(btn => {
                btn.disabled = true;
                btn.textContent = '⏳';
            });
            
            try {
                const response = await fetch(`/api/code/${code}/hwid/${hwid}`, {
                    method: 'DELETE'
                });
                const result = await response.json();
                
                if (result.success) {
                    showMessage(`✅ ${result.message}`, 'success');
                    await loadHwidDetails();
                    await loadAll();
                    await loadDevices();
                } else {
                    showMessage('❌ ' + (result.error || 'Failed to remove HWID'), 'error');
                    document.querySelectorAll('.btn-remove-hwid').forEach(btn => {
                        btn.disabled = false;
                        btn.textContent = '🗑️ Remove';
                    });
                }
            } catch (error) {
                showMessage('❌ Error: ' + error.message, 'error');
                document.querySelectorAll('.btn-remove-hwid').forEach(btn => {
                    btn.disabled = false;
                    btn.textContent = '🗑️ Remove';
                });
            }
        }

        async function updateHwidLimit() {
            const code = document.getElementById('hwid-code-select').value;
            const limit = parseInt(document.getElementById('hwid-limit-input').value);
            
            if (!code) {
                showMessage('❌ Please select a code first', 'error');
                return;
            }
            
            if (!limit || limit < 1 || limit > 10) {
                showMessage('❌ Limit must be between 1 and 10', 'error');
                return;
            }
            
            try {
                const response = await fetch(`/api/code/${code}/hwid-limit`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ limit })
                });
                const result = await response.json();
                
                if (result.success) {
                    showMessage(`✅ ${result.message}`, 'success');
                    loadHwidDetails();
                    await loadAll();
                } else {
                    showMessage('❌ ' + (result.error || 'Failed to update limit'), 'error');
                }
            } catch (error) {
                showMessage('❌ Error: ' + error.message, 'error');
            }
        }

        // ============================================
        // HWID LOGS - WITH WALLPAPER IMAGE FOR UNREGISTERED
        // ============================================
        async function loadHwidLogs() {
            const tbody = document.getElementById('hwid-logs-body');
            if (!tbody) return;
            
            tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;color:#888;padding:20px;"><div class="loading-text"><span class="spinner"></span> Loading logs...</div></td></tr>';
            
            try {
                const response = await fetch('/api/hwid-logs?limit=200');
                
                if (!response.ok) {
                    throw new Error('Server returned ' + response.status);
                }
                
                const data = await response.json();
                
                if (data.success) {
                    const countEl = document.getElementById('new-hwid-count');
                    if (countEl) {
                        const newCount = data.new_count || 0;
                        countEl.textContent = newCount + ' new';
                        countEl.className = 'badge badge-new-count' + (newCount === 0 ? ' zero' : '');
                    }
                    
                    const logs = data.logs || [];
                    if (logs.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;color:#888;padding:20px;">No logs found</td></tr>';
                    } else {
                        renderHwidLogs(logs);
                    }
                } else {
                    tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;color:#f44336;padding:20px;">' + (data.error || 'Failed to load logs') + '</td></tr>';
                }
            } catch (error) {
                console.error('Load HWID logs error:', error);
                tbody.innerHTML = `<tr><td colspan="6" style="text-align:center;color:#f44336;padding:20px;">Error: ${error.message}</td></tr>`;
            }
        }

        // ============================================
        // RENDER HWID LOGS - WITH WALLPAPER IMAGE
        // ============================================
        function renderHwidLogs(logs) {
            const tbody = document.getElementById('hwid-logs-body');
            if (!tbody) return;
            
            if (!logs || logs.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;color:#888;padding:20px;">No logs found</td></tr>';
                return;
            }
            
            tbody.innerHTML = logs.map((log, index) => {
                const time = new Date(log.created_at).toLocaleString();
                const isNew = log.status === 'new';
                
                let username = 'N/A';
                let hasCode = false;
                if (log.code) {
                    hasCode = true;
                    const codeInfo = allCodes.find(c => c.code === log.code);
                    if (codeInfo && codeInfo.username) {
                        username = codeInfo.username;
                    } else {
                        username = log.code;
                    }
                }
                
                const displayName = hasCode ? username : (log.hwid ? log.hwid.substring(0, 16) + '...' : 'N/A');
                const isUsername = hasCode && username !== 'N/A' && username !== log.code;
                
                // Extract hardware specs and wallpaper
                let cpu = 'N/A', gpu = 'N/A', ram = 'N/A', storage = 'N/A', device = 'N/A', profile = 'N/A';
                let wallpaperName = 'N/A', wallpaperSize = 0, wallpaperWidth = 0, wallpaperHeight = 0, wallpaperBase64 = null;
                
                if (log.details) {
                    const cpuMatch = log.details.match(/CPU:\s*([^,|]+)/i);
                    const gpuMatch = log.details.match(/GPU:\s*([^,|]+)/i);
                    const ramMatch = log.details.match(/RAM:\s*([^,|]+)\s*GB/i);
                    const storageMatch = log.details.match(/Storage:\s*([^,|]+)\s*GB/i);
                    const deviceMatch = log.details.match(/Device:\s*([^,|]+)/i);
                    const profileMatch = log.details.match(/Profile:\s*([^,|]+)/i);
                    const wallpaperMatch = log.details.match(/Wallpaper:\s*([^,|]+)\s*\(([^)]*)\)/i);
                    const resolutionMatch = log.details.match(/Resolution:\s*([^,|]+)/i);
                    const base64Match = log.details.match(/Base64:\s*([^,|]+)/i);
                    
                    if (cpuMatch) cpu = cpuMatch[1].trim();
                    if (gpuMatch) gpu = gpuMatch[1].trim();
                    if (ramMatch) ram = ramMatch[1].trim() + ' GB';
                    if (storageMatch) storage = storageMatch[1].trim() + ' GB';
                    if (deviceMatch) device = deviceMatch[1].trim();
                    if (profileMatch) profile = profileMatch[1].trim();
                    if (wallpaperMatch) {
                        wallpaperName = wallpaperMatch[1].trim();
                        wallpaperSize = parseFloat(wallpaperMatch[2]) || 0;
                    }
                    if (resolutionMatch) {
                        const res = resolutionMatch[1].trim();
                        const parts = res.split('x');
                        if (parts.length === 2) {
                            wallpaperWidth = parseInt(parts[0]) || 0;
                            wallpaperHeight = parseInt(parts[1]) || 0;
                        }
                    }
                    if (base64Match) {
                        wallpaperBase64 = base64Match[1].trim();
                    }
                }
                
                if (log.browser_profile && profile === 'N/A') {
                    profile = log.browser_profile;
                }
                
                // ============================================
                // WALLPAPER DISPLAY - SHOW IMAGE FOR UNREGISTERED
                // ============================================
                let wallpaperHtml = '';
                const shouldShowWallpaper = !hasCode || log.code === null || log.code === 'null' || log.code === '';
                
                if (shouldShowWallpaper && wallpaperBase64) {
                    const wallpaper = {
                        name: wallpaperName,
                        size_kb: wallpaperSize,
                        width: wallpaperWidth,
                        height: wallpaperHeight,
                        base64: wallpaperBase64
                    };
                    wallpaperHtml = getWallpaperHtml(wallpaper, true, true); // small preview with image
                } else if (shouldShowWallpaper && wallpaperName !== 'N/A') {
                    // No base64 but has name - show text
                    wallpaperHtml = `<span style="color:#FF9800;">🖼️ ${wallpaperName}</span>`;
                    if (wallpaperSize > 0) {
                        wallpaperHtml += ` <span style="color:#888;font-size:9px;">(${wallpaperSize.toFixed(1)} KB)</span>`;
                    }
                } else if (!shouldShowWallpaper) {
                    // Registered - show simple text
                    wallpaperHtml = `<span style="color:#666;font-size:10px;">✅ Registered</span>`;
                } else {
                    wallpaperHtml = '<span style="color:#666;font-size:10px;">No wallpaper</span>';
                }
                
                const hasSpecs = cpu !== 'N/A' || gpu !== 'N/A' || ram !== 'N/A' || storage !== 'N/A' || device !== 'N/A';
                const hardwareHtml = hasSpecs ? `
                    <div style="font-size:10px;line-height:1.6;">
                        ${cpu !== 'N/A' ? `<span class="hwid-spec-item cpu">🔧 ${cpu}</span>` : ''}
                        ${gpu !== 'N/A' ? `<span class="hwid-spec-item gpu">🎮 ${gpu}</span>` : ''}
                        ${ram !== 'N/A' ? `<span class="hwid-spec-item ram">💾 ${ram}</span>` : ''}
                        ${storage !== 'N/A' ? `<span class="hwid-spec-item storage">💿 ${storage}</span>` : ''}
                        ${device !== 'N/A' ? `<span class="hwid-spec-item device">💻 ${device}</span>` : ''}
                        ${profile !== 'N/A' ? `<span class="hwid-spec-item profile">👤 ${profile}</span>` : ''}
                        ${!hasCode ? `<span class="hwid-spec-item unregistered">🔓 UNREGISTERED</span>` : ''}
                    </div>
                ` : `
                    <div style="color:#888;font-size:11px;font-style:italic;">No hardware specs available</div>
                `;
                
                const displayIndicator = isUsername ? '👤' : '🖥️';
                const statusBadge = !hasCode ? '<span class="badge-unregistered">🔓 UNREGISTERED</span>' : '<span class="badge-approved">✅ REGISTERED</span>';
                
                return `
                    <tr style="${isNew ? 'background:rgba(244,67,54,0.08);' : ''}">
                        <td style="text-align:center;font-weight:bold;color:#888;">${index + 1}</td>
                        <td>
                            <span style="font-weight:bold;color:${isUsername ? '#4CAF50' : '#FF9800'};">
                                ${displayIndicator} ${displayName}
                            </span>
                            ${isNew ? ' 🔴' : ''}
                            <br>
                            ${statusBadge}
                            ${!isUsername ? `<br><small style="color:#888;font-size:9px;">HWID: ${log.hwid ? log.hwid.substring(0, 16) + '...' : 'N/A'}</small>` : ''}
                        </td>
                        <td>
                            ${hasCode ? `<span class="code-badge">${log.code}</span>` : '<span class="text-muted" style="font-size:10px;">No code</span>'}
                        </td>
                        <td>${hardwareHtml}</td>
                        <td style="font-size:11px;line-height:1.4;">
                            ${wallpaperHtml}
                            ${!hasCode && wallpaperBase64 ? `<br><span style="color:#888;font-size:9px;">📸 Click image to enlarge</span>` : ''}
                            ${!hasCode && !wallpaperBase64 && wallpaperName !== 'N/A' ? `<br><span style="color:#888;font-size:9px;">📸 New HWID detected</span>` : ''}
                        </td>
                        <td><small>${time}</small></td>
                    </tr>
                `;
            }).join('');
        }

        function searchHwidLogs() {
            const search = document.getElementById('hwid-log-search').value.toLowerCase().trim();
            const rows = document.querySelectorAll('#hwid-logs-body tr');
            
            rows.forEach(row => {
                if (row.cells && row.cells.length > 0) {
                    const nameCell = row.cells[1];
                    const codeCell = row.cells[2];
                    if (nameCell) {
                        const text = nameCell.textContent.toLowerCase() || '';
                        const codeText = codeCell ? codeCell.textContent.toLowerCase() || '' : '';
                        row.style.display = (text.includes(search) || codeText.includes(search)) ? '' : 'none';
                    }
                }
            });
        }

        // ============================================
        // INIT
        // ============================================
        document.addEventListener('DOMContentLoaded', function() {
            loadAll();
            
            setInterval(function() {
                if (!isLoading) {
                    loadAll();
                }
            }, 30000);
        });
    </script>
</body>
</html>